<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="P2_L3_LDG_def"
                  targetNamespace="http://teck.com/bpmn">

  <bpmn:collaboration id="P2_L3_LDG_collab">
    <bpmn:participant id="P2_L3_LDG_PL" name="Loading" processRef="P2_L3_LDG_proc"/>
  </bpmn:collaboration>

  <bpmn:process id="P2_L3_LDG_proc" isExecutable="false">

    <bpmn:laneSet id="P2_L3_LDG_laneSet">
      <bpmn:lane id="P2_L3_LDG_LN_MCT" name="Mine Controller / FMS">
        <bpmn:flowNodeRef>P2_L3_LDG_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_LDG_XGW01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_LDG_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_LDG_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_LDG_XGW02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_LDG_EE01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L3_LDG_LN_SHV" name="Shovel Operator">
        <bpmn:flowNodeRef>P2_L3_LDG_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_LDG_T06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L3_LDG_LN_TRK" name="Truck Operator">
        <bpmn:flowNodeRef>P2_L3_LDG_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_LDG_T03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="P2_L3_LDG_SE" name="Truck dispatched to face; shovel and face ready">
      <bpmn:outgoing>P2_L3_LDG_F01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="P2_L3_LDG_T01" name="Queue Truck at Shovel (2.2.2.1) — TUM: OD or SBO">
      <bpmn:incoming>P2_L3_LDG_F01</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="P2_L3_LDG_XGW01" name="Queue duration exceeds OD threshold?" default="P2_L3_LDG_F03">
      <bpmn:incoming>P2_L3_LDG_F02</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F03</bpmn:outgoing>
      <bpmn:outgoing>P2_L3_LDG_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="P2_L3_LDG_T02" name="Classify Queue as SBO — mine controller decision">
      <bpmn:incoming>P2_L3_LDG_F04</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_LDG_T03" name="Spot Truck at Shovel (2.2.2.2) — TUM: NP">
      <bpmn:incoming>P2_L3_LDG_F03</bpmn:incoming>
      <bpmn:incoming>P2_L3_LDG_F05</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_LDG_T04" name="Load Truck with Shovel (2.2.2.3) — TUM: PT (shovel) / WT (truck)">
      <bpmn:incoming>P2_L3_LDG_F06</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F07</bpmn:outgoing>
    </bpmn:task>

    <bpmn:serviceTask id="P2_L3_LDG_T05" name="Verify Payload and Issue FMS Dispatch (2.2.2.4)">
      <bpmn:incoming>P2_L3_LDG_F07</bpmn:incoming>
      <bpmn:incoming>P2_L3_LDG_F11</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F08</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="P2_L3_LDG_XGW02" name="Payload within tolerance?" default="P2_L3_LDG_F09">
      <bpmn:incoming>P2_L3_LDG_F08</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F09</bpmn:outgoing>
      <bpmn:outgoing>P2_L3_LDG_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="P2_L3_LDG_T06" name="Adjust Load — add or remove bucket pass">
      <bpmn:incoming>P2_L3_LDG_F10</bpmn:incoming>
      <bpmn:outgoing>P2_L3_LDG_F11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="P2_L3_LDG_EE01" name="Truck loaded and dispatched; haul_cycle record initiated">
      <bpmn:incoming>P2_L3_LDG_F09</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="P2_L3_LDG_F01" sourceRef="P2_L3_LDG_SE" targetRef="P2_L3_LDG_T01"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F02" sourceRef="P2_L3_LDG_T01" targetRef="P2_L3_LDG_XGW01"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F03" name="No — within OD threshold" sourceRef="P2_L3_LDG_XGW01" targetRef="P2_L3_LDG_T03"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F04" name="Yes — exceeds threshold; SBO decision" sourceRef="P2_L3_LDG_XGW01" targetRef="P2_L3_LDG_T02"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F05" name="After SBO classification" sourceRef="P2_L3_LDG_T02" targetRef="P2_L3_LDG_T03"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F06" sourceRef="P2_L3_LDG_T03" targetRef="P2_L3_LDG_T04"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F07" sourceRef="P2_L3_LDG_T04" targetRef="P2_L3_LDG_T05"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F08" sourceRef="P2_L3_LDG_T05" targetRef="P2_L3_LDG_XGW02"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F09" name="Within tolerance" sourceRef="P2_L3_LDG_XGW02" targetRef="P2_L3_LDG_EE01"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F10" name="Out of tolerance" sourceRef="P2_L3_LDG_XGW02" targetRef="P2_L3_LDG_T06"/>
    <bpmn:sequenceFlow id="P2_L3_LDG_F11" name="Re-verify" sourceRef="P2_L3_LDG_T06" targetRef="P2_L3_LDG_T05"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="P2_L3_LDG_diagram">
    <bpmndi:BPMNPlane id="P2_L3_LDG_plane" bpmnElement="P2_L3_LDG_collab">
      <bpmndi:BPMNShape id="P2_L3_LDG_PL_di" bpmnElement="P2_L3_LDG_PL" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1720" height="540"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_LN_MCT_di" bpmnElement="P2_L3_LDG_LN_MCT" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1690" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_LN_SHV_di" bpmnElement="P2_L3_LDG_LN_SHV" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1690" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_LN_TRK_di" bpmnElement="P2_L3_LDG_LN_TRK" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="1690" height="180"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P2_L3_LDG_SE_di" bpmnElement="P2_L3_LDG_SE">
        <dc:Bounds x="277" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_T01_di" bpmnElement="P2_L3_LDG_T01">
        <dc:Bounds x="390" y="490" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_XGW01_di" bpmnElement="P2_L3_LDG_XGW01">
        <dc:Bounds x="600" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_T02_di" bpmnElement="P2_L3_LDG_T02">
        <dc:Bounds x="720" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_T03_di" bpmnElement="P2_L3_LDG_T03">
        <dc:Bounds x="930" y="490" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_T04_di" bpmnElement="P2_L3_LDG_T04">
        <dc:Bounds x="1140" y="310" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_T05_di" bpmnElement="P2_L3_LDG_T05">
        <dc:Bounds x="1350" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_XGW02_di" bpmnElement="P2_L3_LDG_XGW02">
        <dc:Bounds x="1560" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_T06_di" bpmnElement="P2_L3_LDG_T06">
        <dc:Bounds x="1680" y="310" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_LDG_EE01_di" bpmnElement="P2_L3_LDG_EE01">
        <dc:Bounds x="1732" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="P2_L3_LDG_F01_di" bpmnElement="P2_L3_LDG_F01">
        <di:waypoint x="313" y="170"/>
        <di:waypoint x="352" y="170"/>
        <di:waypoint x="352" y="530"/>
        <di:waypoint x="390" y="530"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F02_di" bpmnElement="P2_L3_LDG_F02">
        <di:waypoint x="530" y="530"/>
        <di:waypoint x="565" y="530"/>
        <di:waypoint x="565" y="170"/>
        <di:waypoint x="600" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F03_di" bpmnElement="P2_L3_LDG_F03">
        <di:waypoint x="650" y="170"/>
        <di:waypoint x="790" y="170"/>
        <di:waypoint x="790" y="530"/>
        <di:waypoint x="930" y="530"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F04_di" bpmnElement="P2_L3_LDG_F04">
        <di:waypoint x="650" y="170"/>
        <di:waypoint x="720" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F05_di" bpmnElement="P2_L3_LDG_F05">
        <di:waypoint x="860" y="170"/>
        <di:waypoint x="895" y="170"/>
        <di:waypoint x="895" y="530"/>
        <di:waypoint x="930" y="530"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F06_di" bpmnElement="P2_L3_LDG_F06">
        <di:waypoint x="1070" y="530"/>
        <di:waypoint x="1105" y="530"/>
        <di:waypoint x="1105" y="350"/>
        <di:waypoint x="1140" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F07_di" bpmnElement="P2_L3_LDG_F07">
        <di:waypoint x="1280" y="350"/>
        <di:waypoint x="1315" y="350"/>
        <di:waypoint x="1315" y="170"/>
        <di:waypoint x="1350" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F08_di" bpmnElement="P2_L3_LDG_F08">
        <di:waypoint x="1490" y="170"/>
        <di:waypoint x="1560" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F09_di" bpmnElement="P2_L3_LDG_F09">
        <di:waypoint x="1610" y="170"/>
        <di:waypoint x="1732" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F10_di" bpmnElement="P2_L3_LDG_F10">
        <di:waypoint x="1610" y="170"/>
        <di:waypoint x="1645" y="170"/>
        <di:waypoint x="1645" y="350"/>
        <di:waypoint x="1680" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_LDG_F11_di" bpmnElement="P2_L3_LDG_F11">
        <di:waypoint x="1750" y="390"/>
        <di:waypoint x="1750" y="425"/>
        <di:waypoint x="1420" y="425"/>
        <di:waypoint x="1420" y="210"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
