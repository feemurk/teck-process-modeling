<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="P2_L3_CHG_def"
                  targetNamespace="http://teck.com/bpmn">

  <bpmn:collaboration id="P2_L3_CHG_collab">
    <bpmn:participant id="P2_L3_CHG_PL" name="Charging &amp; Stemming" processRef="P2_L3_CHG_proc"/>
  </bpmn:collaboration>

  <bpmn:process id="P2_L3_CHG_proc" isExecutable="false">

    <bpmn:laneSet id="P2_L3_CHG_laneSet">
      <bpmn:lane id="P2_L3_CHG_LN_FMS" name="FMS / Mine Controller">
        <bpmn:flowNodeRef>P2_L3_CHG_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_CHG_T01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L3_CHG_LN_SHT" name="Shot-firer">
        <bpmn:flowNodeRef>P2_L3_CHG_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_CHG_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_CHG_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_CHG_XGW01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_CHG_EE01</bpmn:flowNodeRef>
      </bpmn:lane>
      <!-- Explosive Truck Operator lane declared per spec; charging tasks are led by the
           Shot-firer, who directs the truck operator (process model 2.1.3.2). -->
      <bpmn:lane id="P2_L3_CHG_LN_ETO" name="Explosive Truck Operator"/>
    </bpmn:laneSet>

    <bpmn:startEvent id="P2_L3_CHG_SE" name="QC-accepted holes; explosive truck available">
      <bpmn:outgoing>P2_L3_CHG_F01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="P2_L3_CHG_T01" name="Dispatch Explosive Truck to Pattern (2.1.3.1) — TUM: NP">
      <bpmn:incoming>P2_L3_CHG_F01</bpmn:incoming>
      <bpmn:outgoing>P2_L3_CHG_F02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_CHG_T02" name="Load Explosive into Holes per Design (2.1.3.2)">
      <bpmn:incoming>P2_L3_CHG_F02</bpmn:incoming>
      <bpmn:incoming>P2_L3_CHG_F06</bpmn:incoming>
      <bpmn:outgoing>P2_L3_CHG_F03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_CHG_T03" name="Apply Stemming to Design Depth (2.1.3.3)">
      <bpmn:incoming>P2_L3_CHG_F03</bpmn:incoming>
      <bpmn:outgoing>P2_L3_CHG_F04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_CHG_T04" name="Install Initiation System — detonators, delays (2.1.3.4)">
      <bpmn:incoming>P2_L3_CHG_F04</bpmn:incoming>
      <bpmn:outgoing>P2_L3_CHG_F05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="P2_L3_CHG_XGW01" name="More holes to charge?" default="P2_L3_CHG_F06">
      <bpmn:incoming>P2_L3_CHG_F05</bpmn:incoming>
      <bpmn:outgoing>P2_L3_CHG_F06</bpmn:outgoing>
      <bpmn:outgoing>P2_L3_CHG_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="P2_L3_CHG_EE01" name="All holes charged, stemmed, initiated; pattern ready to fire">
      <bpmn:incoming>P2_L3_CHG_F07</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="P2_L3_CHG_F01" sourceRef="P2_L3_CHG_SE" targetRef="P2_L3_CHG_T01"/>
    <bpmn:sequenceFlow id="P2_L3_CHG_F02" sourceRef="P2_L3_CHG_T01" targetRef="P2_L3_CHG_T02"/>
    <bpmn:sequenceFlow id="P2_L3_CHG_F03" sourceRef="P2_L3_CHG_T02" targetRef="P2_L3_CHG_T03"/>
    <bpmn:sequenceFlow id="P2_L3_CHG_F04" sourceRef="P2_L3_CHG_T03" targetRef="P2_L3_CHG_T04"/>
    <bpmn:sequenceFlow id="P2_L3_CHG_F05" sourceRef="P2_L3_CHG_T04" targetRef="P2_L3_CHG_XGW01"/>
    <bpmn:sequenceFlow id="P2_L3_CHG_F06" name="Yes — next hole (loop)" sourceRef="P2_L3_CHG_XGW01" targetRef="P2_L3_CHG_T02"/>
    <bpmn:sequenceFlow id="P2_L3_CHG_F07" name="No — all holes charged" sourceRef="P2_L3_CHG_XGW01" targetRef="P2_L3_CHG_EE01"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="P2_L3_CHG_diagram">
    <bpmndi:BPMNPlane id="P2_L3_CHG_plane" bpmnElement="P2_L3_CHG_collab">
      <bpmndi:BPMNShape id="P2_L3_CHG_PL_di" bpmnElement="P2_L3_CHG_PL" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1300" height="520"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_LN_FMS_di" bpmnElement="P2_L3_CHG_LN_FMS" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1270" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_LN_SHT_di" bpmnElement="P2_L3_CHG_LN_SHT" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1270" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_LN_ETO_di" bpmnElement="P2_L3_CHG_LN_ETO" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="1270" height="160"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P2_L3_CHG_SE_di" bpmnElement="P2_L3_CHG_SE">
        <dc:Bounds x="277" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_T01_di" bpmnElement="P2_L3_CHG_T01">
        <dc:Bounds x="390" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_T02_di" bpmnElement="P2_L3_CHG_T02">
        <dc:Bounds x="600" y="310" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_T03_di" bpmnElement="P2_L3_CHG_T03">
        <dc:Bounds x="810" y="310" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_T04_di" bpmnElement="P2_L3_CHG_T04">
        <dc:Bounds x="1020" y="310" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_XGW01_di" bpmnElement="P2_L3_CHG_XGW01">
        <dc:Bounds x="1230" y="325" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_CHG_EE01_di" bpmnElement="P2_L3_CHG_EE01">
        <dc:Bounds x="1357" y="332" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="P2_L3_CHG_F01_di" bpmnElement="P2_L3_CHG_F01">
        <di:waypoint x="313" y="170"/>
        <di:waypoint x="390" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_CHG_F02_di" bpmnElement="P2_L3_CHG_F02">
        <di:waypoint x="530" y="170"/>
        <di:waypoint x="565" y="170"/>
        <di:waypoint x="565" y="350"/>
        <di:waypoint x="600" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_CHG_F03_di" bpmnElement="P2_L3_CHG_F03">
        <di:waypoint x="740" y="350"/>
        <di:waypoint x="810" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_CHG_F04_di" bpmnElement="P2_L3_CHG_F04">
        <di:waypoint x="950" y="350"/>
        <di:waypoint x="1020" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_CHG_F05_di" bpmnElement="P2_L3_CHG_F05">
        <di:waypoint x="1160" y="350"/>
        <di:waypoint x="1230" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_CHG_F06_di" bpmnElement="P2_L3_CHG_F06">
        <di:waypoint x="1255" y="375"/>
        <di:waypoint x="1255" y="425"/>
        <di:waypoint x="670" y="425"/>
        <di:waypoint x="670" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_CHG_F07_di" bpmnElement="P2_L3_CHG_F07">
        <di:waypoint x="1280" y="350"/>
        <di:waypoint x="1357" y="350"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
