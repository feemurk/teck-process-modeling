<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="P2_L3_BDL_def"
                  targetNamespace="http://teck.com/bpmn">

  <bpmn:collaboration id="P2_L3_BDL_collab">
    <bpmn:participant id="P2_L3_BDL_PL" name="Blast Design &amp; Pattern Layout" processRef="P2_L3_BDL_proc"/>
  </bpmn:collaboration>

  <bpmn:process id="P2_L3_BDL_proc" isExecutable="false">

    <bpmn:laneSet id="P2_L3_BDL_laneSet">
      <bpmn:lane id="P2_L3_BDL_LN_ENG" name="Drill &amp; Blast Engineer">
        <bpmn:flowNodeRef>P2_L3_BDL_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_BDL_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_BDL_T03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L3_BDL_LN_SRV" name="Survey Technician">
        <bpmn:flowNodeRef>P2_L3_BDL_T01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L3_BDL_LN_SYS" name="Blast Design Software / FMS">
        <bpmn:flowNodeRef>P2_L3_BDL_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_BDL_EE01</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="P2_L3_BDL_SE" name="Approved dig polygon received">
      <bpmn:outgoing>P2_L3_BDL_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P2_L3_BDL_SE_msg"/>
    </bpmn:startEvent>

    <bpmn:task id="P2_L3_BDL_T01" name="Survey &amp; Stake Pattern on Bench (2.1.1.1)">
      <bpmn:incoming>P2_L3_BDL_F01</bpmn:incoming>
      <bpmn:outgoing>P2_L3_BDL_F02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_BDL_T02" name="Design Hole Layout Parameters — burden, spacing, depth (2.1.1.2)">
      <bpmn:incoming>P2_L3_BDL_F02</bpmn:incoming>
      <bpmn:outgoing>P2_L3_BDL_F03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_BDL_T03" name="Select Explosive Product per Hole (2.1.1.3)">
      <bpmn:incoming>P2_L3_BDL_F03</bpmn:incoming>
      <bpmn:outgoing>P2_L3_BDL_F04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:serviceTask id="P2_L3_BDL_T04" name="Upload Pattern Design to Blast Software &amp; FMS">
      <bpmn:incoming>P2_L3_BDL_F04</bpmn:incoming>
      <bpmn:outgoing>P2_L3_BDL_F05</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="P2_L3_BDL_EE01" name="Blast pattern design file available; drill guidance system loaded">
      <bpmn:incoming>P2_L3_BDL_F05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="P2_L3_BDL_F01" sourceRef="P2_L3_BDL_SE" targetRef="P2_L3_BDL_T01"/>
    <bpmn:sequenceFlow id="P2_L3_BDL_F02" sourceRef="P2_L3_BDL_T01" targetRef="P2_L3_BDL_T02"/>
    <bpmn:sequenceFlow id="P2_L3_BDL_F03" sourceRef="P2_L3_BDL_T02" targetRef="P2_L3_BDL_T03"/>
    <bpmn:sequenceFlow id="P2_L3_BDL_F04" sourceRef="P2_L3_BDL_T03" targetRef="P2_L3_BDL_T04"/>
    <bpmn:sequenceFlow id="P2_L3_BDL_F05" sourceRef="P2_L3_BDL_T04" targetRef="P2_L3_BDL_EE01"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="P2_L3_BDL_diagram">
    <bpmndi:BPMNPlane id="P2_L3_BDL_plane" bpmnElement="P2_L3_BDL_collab">
      <bpmndi:BPMNShape id="P2_L3_BDL_PL_di" bpmnElement="P2_L3_BDL_PL" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1180" height="540"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_LN_ENG_di" bpmnElement="P2_L3_BDL_LN_ENG" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1150" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_LN_SRV_di" bpmnElement="P2_L3_BDL_LN_SRV" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1150" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_LN_SYS_di" bpmnElement="P2_L3_BDL_LN_SYS" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="1150" height="180"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P2_L3_BDL_SE_di" bpmnElement="P2_L3_BDL_SE">
        <dc:Bounds x="277" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_T01_di" bpmnElement="P2_L3_BDL_T01">
        <dc:Bounds x="390" y="310" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_T02_di" bpmnElement="P2_L3_BDL_T02">
        <dc:Bounds x="600" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_T03_di" bpmnElement="P2_L3_BDL_T03">
        <dc:Bounds x="810" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_T04_di" bpmnElement="P2_L3_BDL_T04">
        <dc:Bounds x="1020" y="490" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_BDL_EE01_di" bpmnElement="P2_L3_BDL_EE01">
        <dc:Bounds x="1237" y="512" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="P2_L3_BDL_F01_di" bpmnElement="P2_L3_BDL_F01">
        <di:waypoint x="313" y="170"/>
        <di:waypoint x="352" y="170"/>
        <di:waypoint x="352" y="350"/>
        <di:waypoint x="390" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_BDL_F02_di" bpmnElement="P2_L3_BDL_F02">
        <di:waypoint x="530" y="350"/>
        <di:waypoint x="565" y="350"/>
        <di:waypoint x="565" y="170"/>
        <di:waypoint x="600" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_BDL_F03_di" bpmnElement="P2_L3_BDL_F03">
        <di:waypoint x="740" y="170"/>
        <di:waypoint x="810" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_BDL_F04_di" bpmnElement="P2_L3_BDL_F04">
        <di:waypoint x="950" y="170"/>
        <di:waypoint x="985" y="170"/>
        <di:waypoint x="985" y="530"/>
        <di:waypoint x="1020" y="530"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_BDL_F05_di" bpmnElement="P2_L3_BDL_F05">
        <di:waypoint x="1160" y="530"/>
        <di:waypoint x="1237" y="530"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
