<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="P2_L2_MS_def"
                  targetNamespace="http://teck.com/bpmn">

  <bpmn:collaboration id="P2_L2_MS_collab">
    <bpmn:participant id="P2_L2_MS_PL" name="Mine Services" processRef="P2_L2_MS_proc"/>
  </bpmn:collaboration>

  <bpmn:process id="P2_L2_MS_proc" isExecutable="false">

    <bpmn:laneSet id="P2_L2_MS_laneSet">
      <bpmn:lane id="P2_L2_MS_LN_SUP" name="Services Supervisor">
        <bpmn:flowNodeRef>P2_L2_MS_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_MS_PGW01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_MS_PGW02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_MS_EE01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L2_MS_LN_OPR" name="Road Maintenance Operator">
        <bpmn:flowNodeRef>P2_L2_MS_SP01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L2_MS_LN_DWA" name="Dewatering Operator / SCADA">
        <bpmn:flowNodeRef>P2_L2_MS_SP02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L2_MS_LN_GEO" name="Geotechnical Engineer">
        <bpmn:flowNodeRef>P2_L2_MS_SP03</bpmn:flowNodeRef>
      </bpmn:lane>
      <!-- Mine Controller lane declared per spec; controller actions (exclusion zone enforcement,
           TUM delay recording) occur inside P2_L3_SSM, so no L2 flow node sits in this lane. -->
      <bpmn:lane id="P2_L2_MS_LN_MCT" name="Mine Controller"/>
    </bpmn:laneSet>

    <bpmn:startEvent id="P2_L2_MS_SE" name="Shift start; services active">
      <bpmn:outgoing>P2_L2_MS_F01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="P2_L2_MS_PGW01" name="[FORK] Three service streams run concurrently">
      <bpmn:incoming>P2_L2_MS_F01</bpmn:incoming>
      <bpmn:outgoing>P2_L2_MS_F02</bpmn:outgoing>
      <bpmn:outgoing>P2_L2_MS_F03</bpmn:outgoing>
      <bpmn:outgoing>P2_L2_MS_F04</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:subProcess id="P2_L2_MS_SP01" name="Haul Road Maintenance (2.3.1)" triggeredByEvent="false">
      <bpmn:incoming>P2_L2_MS_F02</bpmn:incoming>
      <bpmn:outgoing>P2_L2_MS_F05</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Loop marker per spec: dewatering cycles continuously on sump level setpoints. -->
    <bpmn:subProcess id="P2_L2_MS_SP02" name="Pit Dewatering (2.3.2)" triggeredByEvent="false">
      <bpmn:incoming>P2_L2_MS_F03</bpmn:incoming>
      <bpmn:outgoing>P2_L2_MS_F06</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics/>
    </bpmn:subProcess>

    <!-- Loop marker per spec: slope monitoring repeats on the scheduled scan interval. -->
    <bpmn:subProcess id="P2_L2_MS_SP03" name="Slope Stability Monitoring (2.3.3)" triggeredByEvent="false">
      <bpmn:incoming>P2_L2_MS_F04</bpmn:incoming>
      <bpmn:outgoing>P2_L2_MS_F07</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics/>
    </bpmn:subProcess>

    <bpmn:parallelGateway id="P2_L2_MS_PGW02" name="[JOIN] Shift end — all streams complete">
      <bpmn:incoming>P2_L2_MS_F05</bpmn:incoming>
      <bpmn:incoming>P2_L2_MS_F06</bpmn:incoming>
      <bpmn:incoming>P2_L2_MS_F07</bpmn:incoming>
      <bpmn:outgoing>P2_L2_MS_F08</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="P2_L2_MS_EE01" name="Shift end; service records submitted">
      <bpmn:incoming>P2_L2_MS_F08</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="P2_L2_MS_F01" sourceRef="P2_L2_MS_SE" targetRef="P2_L2_MS_PGW01"/>
    <bpmn:sequenceFlow id="P2_L2_MS_F02" name="Parallel stream 1" sourceRef="P2_L2_MS_PGW01" targetRef="P2_L2_MS_SP01"/>
    <bpmn:sequenceFlow id="P2_L2_MS_F03" name="Parallel stream 2" sourceRef="P2_L2_MS_PGW01" targetRef="P2_L2_MS_SP02"/>
    <bpmn:sequenceFlow id="P2_L2_MS_F04" name="Parallel stream 3" sourceRef="P2_L2_MS_PGW01" targetRef="P2_L2_MS_SP03"/>
    <bpmn:sequenceFlow id="P2_L2_MS_F05" sourceRef="P2_L2_MS_SP01" targetRef="P2_L2_MS_PGW02"/>
    <bpmn:sequenceFlow id="P2_L2_MS_F06" sourceRef="P2_L2_MS_SP02" targetRef="P2_L2_MS_PGW02"/>
    <bpmn:sequenceFlow id="P2_L2_MS_F07" sourceRef="P2_L2_MS_SP03" targetRef="P2_L2_MS_PGW02"/>
    <bpmn:sequenceFlow id="P2_L2_MS_F08" sourceRef="P2_L2_MS_PGW02" targetRef="P2_L2_MS_EE01"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="P2_L2_MS_diagram">
    <bpmndi:BPMNPlane id="P2_L2_MS_plane" bpmnElement="P2_L2_MS_collab">
      <bpmndi:BPMNShape id="P2_L2_MS_PL_di" bpmnElement="P2_L2_MS_PL" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="810" height="920"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_LN_SUP_di" bpmnElement="P2_L2_MS_LN_SUP" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="780" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_LN_OPR_di" bpmnElement="P2_L2_MS_LN_OPR" isHorizontal="true">
        <dc:Bounds x="190" y="270" width="780" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_LN_DWA_di" bpmnElement="P2_L2_MS_LN_DWA" isHorizontal="true">
        <dc:Bounds x="190" y="460" width="780" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_LN_GEO_di" bpmnElement="P2_L2_MS_LN_GEO" isHorizontal="true">
        <dc:Bounds x="190" y="650" width="780" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_LN_MCT_di" bpmnElement="P2_L2_MS_LN_MCT" isHorizontal="true">
        <dc:Bounds x="190" y="840" width="780" height="160"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P2_L2_MS_SE_di" bpmnElement="P2_L2_MS_SE">
        <dc:Bounds x="277" y="157" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_PGW01_di" bpmnElement="P2_L2_MS_PGW01">
        <dc:Bounds x="390" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_SP01_di" bpmnElement="P2_L2_MS_SP01" isExpanded="false">
        <dc:Bounds x="510" y="315" width="160" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_SP02_di" bpmnElement="P2_L2_MS_SP02" isExpanded="false">
        <dc:Bounds x="510" y="505" width="160" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_SP03_di" bpmnElement="P2_L2_MS_SP03" isExpanded="false">
        <dc:Bounds x="510" y="695" width="160" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_PGW02_di" bpmnElement="P2_L2_MS_PGW02">
        <dc:Bounds x="740" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_MS_EE01_di" bpmnElement="P2_L2_MS_EE01">
        <dc:Bounds x="867" y="157" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="P2_L2_MS_F01_di" bpmnElement="P2_L2_MS_F01">
        <di:waypoint x="313" y="175"/>
        <di:waypoint x="390" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_MS_F02_di" bpmnElement="P2_L2_MS_F02">
        <di:waypoint x="440" y="175"/>
        <di:waypoint x="475" y="175"/>
        <di:waypoint x="475" y="365"/>
        <di:waypoint x="510" y="365"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_MS_F03_di" bpmnElement="P2_L2_MS_F03">
        <di:waypoint x="440" y="175"/>
        <di:waypoint x="475" y="175"/>
        <di:waypoint x="475" y="555"/>
        <di:waypoint x="510" y="555"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_MS_F04_di" bpmnElement="P2_L2_MS_F04">
        <di:waypoint x="440" y="175"/>
        <di:waypoint x="475" y="175"/>
        <di:waypoint x="475" y="745"/>
        <di:waypoint x="510" y="745"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_MS_F05_di" bpmnElement="P2_L2_MS_F05">
        <di:waypoint x="670" y="365"/>
        <di:waypoint x="705" y="365"/>
        <di:waypoint x="705" y="175"/>
        <di:waypoint x="740" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_MS_F06_di" bpmnElement="P2_L2_MS_F06">
        <di:waypoint x="670" y="555"/>
        <di:waypoint x="705" y="555"/>
        <di:waypoint x="705" y="175"/>
        <di:waypoint x="740" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_MS_F07_di" bpmnElement="P2_L2_MS_F07">
        <di:waypoint x="670" y="745"/>
        <di:waypoint x="705" y="745"/>
        <di:waypoint x="705" y="175"/>
        <di:waypoint x="740" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_MS_F08_di" bpmnElement="P2_L2_MS_F08">
        <di:waypoint x="790" y="175"/>
        <di:waypoint x="867" y="175"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
