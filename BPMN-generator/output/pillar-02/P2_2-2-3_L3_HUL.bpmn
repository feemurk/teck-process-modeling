<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="P2_L3_HUL_def"
                  targetNamespace="http://teck.com/bpmn">

  <bpmn:collaboration id="P2_L3_HUL_collab">
    <bpmn:participant id="P2_L3_HUL_PL" name="Hauling" processRef="P2_L3_HUL_proc"/>
  </bpmn:collaboration>

  <bpmn:process id="P2_L3_HUL_proc" isExecutable="false">

    <bpmn:laneSet id="P2_L3_HUL_laneSet">
      <bpmn:lane id="P2_L3_HUL_LN_MCT" name="Mine Controller / FMS">
        <bpmn:flowNodeRef>P2_L3_HUL_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_XGW01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_EE01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_EE02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L3_HUL_LN_TRK" name="Truck Operator">
        <bpmn:flowNodeRef>P2_L3_HUL_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_ICE01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L3_HUL_T07</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="P2_L3_HUL_SE" name="Truck loaded and dispatched">
      <bpmn:outgoing>P2_L3_HUL_F01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="P2_L3_HUL_T01" name="Execute Loaded Haul (2.2.3.1) — TUM: WT">
      <bpmn:incoming>P2_L3_HUL_F01</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F02</bpmn:outgoing>
    </bpmn:task>

    <!-- SPEC RESOLUTION: the spec types P2_L3_HUL_ICE01 as an intermediate catch (error) with the
         note "boundary on T01". A BPMN error event cannot stand alone in the flow, so it is
         rendered here as an interrupting boundaryEvent attached to P2_L3_HUL_T01, preserving the
         spec ID and the F03 outgoing flow. Narrative reference: process model 2.2.3.1 breakdown
         path (TUM: DT), pillar 2 → pillar 5 work_order linkage. -->
    <bpmn:boundaryEvent id="P2_L3_HUL_ICE01" name="Breakdown during haul" attachedToRef="P2_L3_HUL_T01" cancelActivity="true">
      <bpmn:outgoing>P2_L3_HUL_F03</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P2_L3_HUL_ICE01_err"/>
    </bpmn:boundaryEvent>

    <bpmn:task id="P2_L3_HUL_T02" name="Classify TUM: DT; notify maintenance">
      <bpmn:incoming>P2_L3_HUL_F03</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_HUL_T03" name="Queue at Destination (2.2.3.2) — TUM: OD or SBO">
      <bpmn:incoming>P2_L3_HUL_F02</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="P2_L3_HUL_XGW01" name="Queue at destination — OD or SBO?" default="P2_L3_HUL_F06">
      <bpmn:incoming>P2_L3_HUL_F05</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F06</bpmn:outgoing>
      <bpmn:outgoing>P2_L3_HUL_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="P2_L3_HUL_T04" name="Classify Queue as SBO; record mine controller decision">
      <bpmn:incoming>P2_L3_HUL_F07</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_HUL_T05" name="Spot Truck at Dump (2.2.3.3) — TUM: NP">
      <bpmn:incoming>P2_L3_HUL_F06</bpmn:incoming>
      <bpmn:incoming>P2_L3_HUL_F08</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F09</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_HUL_T06" name="Dump Load (2.2.3.4) — TUM: WT">
      <bpmn:incoming>P2_L3_HUL_F09</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L3_HUL_T07" name="Execute Empty Return (2.2.3.5) — TUM: NP">
      <bpmn:incoming>P2_L3_HUL_F10</bpmn:incoming>
      <bpmn:outgoing>P2_L3_HUL_F11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="P2_L3_HUL_EE01" name="Cycle complete; truck returns to face; haul_cycle record closed">
      <bpmn:incoming>P2_L3_HUL_F11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="P2_L3_HUL_EE02" name="Equipment in TUM: DT — awaiting maintenance">
      <bpmn:incoming>P2_L3_HUL_F04</bpmn:incoming>
      <bpmn:errorEventDefinition id="P2_L3_HUL_EE02_err"/>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="P2_L3_HUL_F01" sourceRef="P2_L3_HUL_SE" targetRef="P2_L3_HUL_T01"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F02" name="Normal — no breakdown" sourceRef="P2_L3_HUL_T01" targetRef="P2_L3_HUL_T03"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F03" name="Breakdown detected" sourceRef="P2_L3_HUL_ICE01" targetRef="P2_L3_HUL_T02"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F04" name="Awaiting maintenance" sourceRef="P2_L3_HUL_T02" targetRef="P2_L3_HUL_EE02"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F05" sourceRef="P2_L3_HUL_T03" targetRef="P2_L3_HUL_XGW01"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F06" name="Within OD threshold" sourceRef="P2_L3_HUL_XGW01" targetRef="P2_L3_HUL_T05"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F07" name="Exceeds threshold" sourceRef="P2_L3_HUL_XGW01" targetRef="P2_L3_HUL_T04"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F08" name="After SBO classification" sourceRef="P2_L3_HUL_T04" targetRef="P2_L3_HUL_T05"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F09" sourceRef="P2_L3_HUL_T05" targetRef="P2_L3_HUL_T06"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F10" sourceRef="P2_L3_HUL_T06" targetRef="P2_L3_HUL_T07"/>
    <bpmn:sequenceFlow id="P2_L3_HUL_F11" sourceRef="P2_L3_HUL_T07" targetRef="P2_L3_HUL_EE01"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="P2_L3_HUL_diagram">
    <bpmndi:BPMNPlane id="P2_L3_HUL_plane" bpmnElement="P2_L3_HUL_collab">
      <bpmndi:BPMNShape id="P2_L3_HUL_PL_di" bpmnElement="P2_L3_HUL_PL" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1720" height="490"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_LN_MCT_di" bpmnElement="P2_L3_HUL_LN_MCT" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1690" height="310"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_LN_TRK_di" bpmnElement="P2_L3_HUL_LN_TRK" isHorizontal="true">
        <dc:Bounds x="190" y="390" width="1690" height="180"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P2_L3_HUL_SE_di" bpmnElement="P2_L3_HUL_SE">
        <dc:Bounds x="277" y="462" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_T01_di" bpmnElement="P2_L3_HUL_T01">
        <dc:Bounds x="390" y="440" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_ICE01_di" bpmnElement="P2_L3_HUL_ICE01">
        <dc:Bounds x="473" y="502" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_T02_di" bpmnElement="P2_L3_HUL_T02">
        <dc:Bounds x="600" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_T03_di" bpmnElement="P2_L3_HUL_T03">
        <dc:Bounds x="600" y="440" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_XGW01_di" bpmnElement="P2_L3_HUL_XGW01">
        <dc:Bounds x="810" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_T04_di" bpmnElement="P2_L3_HUL_T04">
        <dc:Bounds x="930" y="130" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_T05_di" bpmnElement="P2_L3_HUL_T05">
        <dc:Bounds x="1140" y="440" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_T06_di" bpmnElement="P2_L3_HUL_T06">
        <dc:Bounds x="1350" y="440" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_T07_di" bpmnElement="P2_L3_HUL_T07">
        <dc:Bounds x="1560" y="440" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_EE01_di" bpmnElement="P2_L3_HUL_EE01">
        <dc:Bounds x="1777" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L3_HUL_EE02_di" bpmnElement="P2_L3_HUL_EE02">
        <dc:Bounds x="817" y="282" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="P2_L3_HUL_F01_di" bpmnElement="P2_L3_HUL_F01">
        <di:waypoint x="313" y="480"/>
        <di:waypoint x="390" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F02_di" bpmnElement="P2_L3_HUL_F02">
        <di:waypoint x="530" y="480"/>
        <di:waypoint x="600" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F03_di" bpmnElement="P2_L3_HUL_F03">
        <di:waypoint x="491" y="538"/>
        <di:waypoint x="491" y="170"/>
        <di:waypoint x="600" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F04_di" bpmnElement="P2_L3_HUL_F04">
        <di:waypoint x="740" y="170"/>
        <di:waypoint x="778" y="170"/>
        <di:waypoint x="778" y="300"/>
        <di:waypoint x="817" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F05_di" bpmnElement="P2_L3_HUL_F05">
        <di:waypoint x="740" y="480"/>
        <di:waypoint x="775" y="480"/>
        <di:waypoint x="775" y="170"/>
        <di:waypoint x="810" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F06_di" bpmnElement="P2_L3_HUL_F06">
        <di:waypoint x="860" y="170"/>
        <di:waypoint x="1000" y="170"/>
        <di:waypoint x="1000" y="480"/>
        <di:waypoint x="1140" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F07_di" bpmnElement="P2_L3_HUL_F07">
        <di:waypoint x="860" y="170"/>
        <di:waypoint x="930" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F08_di" bpmnElement="P2_L3_HUL_F08">
        <di:waypoint x="1070" y="170"/>
        <di:waypoint x="1105" y="170"/>
        <di:waypoint x="1105" y="480"/>
        <di:waypoint x="1140" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F09_di" bpmnElement="P2_L3_HUL_F09">
        <di:waypoint x="1280" y="480"/>
        <di:waypoint x="1350" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F10_di" bpmnElement="P2_L3_HUL_F10">
        <di:waypoint x="1490" y="480"/>
        <di:waypoint x="1560" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L3_HUL_F11_di" bpmnElement="P2_L3_HUL_F11">
        <di:waypoint x="1700" y="480"/>
        <di:waypoint x="1738" y="480"/>
        <di:waypoint x="1738" y="170"/>
        <di:waypoint x="1777" y="170"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
