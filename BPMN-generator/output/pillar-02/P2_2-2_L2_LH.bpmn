<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="P2_L2_LH_def"
                  targetNamespace="http://teck.com/bpmn">

  <bpmn:collaboration id="P2_L2_LH_collab">
    <bpmn:participant id="P2_L2_LH_PL" name="Load &amp; Haul" processRef="P2_L2_LH_proc"/>
  </bpmn:collaboration>

  <bpmn:process id="P2_L2_LH_proc" isExecutable="false">

    <bpmn:laneSet id="P2_L2_LH_laneSet">
      <bpmn:lane id="P2_L2_LH_LN_MCT" name="Mine Controller / FMS">
        <bpmn:flowNodeRef>P2_L2_LH_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_PGW01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_XGW01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_PGW02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_SP04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_EE01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L2_LH_LN_SHV" name="Shovel Operator">
        <bpmn:flowNodeRef>P2_L2_LH_SP01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_L2_LH_SP02</bpmn:flowNodeRef>
      </bpmn:lane>
      <!-- Dozer Operator lane declared per spec; dozer activity is detailed inside the
           Face Preparation sub-process (P2_L3_FCP), so no L2 flow node sits in this lane. -->
      <bpmn:lane id="P2_L2_LH_LN_DZR" name="Dozer Operator"/>
      <bpmn:lane id="P2_L2_LH_LN_TRK" name="Truck Operator">
        <bpmn:flowNodeRef>P2_L2_LH_SP03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="P2_L2_LH_SE" name="Shift start; targets loaded; muck pile classified">
      <bpmn:outgoing>P2_L2_LH_F01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="P2_L2_LH_T01" name="Assign Equipment to Shift">
      <bpmn:incoming>P2_L2_LH_F01</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="P2_L2_LH_PGW01" name="[FORK] Multiple trucks and shovels operate concurrently">
      <bpmn:incoming>P2_L2_LH_F02</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F03</bpmn:outgoing>
      <bpmn:outgoing>P2_L2_LH_F04</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:subProcess id="P2_L2_LH_SP01" name="Face Preparation (2.2.1)" triggeredByEvent="false">
      <bpmn:incoming>P2_L2_LH_F03</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F05</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:subProcess id="P2_L2_LH_SP02" name="Loading (2.2.2)" triggeredByEvent="false">
      <bpmn:incoming>P2_L2_LH_F05</bpmn:incoming>
      <bpmn:incoming>P2_L2_LH_F08</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F06</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Loop marker per spec: the haul cycle repeats until shift end or face exhaustion. -->
    <bpmn:subProcess id="P2_L2_LH_SP03" name="Hauling (2.2.3)" triggeredByEvent="false">
      <bpmn:incoming>P2_L2_LH_F06</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F07</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics/>
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="P2_L2_LH_XGW01" name="Shift end or face exhausted?" default="P2_L2_LH_F08">
      <bpmn:incoming>P2_L2_LH_F07</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F08</bpmn:outgoing>
      <bpmn:outgoing>P2_L2_LH_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Continuous parallel stream — runs alongside the haul cycle for the whole shift. -->
    <bpmn:subProcess id="P2_L2_LH_SP04" name="Stockpile Management (2.2.4)" triggeredByEvent="false">
      <bpmn:incoming>P2_L2_LH_F04</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F10</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:parallelGateway id="P2_L2_LH_PGW02" name="[JOIN] All trucks report cycle complete">
      <bpmn:incoming>P2_L2_LH_F09</bpmn:incoming>
      <bpmn:incoming>P2_L2_LH_F10</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F11</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="P2_L2_LH_T02" name="Reconcile Open Haul Cycle Records">
      <bpmn:incoming>P2_L2_LH_F11</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="P2_L2_LH_T03" name="Generate and Commit Shift Production Report">
      <bpmn:incoming>P2_L2_LH_F12</bpmn:incoming>
      <bpmn:outgoing>P2_L2_LH_F13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="P2_L2_LH_EE01" name="Shift report committed; actuals uploaded">
      <bpmn:incoming>P2_L2_LH_F13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="P2_L2_LH_F01" sourceRef="P2_L2_LH_SE" targetRef="P2_L2_LH_T01"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F02" sourceRef="P2_L2_LH_T01" targetRef="P2_L2_LH_PGW01"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F03" name="Parallel branch 1 — shovel" sourceRef="P2_L2_LH_PGW01" targetRef="P2_L2_LH_SP01"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F04" name="Parallel branch 2 — stockpile mgmt (continuous)" sourceRef="P2_L2_LH_PGW01" targetRef="P2_L2_LH_SP04"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F05" sourceRef="P2_L2_LH_SP01" targetRef="P2_L2_LH_SP02"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F06" sourceRef="P2_L2_LH_SP02" targetRef="P2_L2_LH_SP03"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F07" name="Cycle complete" sourceRef="P2_L2_LH_SP03" targetRef="P2_L2_LH_XGW01"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F08" name="No — continue cycling" sourceRef="P2_L2_LH_XGW01" targetRef="P2_L2_LH_SP02"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F09" name="Yes — shift end or face exhausted" sourceRef="P2_L2_LH_XGW01" targetRef="P2_L2_LH_PGW02"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F10" name="Stockpile stream joins at shift end" sourceRef="P2_L2_LH_SP04" targetRef="P2_L2_LH_PGW02"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F11" sourceRef="P2_L2_LH_PGW02" targetRef="P2_L2_LH_T02"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F12" sourceRef="P2_L2_LH_T02" targetRef="P2_L2_LH_T03"/>
    <bpmn:sequenceFlow id="P2_L2_LH_F13" sourceRef="P2_L2_LH_T03" targetRef="P2_L2_LH_EE01"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="P2_L2_LH_diagram">
    <bpmndi:BPMNPlane id="P2_L2_LH_plane" bpmnElement="P2_L2_LH_collab">
      <bpmndi:BPMNShape id="P2_L2_LH_PL_di" bpmnElement="P2_L2_LH_PL" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2020" height="730"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_LN_MCT_di" bpmnElement="P2_L2_LH_LN_MCT" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1990" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_LN_SHV_di" bpmnElement="P2_L2_LH_LN_SHV" isHorizontal="true">
        <dc:Bounds x="190" y="270" width="1990" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_LN_DZR_di" bpmnElement="P2_L2_LH_LN_DZR" isHorizontal="true">
        <dc:Bounds x="190" y="460" width="1990" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_LN_TRK_di" bpmnElement="P2_L2_LH_LN_TRK" isHorizontal="true">
        <dc:Bounds x="190" y="620" width="1990" height="190"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P2_L2_LH_SE_di" bpmnElement="P2_L2_LH_SE">
        <dc:Bounds x="277" y="157" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_T01_di" bpmnElement="P2_L2_LH_T01">
        <dc:Bounds x="390" y="135" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_PGW01_di" bpmnElement="P2_L2_LH_PGW01">
        <dc:Bounds x="600" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_SP01_di" bpmnElement="P2_L2_LH_SP01" isExpanded="false">
        <dc:Bounds x="720" y="315" width="160" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_SP02_di" bpmnElement="P2_L2_LH_SP02" isExpanded="false">
        <dc:Bounds x="950" y="315" width="160" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_SP03_di" bpmnElement="P2_L2_LH_SP03" isExpanded="false">
        <dc:Bounds x="1180" y="665" width="160" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_XGW01_di" bpmnElement="P2_L2_LH_XGW01">
        <dc:Bounds x="1410" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_SP04_di" bpmnElement="P2_L2_LH_SP04" isExpanded="false">
        <dc:Bounds x="720" y="125" width="160" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_PGW02_di" bpmnElement="P2_L2_LH_PGW02">
        <dc:Bounds x="1530" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_T02_di" bpmnElement="P2_L2_LH_T02">
        <dc:Bounds x="1650" y="135" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_T03_di" bpmnElement="P2_L2_LH_T03">
        <dc:Bounds x="1860" y="135" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_LH_EE01_di" bpmnElement="P2_L2_LH_EE01">
        <dc:Bounds x="2077" y="157" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="P2_L2_LH_F01_di" bpmnElement="P2_L2_LH_F01">
        <di:waypoint x="313" y="175"/>
        <di:waypoint x="390" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F02_di" bpmnElement="P2_L2_LH_F02">
        <di:waypoint x="530" y="175"/>
        <di:waypoint x="600" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F03_di" bpmnElement="P2_L2_LH_F03">
        <di:waypoint x="650" y="175"/>
        <di:waypoint x="685" y="175"/>
        <di:waypoint x="685" y="365"/>
        <di:waypoint x="720" y="365"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F04_di" bpmnElement="P2_L2_LH_F04">
        <di:waypoint x="650" y="175"/>
        <di:waypoint x="720" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F05_di" bpmnElement="P2_L2_LH_F05">
        <di:waypoint x="880" y="365"/>
        <di:waypoint x="950" y="365"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F06_di" bpmnElement="P2_L2_LH_F06">
        <di:waypoint x="1110" y="365"/>
        <di:waypoint x="1145" y="365"/>
        <di:waypoint x="1145" y="715"/>
        <di:waypoint x="1180" y="715"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F07_di" bpmnElement="P2_L2_LH_F07">
        <di:waypoint x="1340" y="715"/>
        <di:waypoint x="1375" y="715"/>
        <di:waypoint x="1375" y="175"/>
        <di:waypoint x="1410" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F08_di" bpmnElement="P2_L2_LH_F08">
        <di:waypoint x="1435" y="200"/>
        <di:waypoint x="1435" y="450"/>
        <di:waypoint x="1030" y="450"/>
        <di:waypoint x="1030" y="415"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F09_di" bpmnElement="P2_L2_LH_F09">
        <di:waypoint x="1460" y="175"/>
        <di:waypoint x="1530" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F10_di" bpmnElement="P2_L2_LH_F10">
        <di:waypoint x="880" y="175"/>
        <di:waypoint x="1530" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F11_di" bpmnElement="P2_L2_LH_F11">
        <di:waypoint x="1580" y="175"/>
        <di:waypoint x="1650" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F12_di" bpmnElement="P2_L2_LH_F12">
        <di:waypoint x="1790" y="175"/>
        <di:waypoint x="1860" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_L2_LH_F13_di" bpmnElement="P2_L2_LH_F13">
        <di:waypoint x="2000" y="175"/>
        <di:waypoint x="2077" y="175"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
