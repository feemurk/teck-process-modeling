<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L2_3_1" targetNamespace="https://teck.example/process-models/pillar-03">
  <bpmn:collaboration id="Collab_L2_3_1">
    <bpmn:participant id="Pool_L2_3_1" name="3.1 Comminution (L2)" processRef="Process_L2_3_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L2_3_1" isExecutable="false">
    <bpmn:documentation>L2 Process Area. Progressive size reduction of ROM ore from run-of-mine fragmentation (typically P80 150–250 mm) to a target grind size suitable for flotation (P80 75–150 µm depending on ore and circuit). Encompasses primary crushing, secondary/tertiary crushing and screening where applicable, SAG and ball milling, and hydrocyclone classification.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L2_3_1">
      <bpmn:lane id="Lane_L2_3_1_dcs" name="Control Room Operator / DCS Auto-control">
        <bpmn:flowNodeRef>Start_L2_3_1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_3_1_3_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_L2_3_1_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_3_1_3_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_3_1_3_1_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L2_3_1_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L2_3_1_s" name="ROM ore at crusher; plant in Run state">
      <bpmn:outgoing>Flow_L2_3_1_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_L2_3_1_3_1_1" name="3.1.1 Primary Crushing">
      <bpmn:documentation>L0/L1/L2 Process. Jaw or gyratory crusher reduces ROM ore from truck-tipped fragmentation (typically P80 150–350 mm) to a product suitable for conveying and secondary crushing or direct SAG mill feed (P80 80–150 mm). The primary crusher is the first fixed measurement point in the process.
ISA-95 level: 0–2
Actors: Control Room Operator; DCS Auto-control
Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 5
DDVC layer: Raw (time-series); Curated (process_measurement_point)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_1_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_1_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_L2_3_1_g" name="Secondary crushing fitted?" default="Flow_L2_3_1_4">
      <bpmn:incoming>Flow_L2_3_1_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_1_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_L2_3_1_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_L2_3_1_3_1_2" name="3.1.2 Secondary/Tertiary Crushing &amp; Screening">
      <bpmn:documentation>L0/L2 Process. Not all circuits include secondary/tertiary crushing. Where present (typically in three-stage crushing circuits preceding ball mills, or as pebble crushers in SABC circuits), screens classify crushed product and recirculate oversize. This sub-process is conditional — it applies where a dedicated crushing circuit precedes ball milling. [COPPER NOTE: QB and HVC use SABC circuits — pebble crusher applies. ZINC NOTE: Red Dog uses a three-stage crushing circuit preceding the grinding circuit.]
ISA-95 level: 0–2
Actors: DCS Auto-control; Control Room Operator
Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principle 1
DDVC layer: Raw (time-series)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_1_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_1_5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_3_1_3_1_3" name="3.1.3 Grinding &amp; Classification">
      <bpmn:documentation>L0/L1/L2 Process. SAG and ball mills reduce ore to the target grind size (P80 75–150 µm) in a wet grinding circuit with water addition and steel grinding media. Hydrocyclone clusters classify ground slurry — underflow (coarse) is recycled to the ball mill, overflow (fine) advances to flotation as the mill circuit product. The mill circuit product P80 is the key quality handoff from Comminution to Flotation.
ISA-95 level: 0–2
Actors: Control Room Operator; DCS Auto-control; Metallurgist
Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 2
DDVC layer: Raw (time-series: mill_telemetry); Curated (process_measurement_point — cyclone_overflow_grade)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_1_4</bpmn:incoming>
      <bpmn:incoming>Flow_L2_3_1_5</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_1_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_L2_3_1_e" name="Cyclone overflow at target P80">
      <bpmn:incoming>Flow_L2_3_1_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L2_3_1_1" sourceRef="Start_L2_3_1_s" targetRef="Sub_L2_3_1_3_1_1"/>
    <bpmn:sequenceFlow id="Flow_L2_3_1_2" sourceRef="Sub_L2_3_1_3_1_1" targetRef="Gw_L2_3_1_g"/>
    <bpmn:sequenceFlow id="Flow_L2_3_1_3" name="Yes" sourceRef="Gw_L2_3_1_g" targetRef="Sub_L2_3_1_3_1_2"/>
    <bpmn:sequenceFlow id="Flow_L2_3_1_4" name="No" sourceRef="Gw_L2_3_1_g" targetRef="Sub_L2_3_1_3_1_3"/>
    <bpmn:sequenceFlow id="Flow_L2_3_1_5" sourceRef="Sub_L2_3_1_3_1_2" targetRef="Sub_L2_3_1_3_1_3"/>
    <bpmn:sequenceFlow id="Flow_L2_3_1_6" sourceRef="Sub_L2_3_1_3_1_3" targetRef="End_L2_3_1_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L2_3_1">
    <bpmndi:BPMNPlane id="Plane_L2_3_1" bpmnElement="Collab_L2_3_1">
      <bpmndi:BPMNShape id="Pool_L2_3_1_di" bpmnElement="Pool_L2_3_1" isHorizontal="true"><dc:Bounds x="20" y="20" width="1022" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_3_1_dcs_di" bpmnElement="Lane_L2_3_1_dcs" isHorizontal="true"><dc:Bounds x="60" y="20" width="982" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L2_3_1_s_di" bpmnElement="Start_L2_3_1_s"><dc:Bounds x="110" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="139" width="100" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_1_3_1_1_di" bpmnElement="Sub_L2_3_1_3_1_1" isExpanded="false"><dc:Bounds x="202" y="57" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L2_3_1_g_di" bpmnElement="Gw_L2_3_1_g" isMarkerVisible="true"><dc:Bounds x="408" y="70" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="393" y="22" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_1_3_1_2_di" bpmnElement="Sub_L2_3_1_3_1_2" isExpanded="false"><dc:Bounds x="514" y="227" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_1_3_1_3_di" bpmnElement="Sub_L2_3_1_3_1_3" isExpanded="false"><dc:Bounds x="720" y="57" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L2_3_1_e_di" bpmnElement="End_L2_3_1_e"><dc:Bounds x="926" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="904" y="139" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L2_3_1_1_di" bpmnElement="Flow_L2_3_1_1"><di:waypoint x="166" y="105"/><di:waypoint x="202" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_1_2_di" bpmnElement="Flow_L2_3_1_2"><di:waypoint x="372" y="105"/><di:waypoint x="408" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_1_3_di" bpmnElement="Flow_L2_3_1_3"><di:waypoint x="443" y="140"/><di:waypoint x="443" y="275"/><di:waypoint x="514" y="275"/><bpmndi:BPMNLabel><dc:Bounds x="449" y="144" width="27" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_1_4_di" bpmnElement="Flow_L2_3_1_4"><di:waypoint x="478" y="105"/><di:waypoint x="720" y="105"/><bpmndi:BPMNLabel><dc:Bounds x="482" y="85" width="21" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_1_5_di" bpmnElement="Flow_L2_3_1_5"><di:waypoint x="684" y="275"/><di:waypoint x="805" y="275"/><di:waypoint x="805" y="153"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_1_6_di" bpmnElement="Flow_L2_3_1_6"><di:waypoint x="890" y="105"/><di:waypoint x="926" y="105"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
