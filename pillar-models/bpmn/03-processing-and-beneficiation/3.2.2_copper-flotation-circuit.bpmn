      <bpmndi:BPMNShape id="Service_L3_3_2_2_3_2_2_2_di" bpmnElement="Service_L3_3_2_2_3_2_2_2"><dc:Bounds x="614" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L3_3_2_2_g2_di" bpmnElement="Gw_L3_3_2_2_g2" isMarkerVisible="true"><dc:Bounds x="870" y="70" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="855" y="22" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_2_2_n2_di" bpmnElement="Task_L3_3_2_2_n2"><dc:Bounds x="820" y="235" width="170" height="80"/></bpmndi:BPMNShape>
