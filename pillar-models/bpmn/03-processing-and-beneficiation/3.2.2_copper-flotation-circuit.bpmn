      <bpmndi:BPMNShape id="Lane_L3_3_2_2_met_di" bpmnElement="Lane_L3_3_2_2_met" isHorizontal="true"><dc:Bounds x="60" y="190" width="1700" height="170"/></bpmndi:BPMNShape>
