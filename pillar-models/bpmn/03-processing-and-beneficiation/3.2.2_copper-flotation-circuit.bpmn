      <bpmndi:BPMNEdge id="Flow_L3_3_2_2_13_di" bpmnElement="Flow_L3_3_2_2_13"><di:waypoint x="1523" y="140"/><di:waypoint x="1523" y="235"/><bpmndi:BPMNLabel><dc:Bounds x="1529" y="144" width="27" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_2_2_14_di" bpmnElement="Flow_L3_3_2_2_14"><di:waypoint x="1608" y="275"/><di:waypoint x="1672" y="275"/><di:waypoint x="1672" y="133"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
