<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L2_3_6" targetNamespace="https://teck.example/process-models/pillar-03">
  <bpmn:collaboration id="Collab_L2_3_6">
    <bpmn:participant id="Pool_L2_3_6" name="3.6 Water Management (L2)" processRef="Process_L2_3_6"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L2_3_6" isExecutable="false">
    <bpmn:documentation>L2 Process Area. Supplies, recovers, distributes and accounts for the water the plant and the tailings facility use. Water enters as makeup water from a configured source, treated where required; it is recovered by thickening and filtration (3.3), reclaimed from the TSF pond and recovered from seepage and drainage; it is blended into process water and distributed to users; and it is accounted for in a periodic site water balance that counts each volume once.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L2_3_6">
      <bpmn:lane id="Lane_L2_3_6_wat" name="Water Operator / Control Room Operator">
        <bpmn:flowNodeRef>Sub_L2_3_6_3_6_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_3_6_3_6_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_3_6_tail" name="Tailings Operator">
        <bpmn:flowNodeRef>Start_L2_3_6_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_L2_3_6_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_3_6_3_6_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_3_6_3_6_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_L2_3_6_j</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_3_6_rep" name="Water Balance Analyst">
        <bpmn:flowNodeRef>Sub_L2_3_6_3_6_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L2_3_6_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L2_3_6_s" name="Site water systems operating">
      <bpmn:outgoing>Flow_L2_3_6_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Par_L2_3_6_f">
      <bpmn:incoming>Flow_L2_3_6_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_6_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_L2_3_6_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_L2_3_6_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Sub_L2_3_6_3_6_1" name="3.6.1 Makeup Water Supply">
      <bpmn:documentation>L0/L1/L2 Process. Brings new water to the site from the configured source — seawater, surface water, groundwater or a third-party supply — treats it where required, disposes of any treatment residue, and conveys it to site storage. "Makeup", "fresh" and "desalinated" water are different concepts; the source type is configuration.
ISA-95 level: 0–2
Actors: Water Operator; DCS / SCADA
Standard alignment: ISA-95 Levels 0–2; MCA WAF
DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_6_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_6_5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_3_6_3_6_2" name="3.6.2 Reclaim Water">
      <bpmn:documentation>L0/L1/L2 Process. Recovers water from the TSF pond and delivers it to its users — process water storage, the classification station, or other site uses.
ISA-95 level: 0–2
Actors: DCS / SCADA; Tailings Operator
Standard alignment: ISA-95 Levels 0–2; MCA WAF
DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_6_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_6_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_3_6_3_6_3" name="3.6.3 Seepage &amp; Drainage Collection">
      <bpmn:documentation>L0/L1/L2 Process. Collects water that seeps through tailings, the embankment or its foundation, and drainage from placed construction material, in drains, sumps and ponds, and pumps it to its configured destination — the impoundment, reclaim, a classification station, or treatment and discharge. Drainage of freshly placed sand is distinct from seepage.
ISA-95 level: 0–2
Actors: Tailings Operator; DCS / SCADA; Environmental Officer
Standard alignment: ISA-95 Levels 0–2; GISTM; MCA WAF
DDVC layer: Raw (time-series: pond_level_telemetry, water_flow_telemetry)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_6_4</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_6_7</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:parallelGateway id="Par_L2_3_6_j">
      <bpmn:incoming>Flow_L2_3_6_5</bpmn:incoming>
      <bpmn:incoming>Flow_L2_3_6_6</bpmn:incoming>
      <bpmn:incoming>Flow_L2_3_6_7</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_6_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Sub_L2_3_6_3_6_4" name="3.6.4 Process Water Supply &amp; Distribution">
      <bpmn:documentation>L1/L2 Process. Blends recovered water (thickener overflow, filtrate), reclaim water, recovered seepage and makeup water in process water storage and distributes process water to plant users — grinding, flotation, reagent make-up, wash and gland water.
ISA-95 level: 1–2
Actors: DCS Auto-control; Control Room Operator
Standard alignment: ISA-95 Levels 1, 2; MCA WAF
DDVC layer: Raw (time-series: water_flow_telemetry)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_6_8</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_6_9</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_3_6_3_6_5" name="3.6.5 Site Water Balance &amp; Reconciliation">
      <bpmn:documentation>L3 Process. Brings the water flow and volume records from 3.3, 3.5 and 3.6 together for each reporting period, applies the water-system boundaries and allocation rules, and closes the site water balance. Composite figures (e.g., total plant water use) must count each volume once. Metric definitions and formulas belong in Stage 2.
ISA-95 level: 3–4
Actors: Water Balance Analyst; Environmental Officer; Water Operator
Standard alignment: MCA Water Accounting Framework; ICMM water reporting guidance; ISA-95 Levels 3, 4
DDVC layer: Curated (water_transfer_record, water_balance_record)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_3_6_9</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_3_6_10</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_L2_3_6_e" name="Period water balance published">
      <bpmn:incoming>Flow_L2_3_6_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L2_3_6_1" sourceRef="Start_L2_3_6_s" targetRef="Par_L2_3_6_f"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_2" sourceRef="Par_L2_3_6_f" targetRef="Sub_L2_3_6_3_6_1"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_3" sourceRef="Par_L2_3_6_f" targetRef="Sub_L2_3_6_3_6_2"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_4" sourceRef="Par_L2_3_6_f" targetRef="Sub_L2_3_6_3_6_3"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_5" sourceRef="Sub_L2_3_6_3_6_1" targetRef="Par_L2_3_6_j"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_6" sourceRef="Sub_L2_3_6_3_6_2" targetRef="Par_L2_3_6_j"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_7" sourceRef="Sub_L2_3_6_3_6_3" targetRef="Par_L2_3_6_j"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_8" sourceRef="Par_L2_3_6_j" targetRef="Sub_L2_3_6_3_6_4"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_9" sourceRef="Sub_L2_3_6_3_6_4" targetRef="Sub_L2_3_6_3_6_5"/>
    <bpmn:sequenceFlow id="Flow_L2_3_6_10" sourceRef="Sub_L2_3_6_3_6_5" targetRef="End_L2_3_6_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L2_3_6">
    <bpmndi:BPMNPlane id="Plane_L2_3_6" bpmnElement="Collab_L2_3_6">
      <bpmndi:BPMNShape id="Pool_L2_3_6_di" bpmnElement="Pool_L2_3_6" isHorizontal="true"><dc:Bounds x="20" y="20" width="1376" height="680"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_3_6_wat_di" bpmnElement="Lane_L2_3_6_wat" isHorizontal="true"><dc:Bounds x="60" y="20" width="1336" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_3_6_tail_di" bpmnElement="Lane_L2_3_6_tail" isHorizontal="true"><dc:Bounds x="60" y="190" width="1336" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_3_6_rep_di" bpmnElement="Lane_L2_3_6_rep" isHorizontal="true"><dc:Bounds x="60" y="530" width="1336" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L2_3_6_s_di" bpmnElement="Start_L2_3_6_s"><dc:Bounds x="142" y="247" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="110" y="309" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Par_L2_3_6_f_di" bpmnElement="Par_L2_3_6_f"><dc:Bounds x="301" y="240" width="70" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_6_3_6_1_di" bpmnElement="Sub_L2_3_6_3_6_1" isExpanded="false"><dc:Bounds x="442" y="57" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_6_3_6_2_di" bpmnElement="Sub_L2_3_6_3_6_2" isExpanded="false"><dc:Bounds x="442" y="227" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_6_3_6_3_di" bpmnElement="Sub_L2_3_6_3_6_3" isExpanded="false"><dc:Bounds x="442" y="397" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Par_L2_3_6_j_di" bpmnElement="Par_L2_3_6_j"><dc:Bounds x="683" y="240" width="70" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_6_3_6_4_di" bpmnElement="Sub_L2_3_6_3_6_4" isExpanded="false"><dc:Bounds x="824" y="57" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_3_6_3_6_5_di" bpmnElement="Sub_L2_3_6_3_6_5" isExpanded="false"><dc:Bounds x="1030" y="567" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L2_3_6_e_di" bpmnElement="End_L2_3_6_e"><dc:Bounds x="1268" y="587" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="1236" y="649" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_1_di" bpmnElement="Flow_L2_3_6_1"><di:waypoint x="198" y="275"/><di:waypoint x="301" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_2_di" bpmnElement="Flow_L2_3_6_2"><di:waypoint x="336" y="240"/><di:waypoint x="336" y="105"/><di:waypoint x="442" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_3_di" bpmnElement="Flow_L2_3_6_3"><di:waypoint x="371" y="275"/><di:waypoint x="442" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_4_di" bpmnElement="Flow_L2_3_6_4"><di:waypoint x="336" y="310"/><di:waypoint x="336" y="445"/><di:waypoint x="442" y="445"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_5_di" bpmnElement="Flow_L2_3_6_5"><di:waypoint x="612" y="105"/><di:waypoint x="718" y="105"/><di:waypoint x="718" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_6_di" bpmnElement="Flow_L2_3_6_6"><di:waypoint x="612" y="275"/><di:waypoint x="683" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_7_di" bpmnElement="Flow_L2_3_6_7"><di:waypoint x="612" y="445"/><di:waypoint x="718" y="445"/><di:waypoint x="718" y="310"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_8_di" bpmnElement="Flow_L2_3_6_8"><di:waypoint x="753" y="275"/><di:waypoint x="806" y="275"/><di:waypoint x="806" y="105"/><di:waypoint x="824" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_9_di" bpmnElement="Flow_L2_3_6_9"><di:waypoint x="994" y="105"/><di:waypoint x="1012" y="105"/><di:waypoint x="1012" y="615"/><di:waypoint x="1030" y="615"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_3_6_10_di" bpmnElement="Flow_L2_3_6_10"><di:waypoint x="1200" y="615"/><di:waypoint x="1268" y="615"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
