      <bpmndi:BPMNShape id="Lane_L3_3_1_3_met_di" bpmnElement="Lane_L3_3_1_3_met" isHorizontal="true"><dc:Bounds x="60" y="360" width="1288" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_3_1_3_s_di" bpmnElement="Start_L3_3_1_3_s"><dc:Bounds x="110" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="139" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Service_L3_3_1_3_3_1_3_1_di" bpmnElement="Service_L3_3_1_3_3_1_3_1"><dc:Bounds x="202" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L3_3_1_3_g1_di" bpmnElement="Gw_L3_3_1_3_g1" isMarkerVisible="true"><dc:Bounds x="458" y="70" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="443" y="36" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_1_3_n1_di" bpmnElement="Task_L3_3_1_3_n1"><dc:Bounds x="408" y="235" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Service_L3_3_1_3_3_1_3_2_di" bpmnElement="Service_L3_3_1_3_3_1_3_2"><dc:Bounds x="614" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Service_L3_3_1_3_3_1_3_3_di" bpmnElement="Service_L3_3_1_3_3_1_3_3"><dc:Bounds x="820" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L3_3_1_3_g2_di" bpmnElement="Gw_L3_3_1_3_g2" isMarkerVisible="true"><dc:Bounds x="1076" y="70" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="1061" y="22" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_3_1_3_e_di" bpmnElement="End_L3_3_1_3_e"><dc:Bounds x="1232" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="1210" y="139" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_1_3_n2_di" bpmnElement="Task_L3_3_1_3_n2"><dc:Bounds x="1026" y="405" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_3_1_3_s2_di" bpmnElement="Start_L3_3_1_3_s2"><dc:Bounds x="110" y="417" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="479" width="100" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_1_3_3_1_3_4_di" bpmnElement="Task_L3_3_1_3_3_1_3_4"><dc:Bounds x="202" y="405" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_3_1_3_e2_di" bpmnElement="End_L3_3_1_3_e2"><dc:Bounds x="465" y="417" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="443" y="479" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L3_3_1_3_1_di" bpmnElement="Flow_L3_3_1_3_1"><di:waypoint x="166" y="105"/><di:waypoint x="202" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_1_3_2_di" bpmnElement="Flow_L3_3_1_3_2"><di:waypoint x="372" y="105"/><di:waypoint x="458" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_1_3_3_di" bpmnElement="Flow_L3_3_1_3_3"><di:waypoint x="493" y="140"/><di:waypoint x="493" y="235"/><bpmndi:BPMNLabel><dc:Bounds x="499" y="144" width="27" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
