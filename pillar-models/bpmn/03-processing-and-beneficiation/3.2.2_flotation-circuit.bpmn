      <bpmndi:BPMNEdge id="Flow_L3_3_2_2_7_di" bpmnElement="Flow_L3_3_2_2_7"><di:waypoint x="1004" y="105"/><di:waypoint x="1090" y="105"/><bpmndi:BPMNLabel><dc:Bounds x="1008" y="85" width="21" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_2_2_8_di" bpmnElement="Flow_L3_3_2_2_8"><di:waypoint x="969" y="140"/><di:waypoint x="969" y="235"/><bpmndi:BPMNLabel><dc:Bounds x="975" y="144" width="27" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
