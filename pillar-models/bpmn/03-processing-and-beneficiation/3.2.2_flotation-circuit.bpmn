      <bpmndi:BPMNShape id="Gw_L3_3_2_2_g1_di" bpmnElement="Gw_L3_3_2_2_g1" isMarkerVisible="true"><dc:Bounds x="522" y="70" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="451" y="20" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_2_2_3_2_2_2_di" bpmnElement="Task_L3_3_2_2_3_2_2_2"><dc:Bounds x="678" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L3_3_2_2_g2_di" bpmnElement="Gw_L3_3_2_2_g2" isMarkerVisible="true"><dc:Bounds x="934" y="70" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="863" y="20" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Service_L3_3_2_2_3_2_2_3_di" bpmnElement="Service_L3_3_2_2_3_2_2_3"><dc:Bounds x="1090" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_2_2_3_2_2_4_di" bpmnElement="Task_L3_3_2_2_3_2_2_4"><dc:Bounds x="1296" y="65" width="170" height="80"/></bpmndi:BPMNShape>
