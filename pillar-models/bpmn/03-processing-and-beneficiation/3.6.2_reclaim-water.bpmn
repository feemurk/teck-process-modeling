<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L3_3_6_2" targetNamespace="https://teck.example/process-models/pillar-03">
  <bpmn:collaboration id="Collab_L3_3_6_2">
    <bpmn:participant id="Pool_L3_3_6_2" name="3.6.2 Reclaim Water" processRef="Process_L3_3_6_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L3_3_6_2" isExecutable="false">
    <bpmn:documentation>L0/L1/L2 Process. Recovers water from the TSF pond and delivers it to its users — process water storage, the classification station, or other site uses.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L3_3_6_2">
      <bpmn:lane id="Lane_L3_3_6_2_dcs" name="DCS / SCADA">
        <bpmn:flowNodeRef>Start_L3_3_6_2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_L3_3_6_2_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_3_6_2_3_6_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_3_6_2_3_6_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L3_3_6_2_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L3_3_6_2_tail" name="Tailings Operator">
        <bpmn:flowNodeRef>Task_L3_3_6_2_n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L3_3_6_2_e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L3_3_6_2_s" name="Reclaim water demand">
      <bpmn:outgoing>Flow_L3_3_6_2_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_L3_3_6_2_g" name="Pond above minimum intake level?" default="Flow_L3_3_6_2_2">
      <bpmn:incoming>Flow_L3_3_6_2_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_3_6_2_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_L3_3_6_2_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_L3_3_6_2_3_6_2_1" name="3.6.2.1 Reclaim Water from Pond">
      <bpmn:documentation>Barge or decant pumps lift water from the TSF pond; booster stations move it towards its users. Reclaim water quality (metals, pH, suspended solids) is sampled for process and environmental monitoring. [WATER: volume (reclaimed) | flow meter on reclaim line | continuous (1-min) | MCA WAF | NO — internal recycle; WP-07]
ISA-95 level: 1 / 2
Actors: DCS / SCADA; Tailings Operator
Standard alignment: ISA-95 Levels 1, 2; MCA WAF
DDVC layer: Raw (time-series: water_flow_telemetry)</bpmn:documentation>
      <bpmn:incoming>Flow_L3_3_6_2_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_3_6_2_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L3_3_6_2_3_6_2_2" name="3.6.2.2 Deliver Reclaim Water to Users">
      <bpmn:documentation>Reclaim water is delivered to process water storage and, where configured, to the classification station or other site uses. Each delivery is metered by user so that the same water is not counted twice in the water balance. [WATER: volume (delivered per user) | flow meter per user | continuous | MCA WAF | NO — internal recycle; WP-08]
ISA-95 level: 1 / 2
Actors: DCS / SCADA; Water Operator
Standard alignment: ISA-95 Levels 1, 2; MCA WAF
DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)</bpmn:documentation>
      <bpmn:incoming>Flow_L3_3_6_2_5</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_3_6_2_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_L3_3_6_2_e1" name="Reclaim water delivered to users">
      <bpmn:incoming>Flow_L3_3_6_2_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_L3_3_6_2_n" name="Stop reclaim pumping; alert tailings operations">
      <bpmn:documentation>Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Low pond response; industry convention; no L4 row.</bpmn:documentation>
      <bpmn:incoming>Flow_L3_3_6_2_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_3_6_2_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_L3_3_6_2_e2" name="Reclaim suspended">
      <bpmn:incoming>Flow_L3_3_6_2_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L3_3_6_2_1" sourceRef="Start_L3_3_6_2_s" targetRef="Gw_L3_3_6_2_g"/>
    <bpmn:sequenceFlow id="Flow_L3_3_6_2_2" name="Yes" sourceRef="Gw_L3_3_6_2_g" targetRef="Task_L3_3_6_2_3_6_2_1"/>
    <bpmn:sequenceFlow id="Flow_L3_3_6_2_3" name="No" sourceRef="Gw_L3_3_6_2_g" targetRef="Task_L3_3_6_2_n"/>
    <bpmn:sequenceFlow id="Flow_L3_3_6_2_4" sourceRef="Task_L3_3_6_2_n" targetRef="End_L3_3_6_2_e2"/>
    <bpmn:sequenceFlow id="Flow_L3_3_6_2_5" sourceRef="Task_L3_3_6_2_3_6_2_1" targetRef="Task_L3_3_6_2_3_6_2_2"/>
    <bpmn:sequenceFlow id="Flow_L3_3_6_2_6" sourceRef="Task_L3_3_6_2_3_6_2_2" targetRef="End_L3_3_6_2_e1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L3_3_6_2">
    <bpmndi:BPMNPlane id="Plane_L3_3_6_2" bpmnElement="Collab_L3_3_6_2">
      <bpmndi:BPMNShape id="Pool_L3_3_6_2_di" bpmnElement="Pool_L3_3_6_2" isHorizontal="true"><dc:Bounds x="20" y="20" width="1024" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_3_6_2_dcs_di" bpmnElement="Lane_L3_3_6_2_dcs" isHorizontal="true"><dc:Bounds x="60" y="20" width="984" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_3_6_2_tail_di" bpmnElement="Lane_L3_3_6_2_tail" isHorizontal="true"><dc:Bounds x="60" y="190" width="984" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_3_6_2_s_di" bpmnElement="Start_L3_3_6_2_s"><dc:Bounds x="142" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="110" y="139" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L3_3_6_2_g_di" bpmnElement="Gw_L3_3_6_2_g" isMarkerVisible="true"><dc:Bounds x="316" y="70" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="245" y="20" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_6_2_3_6_2_1_di" bpmnElement="Task_L3_3_6_2_3_6_2_1"><dc:Bounds x="472" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_6_2_3_6_2_2_di" bpmnElement="Task_L3_3_6_2_3_6_2_2"><dc:Bounds x="678" y="65" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_3_6_2_e1_di" bpmnElement="End_L3_3_6_2_e1"><dc:Bounds x="916" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="884" y="139" width="120" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_3_6_2_n_di" bpmnElement="Task_L3_3_6_2_n"><dc:Bounds x="266" y="235" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_3_6_2_e2_di" bpmnElement="End_L3_3_6_2_e2"><dc:Bounds x="529" y="247" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="497" y="309" width="120" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L3_3_6_2_1_di" bpmnElement="Flow_L3_3_6_2_1"><di:waypoint x="198" y="105"/><di:waypoint x="316" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_6_2_2_di" bpmnElement="Flow_L3_3_6_2_2"><di:waypoint x="386" y="105"/><di:waypoint x="472" y="105"/><bpmndi:BPMNLabel><dc:Bounds x="390" y="85" width="27" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_6_2_3_di" bpmnElement="Flow_L3_3_6_2_3"><di:waypoint x="351" y="140"/><di:waypoint x="351" y="235"/><bpmndi:BPMNLabel><dc:Bounds x="357" y="144" width="21" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_6_2_4_di" bpmnElement="Flow_L3_3_6_2_4"><di:waypoint x="436" y="275"/><di:waypoint x="529" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_6_2_5_di" bpmnElement="Flow_L3_3_6_2_5"><di:waypoint x="642" y="105"/><di:waypoint x="678" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_3_6_2_6_di" bpmnElement="Flow_L3_3_6_2_6"><di:waypoint x="848" y="105"/><di:waypoint x="916" y="105"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
