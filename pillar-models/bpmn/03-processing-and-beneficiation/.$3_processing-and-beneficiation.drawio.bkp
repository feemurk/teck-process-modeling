<mxfile host="Electron" pages="29"><diagram id="3_processing-and-beneficiation" name="3_processing-and-beneficiation"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1466" pageHeight="910" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L1_3" value="3 Processing &amp; Beneficiation (L1)" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1406" height="850" as="geometry"/></mxCell><mxCell id="Lane_L1_3_acc" value="Chief Metallurgist / Metallurgical Accounting Analyst" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1366" height="340" as="geometry"/></mxCell><mxCell id="Lane_L1_3_ops" value="Control Room Operator / DCS Auto-control / Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1366" height="170" as="geometry"/></mxCell><mxCell id="Lane_L1_3_tw" value="Tailings &amp; Water Operations" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="1366" height="340" as="geometry"/></mxCell><mxCell id="Flow_L1_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L1_3_s" target="Sub_L1_3_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L1_3_3_1" target="Sub_L1_3_3_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L1_3_3_2" target="Sub_L1_3_3_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L1_3_3_3" target="Par_L1_3_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L1_3_f" target="End_L1_3_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L1_3_f" target="Sub_L1_3_3_5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="954" y="615"/></Array></mxGeometry></mxCell><mxCell id="Flow_L1_3_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L1_3_3_5" target="End_L1_3_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L1_3_s2" target="Sub_L1_3_3_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L1_3_3_6" target="End_L1_3_e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L1_3_s3" target="Sub_L1_3_3_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L1_3_11" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L1_3_3_4" target="End_L1_3_e4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="557" y="105"/></Array></mxGeometry></mxCell><mxCell id="Assoc_L1_3_12" value="" style="edgeStyle=none;html=0;rounded=0;dashed=1;dashPattern=1 3;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=0;" edge="1" parent="1" source="Sub_L1_3_3_2" target="Sub_L1_3_3_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Assoc_L1_3_13" value="" style="edgeStyle=none;html=0;rounded=0;dashed=1;dashPattern=1 3;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=0;" edge="1" parent="1" source="Sub_L1_3_3_3" target="Sub_L1_3_3_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="763" y="275"/></Array></mxGeometry></mxCell><mxCell id="Assoc_L1_3_14" value="" style="edgeStyle=none;html=0;rounded=0;dashed=1;dashPattern=1 3;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=0;" edge="1" parent="1" source="Sub_L1_3_3_5" target="Sub_L1_3_3_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="End_L1_3_e4" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1117" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L1_3_e4__lbl" value="Monthly metal accounting report filed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1085" y="139" width="120" height="42" as="geometry"/></mxCell><mxCell id="Start_L1_3_s3" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L1_3_s3__lbl" value="Shift start" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="309" width="120" height="14" as="geometry"/></mxCell><object id="Sub_L1_3_3_4" label="3.4 Metallurgical Accounting &amp; Quality" tooltip="L2/L3 Process Area. Systematic collection of representative samples, chemical analysis, and mass balance closure across the plant. Metallurgical accounting is the mechanism by which all mass flows, grades, and recoveries are reconciled to verify and report plant performance. This process area is governed end-to-end by AMIRA P754 and all 10 of its principles apply within it.&#xa;ISA-95 level: 2–3&#xa;Actors: Chief Metallurgist; Metallurgist; Plant Chemist; Metallurgical Accounting Analyst&#xa;Standard alignment: AMIRA P754 (all 10 principles); ISA-95 Levels 2, 3&#xa;DDVC layer: Raw; Curated (shift_mass_balance, metallurgical_accounting_report)" link="data:page/id,3.4_metallurgical-accounting-and-quality"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="472" y="227" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L1_3_3_4__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="550" y="303" width="14" height="14" as="geometry"/></mxCell><mxCell id="Start_L1_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L1_3_s__lbl" value="ROM ore at crusher (CTP-1)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="479" width="120" height="28" as="geometry"/></mxCell><object id="Sub_L1_3_3_1" label="3.1 Comminution" tooltip="L2 Process Area. Progressive size reduction of ROM ore from run-of-mine fragmentation (typically P80 150–250 mm) to a target grind size suitable for flotation (P80 75–150 µm depending on ore and circuit). Encompasses primary crushing, secondary/tertiary crushing and screening where applicable, SAG and ball milling, and hydrocyclone classification.&#xa;ISA-95 level: 0–3&#xa;Actors: Plant Metallurgist; Control Room Operator; DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0–3; AMIRA P754 Principles 1, 2, 5&#xa;DDVC layer: Raw (time-series); Curated (process_node, equipment_operating_record)" link="data:page/id,3.1_comminution"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="266" y="397" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L1_3_3_1__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="344" y="473" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L1_3_3_2" label="3.2 Concentration (Flotation)" tooltip="L2 Process Area. Selective separation of valuable sulphide minerals (e.g., chalcopyrite, sphalerite, galena, molybdenite) from gangue using froth flotation. Air bubbles attach to mineral surfaces made hydrophobic by reagents; the loaded froth overflows as concentrate while depressed minerals report to tailings. This is the primary value-creation process in the plant — metal recovery and concentrate grade are the defining performance variables. The area combines two patterns: one or more Flotation Circuits (3.2.2), in sequence (each fed by the previous circuit's tailings) or in parallel on split feeds, and an optional Concentrate Separation (3.2.3) of a bulk concentrate. Each circuit's concentrate is saleable, a bulk concentrate for separation, or a waste concentrate (e.g., pyrite removed to make low-sulphur tailings). The circuit set, order, destinations and reagent scheme are configuration, not separate processes, and may change by ore-type campaign.&#xa;ISA-95 level: 0–3&#xa;Actors: Control Room Operator; Metallurgist; DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0–3; AMIRA P754 Principles 1, 2, 5, 6, 7&#xa;DDVC layer: Raw (time-series); Curated (concentrate_production_record, process_measurement_point)" link="data:page/id,3.2_concentration-flotation"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="472" y="397" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L1_3_3_2__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="550" y="473" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L1_3_3_3" label="3.3 Dewatering &amp; Product Handling" tooltip="L2 Process Area. Removes water from flotation products. Saleable concentrates are thickened, filtered to the commercial moisture specification (typically 8–12% for copper and 6–10% for zinc or lead concentrate, by contract) and, where specified, dried and packed. The final tailings are thickened to the density the deposition method needs and handed to Tailings Management (3.5). Water recovered by thickening and filtration is handed to Water Management (3.6).&#xa;ISA-95 level: 0–2&#xa;Actors: Control Room Operator; DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 5, 7&#xa;DDVC layer: Raw (time-series); Curated (concentrate_production_record, process_measurement_point)" link="data:page/id,3.3_dewatering-and-product-handling"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="678" y="397" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L1_3_3_3__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="756" y="473" width="14" height="14" as="geometry"/></mxCell><mxCell id="Par_L1_3_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="919" y="410" width="70" height="70" as="geometry"/></mxCell><mxCell id="End_L1_3_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1117" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L1_3_e1__lbl" value="Concentrate to storage (CTP-2)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1085" y="479" width="120" height="28" as="geometry"/></mxCell><object id="Sub_L1_3_3_5" label="3.5 Tailings Management" tooltip="L2 Process Area. Transports thickened tailings from the plant to the Tailings Storage Facility (TSF), classifies them into sand and fines where the embankment is built with tailings sand, deposits tailings in the impoundment, builds and raises the embankment, and monitors storage and safety margins. The TSF is the final sink of the plant mass balance and the main store of reclaim water (3.6.2). A TSF receives material for the whole mine life, so its inventory, water and geometry change continuously.&#xa;ISA-95 level: 0–3&#xa;Actors: Tailings Operator; Control Room Operator; Construction Supervisor / Surveyor; Tailings Facility Engineer&#xa;Standard alignment: GISTM (2020); ICMM tailings governance; ISA-95 Levels 0–3; AMIRA P754 Principles 1, 5, 7&#xa;DDVC layer: Raw (time-series); Curated (tailings_deposition_record, construction_placement_record, facility_survey_record, tsf_inventory_record)" link="data:page/id,3.5_tailings-management"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1060" y="567" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L1_3_3_5__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1138" y="643" width="14" height="14" as="geometry"/></mxCell><mxCell id="End_L1_3_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1298" y="587" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L1_3_e2__lbl" value="Tailings stored in TSF" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1266" y="649" width="120" height="28" as="geometry"/></mxCell><mxCell id="Start_L1_3_s2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="926" y="757" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L1_3_s2__lbl" value="Site water demand" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="894" y="819" width="120" height="14" as="geometry"/></mxCell><object id="Sub_L1_3_3_6" label="3.6 Water Management" tooltip="L2 Process Area. Supplies, recovers, distributes and accounts for the water the plant and the tailings facility use. Water enters as makeup water from a configured source, treated where required; it is recovered by thickening and filtration (3.3), reclaimed from the TSF pond and recovered from seepage and drainage; it is blended into process water and distributed to users; and it is accounted for in a periodic site water balance that counts each volume once.&#xa;ISA-95 level: 1–4&#xa;Actors: Water Operator; Control Room Operator; Tailings Operator; Environmental Officer; Water Balance Analyst&#xa;Standard alignment: MCA Water Accounting Framework; ICMM water reporting guidance; ISA-95 Levels 1–4&#xa;DDVC layer: Raw (time-series: water_flow_telemetry, pond_level_telemetry); Curated (water_transfer_record, water_balance_record)" link="data:page/id,3.6_water-management"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1060" y="737" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L1_3_3_6__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1138" y="813" width="14" height="14" as="geometry"/></mxCell><mxCell id="End_L1_3_e3" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1298" y="757" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L1_3_e3__lbl" value="Period water balance published" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1266" y="819" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.1_comminution" name="3.1_comminution"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1082" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L2_3_1" value="3.1 Comminution (L2)" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1022" height="340" as="geometry"/></mxCell><mxCell id="Lane_L2_3_1_dcs" value="Control Room Operator / DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="982" height="340" as="geometry"/></mxCell><mxCell id="Flow_L2_3_1_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L2_3_1_s" target="Sub_L2_3_1_3_1_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_1_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_1_3_1_1" target="Gw_L2_3_1_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_1_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_1_g" target="Sub_L2_3_1_3_1_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="443" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_1_3__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="449" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_1_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_1_g" target="Sub_L2_3_1_3_1_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_1_4__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="482" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_1_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_1_3_1_2" target="Sub_L2_3_1_3_1_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_1_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_1_3_1_3" target="End_L2_3_1_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L2_3_1_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L2_3_1_s__lbl" value="ROM ore at crusher; plant in Run state" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="56" as="geometry"/></mxCell><object id="Sub_L2_3_1_3_1_1" label="3.1.1 Primary Crushing" tooltip="L0/L1/L2 Process. Jaw or gyratory crusher reduces ROM ore from truck-tipped fragmentation (typically P80 150–350 mm) to a product suitable for conveying and secondary crushing or direct SAG mill feed (P80 80–150 mm). The primary crusher is the first fixed measurement point in the process.&#xa;ISA-95 level: 0–2&#xa;Actors: Control Room Operator; DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 5&#xa;DDVC layer: Raw (time-series); Curated (process_measurement_point)" link="data:page/id,3.1.1_primary-crushing"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="202" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_1_3_1_1__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="Gw_L2_3_1_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="408" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L2_3_1_g__lbl" value="Secondary crushing fitted?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="393" y="22" width="100" height="42" as="geometry"/></mxCell><object id="Sub_L2_3_1_3_1_2" label="3.1.2 Secondary/Tertiary Crushing &amp; Screening" tooltip="L0/L2 Process. Not all circuits include secondary/tertiary crushing. Where present (typically in three-stage crushing circuits preceding ball mills, or as pebble crushers in SABC circuits), screens classify crushed product and recirculate oversize. This sub-process is conditional — it applies where a dedicated crushing circuit precedes ball milling. [Configuration: SABC circuits use pebble crushing (3.1.2.3); three-stage crushing circuits use 3.1.2.1 and 3.1.2.2 before ball milling.]&#xa;ISA-95 level: 0–2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principle 1&#xa;DDVC layer: Raw (time-series)" link="data:page/id,3.1.2_secondary-tertiary-crushing-and-screening"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="514" y="227" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_1_3_1_2__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="592" y="303" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_1_3_1_3" label="3.1.3 Grinding &amp; Classification" tooltip="L0/L1/L2 Process. SAG and ball mills reduce ore to the target grind size (P80 75–150 µm) in a wet grinding circuit with water addition and steel grinding media. Hydrocyclone clusters classify ground slurry — underflow (coarse) is recycled to the ball mill, overflow (fine) advances to flotation as the mill circuit product. The mill circuit product P80 is the key quality handoff from Comminution to Flotation.&#xa;ISA-95 level: 0–2&#xa;Actors: Control Room Operator; DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 2&#xa;DDVC layer: Raw (time-series: mill_telemetry); Curated (process_measurement_point — cyclone_overflow_grade)" link="data:page/id,3.1.3_grinding-and-classification"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="720" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_1_3_1_3__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="798" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="End_L2_3_1_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="926" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_1_e__lbl" value="Cyclone overflow at target P80" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="904" y="139" width="100" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.1.1_primary-crushing" name="3.1.1_primary-crushing"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1494" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_1_1" value="3.1.1 Primary Crushing" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1434" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_1_1_cro" value="Control Room Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1394" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_1_1_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1394" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_1_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_1_1_s" target="Task_L3_3_1_1_3_1_1_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_1_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_1_1_3_1_1_1" target="Service_L3_3_1_1_3_1_1_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="105"/><mxPoint x="390" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_1_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_1_3_1_1_2" target="Service_L3_3_1_1_3_1_1_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_1_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_1_3_1_1_3" target="Task_L3_3_1_1_3_1_1_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="802" y="275"/><mxPoint x="802" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_1_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_1_1_3_1_1_4" target="Gw_L3_3_1_1_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_1_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_1_g" target="Task_L3_3_1_1_n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1061" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_1_6__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1067" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_1_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_1_g" target="End_L3_3_1_1_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_1_7__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1100" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_1_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_1_1_n1" target="End_L3_3_1_1_e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1366" y="275"/></Array></mxGeometry></mxCell><mxCell id="Start_L3_3_1_1_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_1_1_s__lbl" value="Haul truck tip event; plant in Run state" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="56" as="geometry"/></mxCell><object id="Task_L3_3_1_1_3_1_1_1" label="3.1.1.1 Receive ROM Feed at Crusher" tooltip="Haul trucks tip ROM ore into the primary crusher dump pocket. Tip event is recorded by the crusher management system or FMS when a truck dumps (GPS + crusher proximity sensor). Belt weigh feeder on the apron/pan feeder below the dump pocket measures ore feed rate continuously. This measurement point is the opening of the plant-side mass balance and the internal mine-to-mill custody transfer. [P754: mass | belt weigh feeder / apron feeder scale | continuous (1-min integration) | Principles 1, 5 | YES — internal custody transfer: Mine Operations to Processing]&#xa;ISA-95 level: 1 / 3&#xa;Actors: Control Room Operator; Automated DCS&#xa;Standard alignment: ISA-95 Levels 1, 3; AMIRA P754 Principles 1, 5 (mass measurement; custody transfer)&#xa;DDVC layer: Raw; Curated (process_measurement_point — crusher_feed_mass_rate)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="202" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Service_L3_3_1_1_3_1_1_2" label="3.1.1.2 Execute Primary Crushing" tooltip="Gyratory or jaw crusher (depending on site) reduces ROM ore to the target top size. DCS monitors and controls closed-side setting (CSS) to achieve the target product size. Crusher power draw (kW), throughput (t/hr from apron feeder), vibration, and hydraulic pressure are logged at 1-minute intervals to PI Historian. Tramp metal detection upstream protects crusher internals.&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principle 2 (consistent, transparent system — crusher settings documented)&#xa;DDVC layer: Raw (time-series: primary_crusher_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="408" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Service_L3_3_1_1_3_1_1_3" label="3.1.1.3 Transport via Discharge Conveyor" tooltip="Crushed ore discharges from the crusher onto the main discharge conveyor belt to the coarse ore stockpile (COS) or directly to the SAG mill feed bin. A belt weigher on the discharge conveyor provides a secondary mass measurement (cross-checked against apron feeder). Belt speed, loading, and mass rate are logged continuously. [P754: mass | belt weigher (conveyor) | continuous (1-min integration) | Principles 1, 2, 7 | NO — internal process measurement, not a custody transfer point]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 2, 7&#xa;DDVC layer: Raw (time-series)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="614" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_1_1_3_1_1_4" label="3.1.1.4 Manage Coarse Ore Stockpile" tooltip="COS acts as a buffer between the discontinuous primary crusher (batch-fed by haul trucks) and the continuous SAG mill circuit. Stockpile level is monitored by level sensor or periodic survey. Reclaim feeders pull ore from the COS base onto the SAG mill feed conveyor at a controlled rate. COS inventory (mass) is estimated from level sensor volume plus density assumption; this is a known P754 measurement accuracy limitation. [P754: mass (inventory estimate) | level sensor + density assumption | continuous level / periodic survey | Principles 1, 7, 8 | NO — internal process buffer; not a custody transfer point]&#xa;ISA-95 level: 2 / 3&#xa;Actors: Control Room Operator; DCS&#xa;Standard alignment: ISA-95 Levels 2, 3; AMIRA P754 Principles 1, 7, 8&#xa;DDVC layer: Raw; Curated (process_inventory_node)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_1_1_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1026" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_1_1_g__lbl" value="COS level below minimum?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1011" y="22" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_1_1_n1" label="Throttle SAG mill feed rate and alert control room" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). DCS auto-throttle when COS level is below minimum."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1132" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_1_1_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1338" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_1_1_e__lbl" value="Crushed ore at COS or SAG feed bin" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1316" y="29" width="100" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.1.2_secondary-tertiary-crushing-and-screening" name="3.1.2_secondary-tertiary-crushing-and-screening"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="770" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_1_2" value="3.1.2 Secondary/Tertiary Crushing &amp; Screening" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="710" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_1_2_dcs" value="DCS Auto-control / Control Room Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="670" height="510" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_2_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_1_2_s" target="Service_L3_3_1_2_3_1_2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_2_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_2_3_1_2_1" target="Gw_L3_3_1_2_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_2_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_2_g" target="Service_L3_3_1_2_3_1_2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_2_3__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="499" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_2_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_2_g" target="End_L3_3_1_2_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_2_4__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="532" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_2_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_2_3_1_2_2" target="Service_L3_3_1_2_3_1_2_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="287" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_2_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_1_2_s2" target="Service_L3_3_1_2_3_1_2_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_2_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_2_3_1_2_3" target="End_L3_3_1_2_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_1_2_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_1_2_s__lbl" value="Crusher product at screen" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="42" as="geometry"/></mxCell><object id="Service_L3_3_1_2_3_1_2_1" label="3.1.2.1 Classify Ore by Screen" tooltip="Vibrating screen deck(s) classify crushed ore by particle size. Oversize material (&gt; screen aperture) is retained and recycled to crusher. Undersize passes through as the screened product. Screen efficiency (partition curve) and circulating load percentage are key process parameters. Screen deck vibration, throughput, and feed/product size are monitored.&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0, 2&#xa;DDVC layer: Raw"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="202" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_1_2_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="458" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_1_2_g__lbl" value="Oversize retained?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="443" y="36" width="100" height="28" as="geometry"/></mxCell><object id="Service_L3_3_1_2_3_1_2_2" label="3.1.2.2 Execute Secondary/Tertiary Crushing" tooltip="Cone or impact crusher reduces screen oversize to within specification. Multiple stages may be applied (secondary then tertiary). Crusher power, throughput, and gap setting are monitored continuously. [Configuration: in a three-stage circuit — primary jaw, secondary cone, tertiary cone — this precedes ball mill grinding where there is no SAG mill.]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0, 2&#xa;DDVC layer: Raw (time-series: secondary_crusher_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="408" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_1_2_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="614" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_1_2_e__lbl" value="Screened product forward" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="592" y="139" width="100" height="42" as="geometry"/></mxCell><mxCell id="Start_L3_3_1_2_s2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_1_2_s2__lbl" value="Pebbles above threshold at SAG discharge screen" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="479" width="100" height="84" as="geometry"/></mxCell><object id="Service_L3_3_1_2_3_1_2_3" label="3.1.2.3 Execute Pebble Crushing" tooltip="Pebble crusher handles the &quot;critical size&quot; fraction (typically 20–80 mm) generated by the SAG mill that is too large for efficient ball milling and too small to act as grinding media. Pebbles are diverted from the SAG discharge screen and fed to a cone crusher (pebble crusher); crushed product is returned to the SAG mill feed or ball mill feed. [Configuration: applies to SABC circuits, where pebble build-up is a key SAG throughput constraint; not applicable to three-stage crushing circuits without a SAG mill.]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0, 2&#xa;DDVC layer: Raw"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="202" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_1_2_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="465" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_1_2_e2__lbl" value="Pebbles returned to circuit" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="443" y="479" width="100" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.1.3_grinding-and-classification" name="3.1.3_grinding-and-classification"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1388" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_1_3" value="3.1.3 Grinding &amp; Classification" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1328" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_1_3_dcs" value="Control Room Operator / DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1288" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_1_3_met" value="Metallurgist / Plant Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1288" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_1_3_s" target="Service_L3_3_1_3_3_1_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_3_3_1_3_1" target="Gw_L3_3_1_3_g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_3_g1" target="Task_L3_3_1_3_n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_3__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="499" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_3_g1" target="Service_L3_3_1_3_3_1_3_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_4__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="532" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_1_3_n1" target="Service_L3_3_1_3_3_1_3_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="287" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_3_3_1_3_2" target="Service_L3_3_1_3_3_1_3_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_1_3_3_1_3_3" target="Gw_L3_3_1_3_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_3_g2" target="End_L3_3_1_3_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_8__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1150" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_3_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_1_3_g2" target="Task_L3_3_1_3_n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_9__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1117" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_1_3_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_1_3_n2" target="Service_L3_3_1_3_3_1_3_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_11" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_1_3_s2" target="Task_L3_3_1_3_3_1_3_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_1_3_12" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_1_3_3_1_3_4" target="End_L3_3_1_3_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_1_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_1_3_s__lbl" value="COS reclaim feeding SAG mill" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="42" as="geometry"/></mxCell><object id="Service_L3_3_1_3_3_1_3_1" label="3.1.3.1 Operate SAG Mill" tooltip="Semi-autogenous grinding (SAG) mill uses ore itself as the primary grinding medium, supplemented by a charge of steel balls (typically 10–15% v/v). DCS controls mill speed (% critical), bearing pressure (proxy for mill load/charge mass), water addition rate, and feed rate. SAG mill power draw is the primary throughput optimisation variable. Mill discharge passes through a discharge screen — pebbles are diverted to pebble crushing; undersize advances to the ball mill. [P754: mass flow (indirect — via feed belt weigher and water flow meter) | belt weigher + flow meter | continuous (1-min) | Principles 1, 2 | NO — internal process node]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 2&#xa;DDVC layer: Raw (time-series: sag_mill_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="202" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_1_3_g1" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="458" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_1_3_g1__lbl" value="Excess pebbles?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="443" y="36" width="100" height="28" as="geometry"/></mxCell><object id="Task_L3_3_1_3_n1" label="Divert pebbles to pebble crusher" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Pebble crushing is 3.1.2.3 (Cu sites only); crushed pebbles return to the SAG mill."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="408" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Service_L3_3_1_3_3_1_3_2" label="3.1.3.2 Operate Ball Mill" tooltip="Ball mill(s) receive SAG mill undersize discharge (or crushed ore from a three-stage crushing circuit) and grind to the target cyclone feed size using a steel ball charge. DCS controls ball mill speed, water addition, and feed rate. Ball mill power draw is monitored continuously. Sump level (cyclone feed sump) is controlled by variable-speed pump. [P754: mass flow (indirect — via cyclone feed density and flow meter) | nuclear density gauge + magnetic flow meter | continuous (1-min) | Principles 1, 2 | NO — internal process node]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 2&#xa;DDVC layer: Raw (time-series: ball_mill_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="614" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Service_L3_3_1_3_3_1_3_3" label="3.1.3.3 Classify Slurry by Hydrocyclone" tooltip="Hydrocyclone cluster(s) classify ball mill discharge slurry by particle size using centrifugal force. Cyclone overflow (fine fraction, P80 target met) advances to flotation conditioning as the mill circuit product — this is the Comminution-to-Flotation handoff. Cyclone underflow (coarse fraction) recirculates to the ball mill. Cyclone feed density and flow rate are monitored; overflow particle size is measured periodically (sieve analysis) or continuously (online PSA). [P754: grade (particle size proxy via density) | nuclear density gauge + periodic PSA | continuous density / periodic size | Principles 1, 2, 7 | NO — internal process classification node]&#xa;ISA-95 level: 2 / 1&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 2, 7&#xa;DDVC layer: Raw; Curated (process_measurement_point — mill_circuit_product_p80)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_1_3_g2" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1076" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_1_3_g2__lbl" value="Cyclone overflow P80 on target?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1061" y="22" width="100" height="42" as="geometry"/></mxCell><mxCell id="End_L3_3_1_3_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1232" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_1_3_e__lbl" value="Cyclone overflow to flotation" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1210" y="139" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_1_3_n2" label="Adjust cyclone apex, feed density or throughput" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition)."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1026" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Start_L3_3_1_3_s2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_1_3_s2__lbl" value="Ball addition interval reached" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="479" width="100" height="56" as="geometry"/></mxCell><object id="Task_L3_3_1_3_3_1_3_4" label="3.1.3.4 Manage Grinding Media Addition" tooltip="Steel grinding balls are added to the SAG and ball mills at a controlled rate (t/hr of balls per t/hr of ore processed) to maintain the target ball charge volume and composition. Grinding media consumption is tracked by ball addition count (ball counter or weigh hopper) and is a significant reagent cost input to the processing cost model. Ball addition events are recorded per mill per shift.&#xa;ISA-95 level: 3&#xa;Actors: Metallurgist; Plant Operator&#xa;Standard alignment: ISA-95 Level 3 (inventory management); AMIRA P754 Principle 1 (mass of grinding media is an input to mass balance)&#xa;DDVC layer: Raw; Curated (reagent_consumption_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="202" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_1_3_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="465" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_1_3_e2__lbl" value="Grinding media added" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="443" y="479" width="100" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.2_concentration-flotation" name="3.2_concentration-flotation"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1436" pageHeight="586" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L2_3_2" value="3.2 Concentration (Flotation) (L2)" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1376" height="510" as="geometry"/></mxCell><mxCell id="Lane_L2_3_2_ops" value="Control Room Operator / DCS Auto-control / Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1336" height="510" as="geometry"/></mxCell><mxCell id="Flow_L2_3_2_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L2_3_2_s" target="Sub_L2_3_2_3_2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_2_3_2_1" target="Sub_L2_3_2_3_2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_2_3_2_2" target="Par_L2_3_2_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_2_f" target="Gw_L2_3_2_g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_2_f" target="Gw_L2_3_2_g2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="748" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_2_g1" target="Sub_L2_3_2_3_2_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_6__lbl" value="Bulk" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="963" y="85" width="34" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_2_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_2_3_2_3" target="End_L2_3_2_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_2_g1" target="End_L2_3_2_e1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="924" y="40"/><mxPoint x="1296" y="40"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_8__lbl" value="Saleable" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="52" width="60" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_2_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_2_g1" target="End_L2_3_2_e3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="924" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_9__lbl" value="Waste" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="144" width="40" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_2_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_2_g2" target="Sub_L2_3_2_3_2_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="924" y="546"/><mxPoint x="351" y="546"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_10__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="484" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_2_11" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_2_g2" target="End_L2_3_2_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_2_11__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="963" y="425" width="21" height="14" as="geometry"/></mxCell><mxCell id="Start_L2_3_2_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L2_3_2_s__lbl" value="Cyclone overflow at flotation feed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Sub_L2_3_2_3_2_1" label="3.2.1 Reagent Management &amp; Pulp Conditioning" tooltip="L3/L0 Process. Chemical reagents are the primary selectivity control mechanism in flotation. Before each circuit, the pulp is conditioned so that only the circuit's target mineral floats: pH is set, activators make a naturally depressed target mineral floatable, depressants hold back non-target minerals, then collectors and frothers are dosed. Conditioning runs again for each circuit in a sequence and before a Concentrate Separation, because the target mineral changes. All reagent conditioning sits here; the other patterns refer to it.&#xa;ISA-95 level: 0–3&#xa;Actors: Metallurgist; Control Room Operator; DCS&#xa;Standard alignment: ISA-95 Levels 0–3; AMIRA P754 Principles 1, 2&#xa;DDVC layer: Raw; Curated (reagent_addition_record)" link="data:page/id,3.2.1_reagent-management-and-pulp-conditioning"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="266" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_2_3_2_1__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="344" y="133" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_2_3_2_2" label="3.2.2 Flotation Circuit" tooltip="L0/L1/L2 Process. Reusable pattern, run once per configured circuit (`flotation_circuit`). Recovers a target mineral — or several together as a bulk concentrate — from the circuit feed by rougher, scavenger and cleaner flotation, with optional regrinding before cleaning. The first circuit is fed by the mill circuit product; each later circuit in a sequence is fed by the scavenger tailings of the previous circuit, re-conditioned in 3.2.1. The final concentrate goes to dewatering (3.3) when it is a saleable product, to Concentrate Separation (3.2.3) when it is a bulk concentrate, or to tailings management (3.3.1 tailings duty, separate deposition) when it is a waste concentrate (e.g., pyrite). Scavenger tailings go to the next circuit or, from the last circuit, to final tailings. Instances may also run in parallel on split feeds (e.g., coarse and fine fractions), and the active set may change by ore-type campaign — both are configuration (`flotation_circuit.feed_source`, `operating_mode`). Example circuits: Cu (chalcopyrite, bornite); Zn (sphalerite, after CuSO₄ activation); Pb (galena); bulk Cu-Mo; bulk Cu-Pb.&#xa;ISA-95 level: 0–2&#xa;Actors: Control Room Operator; Metallurgist; DCS&#xa;Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 2, 5, 6, 7&#xa;DDVC layer: Raw (time-series); Curated (concentrate_production_record)" link="data:page/id,3.2.2_flotation-circuit"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="472" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_2_3_2_2__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="550" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="Par_L2_3_2_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="713" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L2_3_2_g1" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="889" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L2_3_2_g1__lbl" value="Concentrate destination?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="818" y="34" width="100" height="28" as="geometry"/></mxCell><object id="Sub_L2_3_2_3_2_3" label="3.2.3 Concentrate Separation" tooltip="L0/L1/L2 Process. Reusable pattern; conditional — runs only where a Flotation Circuit produces a bulk concentrate. Splits the bulk concentrate into two concentrates by differential flotation: one mineral is depressed and reports to the separation tailings (the sink product), the other is floated (the float product). Both products are saleable concentrates and go to their own dewatering trains (3.3). Examples: copper-molybdenum separation (molybdenite floated, copper minerals depressed — the copper concentrate is the sink product); copper-lead separation.&#xa;ISA-95 level: 0–2&#xa;Actors: Control Room Operator; Metallurgist; DCS&#xa;Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 2, 5, 6, 7&#xa;DDVC layer: Raw (time-series); Curated (concentrate_production_record)" link="data:page/id,3.2.3_concentrate-separation"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1030" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_2_3_2_3__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1108" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="End_L2_3_2_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1268" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_2_e1__lbl" value="Saleable concentrates to dewatering" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1236" y="139" width="120" height="42" as="geometry"/></mxCell><mxCell id="End_L2_3_2_e3" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1087" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_2_e3__lbl" value="Waste concentrate to tailings management" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1055" y="309" width="120" height="42" as="geometry"/></mxCell><mxCell id="Gw_L2_3_2_g2" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="889" y="410" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L2_3_2_g2__lbl" value="Another target mineral in tailings?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="818" y="360" width="100" height="42" as="geometry"/></mxCell><mxCell id="End_L2_3_2_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1087" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_2_e2__lbl" value="Final tailings to tailings management" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1055" y="479" width="120" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.2.1_reagent-management-and-pulp-conditioning" name="3.2.1_reagent-management-and-pulp-conditioning"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_2_1" value="3.2.1 Reagent Management &amp; Pulp Conditioning" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1230" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_2_1_chem" value="Plant Chemist / Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1190" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_2_1_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1190" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_1_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_2_1_s" target="Task_L3_3_2_1_3_2_1_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_1_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_1_3_2_1_1" target="Task_L3_3_2_1_3_2_1_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="454" y="105"/><mxPoint x="454" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_1_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_1_3_2_1_2" target="Gw_L3_3_2_1_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_1_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_1_g" target="Task_L3_3_2_1_3_2_1_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_1_4__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="802" y="255" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_1_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_1_g" target="Task_L3_3_2_1_3_2_1_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_1_5__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="769" y="314" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_1_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_1_3_2_1_3" target="Task_L3_3_2_1_3_2_1_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="969" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_1_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_1_3_2_1_4" target="End_L3_3_2_1_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_2_1_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_2_1_s__lbl" value="Circuit feed or reagent replenishment due" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_2_1_3_2_1_1" label="3.2.1.1 Manage Reagent Inventory and Preparation" tooltip="Reagents are received from suppliers in bulk tanks, drums, or bags, inventoried in the ERP, and prepared (diluted to working concentration where required) in the reagent mixing area. Reagent usage is tracked by tank level change (mass = volume × density) per shift. Reagent consumption is a key variable cost and a P754-relevant input to mass balance integrity checks. [P754: mass (reagent consumption) | tank level sensor + density measurement | shift-end reconciliation | Principle 1 (mass of reagent inputs to mass balance) | NO]&#xa;ISA-95 level: 3&#xa;Actors: Plant Chemist; Metallurgist&#xa;Standard alignment: ISA-95 Level 3; AMIRA P754 Principle 1&#xa;DDVC layer: Raw; Curated (reagent_consumption_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_2_1_3_2_1_2" label="3.2.1.2 Adjust Pulp pH" tooltip="A pH modifier (most often lime; sometimes soda ash or acid) is added to the grinding circuit or the circuit conditioning tank to reach the circuit's target pH. The setpoint depends on the target mineral and the minerals to be depressed: for example, high pH (10–11.5) depresses pyrite in a copper circuit, while a later zinc circuit may need a different pH after the copper concentrate is removed. DCS controls dosing pump speed from continuous inline pH measurement. [P754: mass (pH modifier) + grade (pH as process parameter) | slurry flow meter + inline pH sensor | continuous (1-min) | Principles 1, 2 | NO]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 2&#xa;DDVC layer: Raw (time-series: pH_telemetry, lime_dosing_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_2_1_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="728" y="240" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_2_1_g__lbl" value="Activation or depression required?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="657" y="190" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_2_1_3_2_1_3" label="3.2.1.3 Activate or Depress Minerals for Target Circuit" tooltip="Conditioning reagents are dosed so that only the circuit's target mineral floats. Activators make a naturally depressed mineral floatable — for example, copper sulphate (CuSO₄) activates sphalerite before a zinc circuit; under-dosing suppresses recovery and over-dosing can reactivate unwanted minerals. Depressants stop non-target minerals floating — for example, sodium cyanide or zinc sulphate depress sphalerite in a copper or lead circuit, sodium silicate depresses gangue, and sodium hydrosulphide depresses copper minerals in a copper-molybdenum separation. Conditional: applies only where the circuit's reagent scheme requires activation or depression. Dosage rates are controlled by DCS and logged continuously. [P754: mass (activator / depressant) | dosing pump flow meter | continuous (1-min) | Principle 1 | NO]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principle 1&#xa;DDVC layer: Raw (time-series: reagent_dosing_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="405" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_2_1_3_2_1_4" label="3.2.1.4 Dose Collector and Frother" tooltip="Dosing pumps inject collectors (e.g., xanthates, dithiophosphates) and frothers (e.g., MIBC, polyglycol frothers) into the circuit feed or individual banks at metered flow rates. Dosage rates are set by the metallurgist (g/t basis), controlled by DCS and logged continuously to PI Historian. Additional collector may be staged at the scavenger head. [P754: mass (reagent) | positive displacement dosing pump flow meter | continuous (1-min) | Principles 1, 2 | NO — internal reagent input]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 2&#xa;DDVC layer: Raw (time-series: reagent_dosing_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="884" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_2_1_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1122" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_2_1_e__lbl" value="Circuit feed conditioned" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1090" y="309" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.2.2_flotation-circuit" name="3.2.2_flotation-circuit"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1908" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_2_2" value="3.2.2 Flotation Circuit" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1848" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_2_2_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1808" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_2_2_met" value="Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1808" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_2_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_2_2_s" target="Task_L3_3_2_2_3_2_2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_2_3_2_2_1" target="Gw_L3_3_2_2_g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_2_g1" target="Task_L3_3_2_2_3_2_2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_3__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="596" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_2_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_2_g1" target="Task_L3_3_2_2_n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="563" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_2_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_2_n1" target="Task_L3_3_2_2_3_2_2_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="763" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_2_3_2_2_2" target="Gw_L3_3_2_2_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_2_g2" target="Service_L3_3_2_2_3_2_2_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_7__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1008" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_2_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_2_g2" target="Task_L3_3_2_2_n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_8__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="975" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_2_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_2_n2" target="Service_L3_3_2_2_3_2_2_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1175" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_2_2_3_2_2_3" target="Task_L3_3_2_2_3_2_2_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_11" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_2_3_2_2_4" target="Gw_L3_3_2_2_g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_12" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_2_g3" target="End_L3_3_2_2_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_12__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1626" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_2_13" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_2_g3" target="Task_L3_3_2_2_n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_2_13__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1593" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_2_14" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_2_n3" target="End_L3_3_2_2_e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1768" y="275"/></Array></mxGeometry></mxCell><mxCell id="Start_L3_3_2_2_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_2_2_s__lbl" value="Conditioned circuit feed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_2_2_3_2_2_1" label="3.2.2.1 Operate Rougher Flotation" tooltip="The rougher bank(s) process the full circuit feed and produce a rougher concentrate from the froth overflow. Maximum recovery is the primary objective of the rougher — grade is sacrificed for recovery. Each cell is equipped with a froth crowder or launder; air rate, froth depth, and impeller speed are controlled by DCS per cell. On-stream analysis (XRF) measures feed, concentrate, and tail grades of the target and penalty elements at 2–4 minute intervals. [P754: grade (target and key gangue elements) | on-stream XRF analyzer | continuous (2–4 min scan interval) | Principles 1, 2, 6, 7 | NO — internal process stream; MP-02 / MP-03 for this circuit]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 2, 6, 7&#xa;DDVC layer: Raw (time-series: flotation_cell_telemetry, osa_grade_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_2_2_g1" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="522" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_2_2_g1__lbl" value="Rougher tail grade above threshold?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="451" y="20" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_2_2_3_2_2_2" label="3.2.2.2 Operate Scavenger Flotation" tooltip="Scavenger bank(s) recover residual target mineral from the rougher tailings (and, in some circuit designs, from the cleaner tailings — a cleaner-scavenger). Scavenger concentrate is recycled to the rougher or to regrind. Scavenger tailings are the circuit tailings: they feed the next circuit in the sequence, or report to final tailings from the last circuit. The target-mineral grade in the scavenger tailings is the circuit's key recovery loss measurement. [P754: grade (target element in scavenger tailings — key loss measurement) | on-stream XRF + periodic grab sample | continuous OSA / shift composite | Principles 1, 2, 6, 7 | PARTIAL — the last circuit's scavenger tailings are the final loss stream (P754 Principle 7); MP-04 for this circuit]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 2, 6, 7&#xa;DDVC layer: Raw (time-series)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_2_2_g2" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="934" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_2_2_g2__lbl" value="Scavenger tail grade above limit?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="863" y="20" width="100" height="42" as="geometry"/></mxCell><object id="Service_L3_3_2_2_3_2_2_3" label="3.2.2.3 Operate Regrind Mill" tooltip="Where rougher or scavenger concentrate needs further liberation before cleaning, a regrind mill (stirred media mill, HIG mill, or ball mill) grinds it to a finer P80 (typically 20–40 µm). Conditional: depends on ore mineralogy and whether a regrind mill is installed in the circuit.&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0, 2&#xa;DDVC layer: Raw (time-series: regrind_mill_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_2_2_3_2_2_4" label="3.2.2.4 Operate Cleaner Flotation" tooltip="Cleaner bank(s) upgrade the (reground) rougher concentrate to the circuit's final concentrate grade. One to three cleaner stages are common (column cells are often used in final cleaning). Cleaner tails are recycled to the rougher, regrind or a cleaner-scavenger. The final cleaner concentrate is the circuit's product stream: a saleable concentrate (to dewatering, 3.3), a bulk concentrate (to separation, 3.2.3) or a waste concentrate (to tailings management, e.g., pyrite). Its grade and mass flow are the primary production measurement of the circuit; a shift composite sample is collected. [P754: grade (target and penalty elements; precious metals where payable) + mass flow | on-stream XRF + shift composite sample (lab assay) | continuous OSA + shift composite | Principles 1, 2, 5, 6, 7 | YES when the product is saleable (custody transfer to dewatering); NO for a bulk or waste concentrate — MP-05 for this circuit]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 2, 5, 6, 7&#xa;DDVC layer: Raw; Curated (concentrate_production_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1296" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_2_2_g3" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1552" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_2_2_g3__lbl" value="Concentrate grade below specification?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1481" y="20" width="100" height="42" as="geometry"/></mxCell><mxCell id="End_L3_3_2_2_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1740" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_2_2_e__lbl" value="Concentrate and tailings leave circuit" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1708" y="29" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_2_2_n1" label="Raise collector dose or cut air rate; log change" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). OSA-driven process change; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_2_2_n2" label="Investigate feed, reagent or OSA fault; escalate" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Scavenger tail exceedance response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="884" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_2_2_n3" label="Adjust froth depth or cleaning; log change" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Concentrate grade response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1502" y="235" width="170" height="80" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="3.2.3_concentrate-separation" name="3.2.3_concentrate-separation"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1672" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_2_3" value="3.2.3 Concentrate Separation" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1612" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_2_3_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1572" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_2_3_met" value="Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1572" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_2_3_s" target="Task_L3_3_2_3_3_2_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_3_3_2_3_1" target="Task_L3_3_2_3_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_3_c" target="Task_L3_3_2_3_3_2_3_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_3_3_2_3_2" target="Par_L3_3_2_3_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_2_3_f" target="Task_L3_3_2_3_3_2_3_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_2_3_f" target="End_L3_3_2_3_e2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="954" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_3_3_2_3_3" target="Gw_L3_3_2_3_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_3_g" target="End_L3_3_2_3_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_8__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1390" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_3_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_2_3_g" target="Task_L3_3_2_3_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_2_3_9__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1357" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_2_3_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_2_3_n" target="End_L3_3_2_3_e1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1532" y="445"/></Array></mxGeometry></mxCell><mxCell id="Start_L3_3_2_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_2_3_s__lbl" value="Bulk concentrate from flotation circuit" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_2_3_3_2_3_1" label="3.2.3.1 Prepare Bulk Concentrate for Separation" tooltip="The bulk concentrate is thickened (an instance of 3.3.1 Thickening) to raise pulp density, recover water and shed residual reagents from the bulk circuit. Some plants also regrind, heat, oxidise or apply a nitrogen atmosphere to reduce reagent consumption. The prepared pulp is then conditioned for the separation through 3.2.1 (for example, a copper depressant such as sodium hydrosulphide in a copper-molybdenum separation). [P754: mass flow + density (bulk concentrate) | flowmeter + density gauge | continuous (1-min) | Principles 1, 7 | NO — MP-08]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw (time-series: thickener_telemetry, reagent_dosing_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_2_3_c" label="Condition pulp for separation (3.2.1)" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Invokes the Reagent Management &amp; Pulp Conditioning pattern (3.2.1) for the separation, e.g. a copper depressant in a copper-molybdenum separation. All reagent conditioning sits in 3.2.1."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_2_3_3_2_3_2" label="3.2.3.2 Operate Separation Rougher Flotation" tooltip="The float mineral is floated from the conditioned bulk concentrate while the sink mineral is depressed. The separation rougher tailings are the sink product — a saleable concentrate that goes to its dewatering train. Float and sink grades are monitored by OSA or shift composite. [P754: grade (float and sink elements) + mass flow | on-stream XRF or shift composite + flow and density | continuous / shift | Principles 1, 2, 5, 6, 7 | YES for the sink product — MP-10]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 2, 5, 6, 7&#xa;DDVC layer: Raw (time-series: flotation_cell_telemetry); Curated (concentrate_production_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Par_L3_3_2_3_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="919" y="70" width="70" height="70" as="geometry"/></mxCell><object id="Task_L3_3_2_3_3_2_3_3" label="3.2.3.3 Operate Separation Cleaner Flotation" tooltip="The separation rougher concentrate is upgraded through several cleaner stages (often with regrind and column cells) to the float product specification. Cleaner tails recycle within the separation circuit. The final cleaner concentrate is the float product and goes to its dewatering train; a shift composite sample is collected. [P754: grade (float element and impurities) + mass flow | shift composite + flow and density | shift | Principles 1, 2, 5, 6, 7 | YES — float product to dewatering, MP-09]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 2, 5, 6, 7&#xa;DDVC layer: Raw; Curated (concentrate_production_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_2_3_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1316" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_2_3_g__lbl" value="Float product below spec?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="34" width="100" height="28" as="geometry"/></mxCell><mxCell id="End_L3_3_2_3_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1504" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_2_3_e1__lbl" value="Float concentrate to dewatering" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1472" y="43" width="120" height="28" as="geometry"/></mxCell><mxCell id="End_L3_3_2_3_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1117" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_2_3_e2__lbl" value="Sink concentrate to dewatering" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1085" y="309" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_2_3_n" label="Adjust depressant dose or cleaning; log change" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Separation product quality response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1266" y="405" width="170" height="80" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="3.3_dewatering-and-product-handling" name="3.3_dewatering-and-product-handling"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1612" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L2_3_3" value="3.3 Dewatering &amp; Product Handling (L2)" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1552" height="340" as="geometry"/></mxCell><mxCell id="Lane_L2_3_3_ops" value="DCS Auto-control / Control Room Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1512" height="340" as="geometry"/></mxCell><mxCell id="Flow_L2_3_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L2_3_3_s" target="Sub_L2_3_3_3_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_3_3_3_1" target="Gw_L2_3_3_g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_3_g1" target="Sub_L2_3_3_3_3_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_3__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="581" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_3_g1" target="End_L2_3_3_e2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="542" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="548" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_3_3_3_2" target="Gw_L2_3_3_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_3_g2" target="Sub_L2_3_3_3_3_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_6__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="963" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_3_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_3_g2" target="Gw_L2_3_3_m"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="924" y="40"/><mxPoint x="1306" y="40"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_7__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="52" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_3_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_3_3_3_3" target="Gw_L2_3_3_m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_3_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_3_m" target="End_L2_3_3_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L2_3_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L2_3_3_s__lbl" value="Concentrate or tailings stream available" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Sub_L2_3_3_3_3_1" label="3.3.1 Thickening" tooltip="L0/L1/L2 Process. Reusable pattern, run once per thickener duty: each saleable concentrate stream, a bulk concentrate before separation (3.2.3.1), and the final tailings. Thickeners settle and compact slurry by gravity sedimentation, aided by flocculant. The underflow goes to its configured destination — filter feed, a concentrate pipeline, separation, or tailings transport (3.5.1) — and the overflow is recovered process water. Target underflow density depends on the duty (typically 55–70% solids for concentrate; for tailings it is set by the deposition method).&#xa;ISA-95 level: 0–2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw (time-series: thickener_telemetry)" link="data:page/id,3.3.1_thickening"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="266" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_3_3_3_1__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="344" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="Gw_L2_3_3_g1" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="507" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L2_3_3_g1__lbl" value="Tailings stream?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="436" y="34" width="100" height="28" as="geometry"/></mxCell><object id="Sub_L2_3_3_3_3_2" label="3.3.2 Concentrate Filtration" tooltip="L0/L1/L2 Process. The filter (disc filter, pressure filter, or belt filter depending on site) removes the majority of remaining process water from the thickened concentrate slurry, producing a filter cake at the target moisture specification. Moisture content verification of the filter cake is mandatory — it is a commercial product specification and a P754 mass measurement requirement. Separate filters run per concentrate type. Filtrate and wash water are recovered (3.3.2.4).&#xa;ISA-95 level: 0–2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 5, 7, 8&#xa;DDVC layer: Raw; Curated (concentrate_production_record — moisture attribute)" link="data:page/id,3.3.2_concentrate-filtration"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="648" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_3_3_3_2__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="726" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="Gw_L2_3_3_g2" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="889" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L2_3_3_g2__lbl" value="Drying or packaging required?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="818" y="20" width="100" height="42" as="geometry"/></mxCell><object id="Sub_L2_3_3_3_3_3" label="3.3.3 Concentrate Drying &amp; Packaging" tooltip="L0/L1/L3 Process. Conditional — applies where the product specification or the dispatch method requires the filtered concentrate to be dried or packed: for example, molybdenum concentrate dried and bagged, or concentrate packed in bags or containers for shipment. Follows 3.3.2 in that concentrate's dewatering train. Bulk-shipped filter cake bypasses it.&#xa;ISA-95 level: 0–3&#xa;Actors: Plant Operator; Process Technician; DCS&#xa;Standard alignment: ISA-95 Levels 0–3; AMIRA P754 Principles 1, 5, 7, 8&#xa;DDVC layer: Raw; Curated (concentrate_production_record — packaged mass)" link="data:page/id,3.3.3_concentrate-drying-and-packaging"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1030" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_3_3_3_3__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1108" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="Gw_L2_3_3_m" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1271" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="End_L2_3_3_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1444" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_3_e1__lbl" value="Concentrate products handled" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1412" y="139" width="120" height="28" as="geometry"/></mxCell><mxCell id="End_L2_3_3_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="705" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_3_e2__lbl" value="Thickened tailings to 3.5" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="673" y="309" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.3.1_thickening" name="3.3.1_thickening"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1466" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_3_1" value="3.3.1 Thickening" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1406" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_3_1_ctl" value="Control Room Operator / Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1366" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_3_1_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1366" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_1_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_3_1_s" target="Service_L3_3_3_1_3_3_1_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_3_1_3_3_1_1" target="Task_L3_3_3_1_3_3_1_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_1_3_3_1_2" target="Par_L3_3_3_1_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_3_1_f" target="Gw_L3_3_3_1_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_3_1_f" target="Service_L3_3_3_1_3_3_1_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="748" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_1_g" target="Service_L3_3_3_1_3_3_1_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_6__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="978" y="255" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_1_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_1_g" target="Task_L3_3_3_1_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_7__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="945" y="222" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_1_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_1_n" target="Service_L3_3_3_1_3_3_1_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_3_1_3_3_1_3" target="End_L3_3_3_1_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_1_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_3_1_3_3_1_4" target="End_L3_3_3_1_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_3_1_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_3_1_s__lbl" value="Slurry at thickener feed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="309" width="120" height="28" as="geometry"/></mxCell><object id="Service_L3_3_3_1_3_3_1_1" label="3.3.1.1 Feed Slurry to Thickener" tooltip="Slurry for the thickener duty — a saleable concentrate, a bulk concentrate, or the final tailings — is pumped to the thickener feedwell. Feed rate (m³/hr and t solids/hr) is measured by magnetic flowmeter and nuclear density gauge on the feed line. For a concentrate duty this is the first fixed-instrument mass flow measurement of the product stream; for the tailings duty it is the tailings term of the plant mass balance. [P754: mass flow + density (solids t/hr) | magnetic flowmeter + nuclear density gauge | continuous (1-min) | Principles 1, 2, 7 | PARTIAL — first fixed mass flow of a concentrate stream; MP-06 for the tailings duty]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 2, 7&#xa;DDVC layer: Raw (time-series)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_3_1_3_3_1_2" label="3.3.1.2 Dose Flocculant" tooltip="Polymer flocculant is dosed into the thickener feedwell to accelerate particle settling and achieve target underflow density. Dosage rate (g/t of solids) is set by the metallurgist and controlled by DCS. Excessive dosing increases cost without benefit; under-dosing produces dilute underflow and dirty overflow. Flocculant consumption is tracked per shift (kg or g/t solids). [P754: mass (flocculant consumption) | dosing pump counter + tank level | shift total | Principle 1 | NO]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control; Metallurgist&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principle 1&#xa;DDVC layer: Raw"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Par_L3_3_3_1_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="713" y="240" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_3_1_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="904" y="240" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_3_1_g__lbl" value="Underflow density below minimum?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="833" y="190" width="100" height="42" as="geometry"/></mxCell><object id="Service_L3_3_3_1_3_3_1_3" label="3.3.1.3 Pump Thickener Underflow" tooltip="The underflow pump transfers thickened slurry from the thickener cone to its configured destination: the filter feed tank, a concentrate pipeline, separation conditioning (bulk concentrate), or tailings transport (3.5.1). Underflow density (nuclear density gauge) and flow rate (magnetic flowmeter) are monitored continuously; underflow density is the primary thickener control variable. [P754: mass flow + density (solids t/hr) | magnetic flowmeter + nuclear density gauge | continuous (1-min) | Principles 1, 7 | NO — internal transfer; TP-01 for the tailings duty]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw (time-series: thickener_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_3_1_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1298" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_3_1_e__lbl" value="Underflow to its destination" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1266" y="309" width="120" height="28" as="geometry"/></mxCell><object id="Service_L3_3_3_1_3_3_1_4" label="3.3.1.4 Recover Thickener Overflow Water" tooltip="Clarified overflow returns to process water storage (3.6.4). For the tailings duty this is usually the largest single water recovery in the plant. Overflow clarity (suspended solids) is monitored; dirty overflow signals poor flocculation and carries solids into process water. Recovered water is an internal recycle in the site water balance and must be counted once. [WATER: volume (overflow recovered) | magnetic flowmeter on overflow line | continuous (1-min) | MCA WAF | NO — internal recycle; WP-05]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA Water Accounting Framework&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="854" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_3_1_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1117" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_3_1_e2__lbl" value="Recovered water to process water (3.6.4)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1085" y="479" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_3_1_n" label="Reduce feed rate or increase flocculant" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Underflow density response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="854" y="65" width="170" height="80" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="3.3.2_concentrate-filtration" name="3.3.2_concentrate-filtration"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1466" pageHeight="926" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_3_2" value="3.3.2 Concentrate Filtration" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1406" height="850" as="geometry"/></mxCell><mxCell id="Lane_L3_3_3_2_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1366" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_3_2_opr" value="Plant Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1366" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_3_2_tch" value="Process Technician / Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="1366" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_2_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_3_2_s" target="Service_L3_3_3_2_3_3_2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_3_2_3_3_2_1" target="Par_L3_3_3_2_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_3_2_f" target="Service_L3_3_3_2_3_3_2_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="105"/><mxPoint x="630" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_3_2_3_3_2_4" target="End_L3_3_3_2_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_3_2_f" target="Task_L3_3_3_2_3_3_2_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="542" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_2_3_3_2_2" target="Task_L3_3_3_2_3_3_2_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="836" y="445"/><mxPoint x="836" y="615"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_2_3_3_2_3" target="Gw_L3_3_3_2_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_2_g" target="Task_L3_3_3_2_n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_8__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1151" y="562" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_2_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_2_g" target="Task_L3_3_3_2_n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_9__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1151" y="654" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_2_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_2_n1" target="Service_L3_3_3_2_3_3_2_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145" y="886"/><mxPoint x="351" y="886"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_2_11" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_2_n2" target="End_L3_3_3_2_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_3_2_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_3_2_s__lbl" value="Underflow in filter feed tank" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Service_L3_3_3_2_3_3_2_1" label="3.3.2.1 Operate Filter Press or Disc Filter" tooltip="The filter operates on a feed-press-blow-discharge cycle (pressure filter) or a continuous rotary vacuum cycle (disc filter). DCS monitors and controls filtration pressure (kPa), vacuum level, cycle time, and wash water volume. Filter throughput (solids t/hr per filter) and filtrate flow rate are logged. Filter performance is evaluated by filter cake solids content (%) and throughput rate.&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw (time-series: filter_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Par_L3_3_3_2_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="507" y="70" width="70" height="70" as="geometry"/></mxCell><object id="Service_L3_3_3_2_3_3_2_4" label="3.3.2.4 Recover Filtrate Water" tooltip="Filtrate and filter wash water pass to a filtrate tank or clarifier. Clarified water returns to process water storage, or — where filtration is remote from the concentrator (e.g., at a port after a slurry pipeline) — to that location's own water system; clarifier underflow returns to the filter feed. [WATER: volume (filtrate recovered) | flow meter | continuous (1-min) | MCA WAF | NO — internal recycle, or a separate water-system boundary where filtration is remote; WP-06]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA Water Accounting Framework&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="648" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_3_2_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="911" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_3_2_e2__lbl" value="Recovered water to process water (3.6.4)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="879" y="309" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_3_2_3_3_2_2" label="3.3.2.2 Discharge Filter Cake" tooltip="Filter cake is discharged from the filter onto a conveyor belt or into a transport container (at operations using containers for concentrate export). Discharge event initiates tracking of the filter cake batch as a physical product entity. At some operations, filter cake is weighed on a conveyor belt scale or bin scale at discharge — this is the primary dry tonnes measurement for the final product. [P754: mass (dry tonnes — key commercial measurement) | belt weigher on cake discharge conveyor or bin scale | per batch / continuous | Principles 1, 5, 7, 8 | YES — filter cake discharge is the primary internal dry tonnes measurement of the concentrate product before stockpiling]&#xa;ISA-95 level: 1 / 0&#xa;Actors: Plant Operator; DCS&#xa;Standard alignment: ISA-95 Levels 0, 1; AMIRA P754 Principles 1, 5, 7, 8&#xa;DDVC layer: Raw; Curated (concentrate_production_record — batch mass)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="648" y="405" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_3_2_n2" label="Transfer filter cake to concentrate shed" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). The transfer creates the production record, the CTP-2 opening entry; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_3_2_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1298" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_3_2_e__lbl" value="Filter cake to shed (CTP-2)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1266" y="479" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_3_2_3_3_2_3" label="3.3.2.3 Verify Moisture Content" tooltip="Moisture content of the filter cake is measured against the commercial specification and metallurgical accounting requirement. Method: grab sample taken from the conveyor discharge at defined frequency (typically each filter cycle or each hour), weighed wet and dry (oven dried at 105°C for 4 hours). Moisture % = (wet mass − dry mass) / wet mass × 100. Result is entered into LIMS and compared to smelter contract moisture specification. If out of specification, metallurgist assesses cause and adjusts filter operating parameters. [P754: moisture % (critical commercial parameter) | oven drying (gravimetric) or infrared moisture analyser | per filter cycle (every 1–4 hours) | Principles 1, 5, 7, 8 | YES — moisture % is an essential parameter in the dry tonnes calculation for commercial invoice; P754 Principle 5 (mass measurement at custody transfer)]&#xa;ISA-95 level: 3&#xa;Actors: Process Technician; Metallurgist&#xa;Standard alignment: ISA-95 Level 3 (quality management); AMIRA P754 Principles 1, 5, 7, 8&#xa;DDVC layer: Raw; Curated (concentrate_production_record — moisture %)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="854" y="575" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_3_2_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1110" y="580" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_3_2_g__lbl" value="Moisture within specification?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1039" y="530" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_3_2_n1" label="Adjust filter cycle, wash water or air; check underflow density" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Moisture exceedance response; the cake is re-filtered; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="745" width="170" height="80" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="3.3.3_concentrate-drying-and-packaging" name="3.3.3_concentrate-drying-and-packaging"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1406" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_3_3" value="3.3.3 Concentrate Drying &amp; Packaging" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1346" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_3_3_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1306" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_3_3_opr" value="Plant Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1306" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_3_3_s" target="Gw_L3_3_3_3_g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_3_g1" target="Task_L3_3_3_3_3_3_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_3_2__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="375" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_3_g1" target="Gw_L3_3_3_3_m"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336" y="40"/><mxPoint x="718" y="40"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_3_3__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="342" y="52" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_3_3_3_3_1" target="Gw_L3_3_3_3_m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_3_m" target="Gw_L3_3_3_3_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_3_g2" target="Task_L3_3_3_3_3_3_3_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="894" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_3_6__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_3_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_3_3_g2" target="End_L3_3_3_3_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_3_3_7__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="933" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_3_3_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_3_3_3_3_3_2" target="End_L3_3_3_3_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_3_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_3_3_s__lbl" value="Filter cake requires drying or packing" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><mxCell id="Gw_L3_3_3_3_g1" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="301" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_3_3_g1__lbl" value="Drying specified?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="230" y="34" width="100" height="28" as="geometry"/></mxCell><object id="Task_L3_3_3_3_3_3_3_1" label="3.3.3.1 Dry Concentrate" tooltip="A dryer (direct or indirect fired, or steam) reduces filter cake moisture to the product specification where filtration alone cannot reach it. Dryer temperature, feed rate and off-gas conditions are controlled by DCS; dried product moisture is verified by sample as in 3.3.2.3. Conditional — only where drying is part of the product specification. [P754: moisture % | oven drying or online analyser | per batch / per shift | Principles 1, 5, 7, 8 | YES — dried moisture sets the dry tonnes of the product]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS Auto-control; Plant Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 5, 7, 8&#xa;DDVC layer: Raw (time-series: dryer_telemetry); Curated (concentrate_production_record — moisture %)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="442" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_3_3_m" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="683" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_3_3_g2" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="859" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_3_3_g2__lbl" value="Packed dispatch specified?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="788" y="20" width="100" height="42" as="geometry"/></mxCell><mxCell id="End_L3_3_3_3_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1057" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_3_3_e2__lbl" value="Dried concentrate to storage" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1025" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_3_3_3_3_3_2" label="3.3.3.2 Package and Weigh Concentrate" tooltip="Concentrate is packed into bags or containers, each unit weighed on a certified scale and labelled with product, batch and weight. The packed unit record is the product's dry tonnes record (with the verified moisture) and the hand-off to Logistics (Pillar 4). Conditional — only where the product is dispatched packed. [P754: mass (unit weight — key commercial measurement) | certified packaging scale | per unit | Principles 1, 5, 7, 8 | YES — custody transfer of packed product]&#xa;ISA-95 level: 1 / 3&#xa;Actors: Plant Operator&#xa;Standard alignment: ISA-95 Levels 1, 3; AMIRA P754 Principles 1, 5, 7, 8&#xa;DDVC layer: Curated (concentrate_production_record — packaged mass)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1000" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_3_3_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1238" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_3_3_e1__lbl" value="Packed units to Logistics (Pillar 4)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1206" y="309" width="120" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.4_metallurgical-accounting-and-quality" name="3.4_metallurgical-accounting-and-quality"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="976" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L2_3_4" value="3.4 Metallurgical Accounting &amp; Quality (L2)" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="916" height="510" as="geometry"/></mxCell><mxCell id="Lane_L2_3_4_smp" value="Plant Chemist / Process Technician" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="876" height="170" as="geometry"/></mxCell><mxCell id="Lane_L2_3_4_asy" value="Laboratory Analyst / Process Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="876" height="170" as="geometry"/></mxCell><mxCell id="Lane_L2_3_4_acc" value="Chief Metallurgist / Metallurgical Accounting Analyst" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="876" height="170" as="geometry"/></mxCell><mxCell id="Flow_L2_3_4_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L2_3_4_s" target="Sub_L2_3_4_3_4_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_4_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_4_3_4_1" target="Sub_L2_3_4_3_4_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="105"/><mxPoint x="390" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_4_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_4_3_4_2" target="Sub_L2_3_4_3_4_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="596" y="275"/><mxPoint x="596" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_4_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_4_3_4_3" target="End_L2_3_4_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L2_3_4_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L2_3_4_s__lbl" value="Shift start; auto-samplers active" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="42" as="geometry"/></mxCell><object id="Sub_L2_3_4_3_4_1" label="3.4.1 Sampling" tooltip="L1/L3 Process. Representative sampling of all plant streams at defined measurement points is the foundation of metallurgical accounting. AMIRA P754 Principle 6 (representative, unbiased sampling) is the governing constraint. Automatic samplers on continuous streams; grab/composite sampling for batch and periodic streams.&#xa;ISA-95 level: 1–3&#xa;Actors: Plant Chemist; Process Technician&#xa;Standard alignment: ISA-95 Levels 1, 3; AMIRA P754 Principles 1, 5, 6, 7, 10&#xa;DDVC layer: Raw; Curated (sample_submission)" link="data:page/id,3.4.1_sampling"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="202" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_4_3_4_1__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="133" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_4_3_4_2" label="3.4.2 Assay &amp; Analysis" tooltip="L1/L3 Process. Chemical analysis of prepared samples determines the grade (metal content) of each process stream. Two parallel analytical channels exist: (1) the primary laboratory (fire assay for Au, ICP-OES/MS or XRF for base metals) for shift composite, daily composite, and concentrate product samples; (2) on-stream analysis (OSA) using online XRF analyzers for real-time process control.&#xa;ISA-95 level: 1–3&#xa;Actors: Laboratory Analyst; Process Metallurgist; LIMS&#xa;Standard alignment: ISA-95 Levels 1, 3; AMIRA P754 Principles 1, 5, 6, 7, 8, 10&#xa;DDVC layer: Raw; Curated (assay_result, osa_grade_record)" link="data:page/id,3.4.2_assay-and-analysis"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="408" y="227" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_4_3_4_2__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="486" y="303" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_4_3_4_3" label="3.4.3 Mass Balance &amp; Reconciliation" tooltip="L3 Process Area. Periodic mass balance closure integrates all mass flow measurements (belt weighers, flowmeters, density gauges) and grade measurements (lab assay, OSA) to compute metal produced, metal recovered, metal lost (to tailings), and metal unaccounted for. This is the core deliverable of AMIRA P754 compliance and the primary source of reconciliation data for mine-to-mill and mill-to-port reporting.&#xa;ISA-95 level: 3&#xa;Actors: Chief Metallurgist; Metallurgical Accounting Analyst; Plant Manager&#xa;Standard alignment: AMIRA P754 (all 10 principles); ISA-95 Level 3&#xa;DDVC layer: Curated (shift_mass_balance, metallurgical_accounting_report)" link="data:page/id,3.4.3_mass-balance-and-reconciliation"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="614" y="397" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_4_3_4_3__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="692" y="473" width="14" height="14" as="geometry"/></mxCell><mxCell id="End_L2_3_4_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="820" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_4_e__lbl" value="Monthly metal accounting report filed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="798" y="479" width="100" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.4.1_sampling" name="3.4.1_sampling"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1188" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_4_1" value="3.4.1 Sampling" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1128" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_4_1_ins" value="Auto-sampler / Plant Chemist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1088" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_4_1_tech" value="Process Technician" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1088" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_4_1_lab" value="Laboratory Technician" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1088" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_4_1_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_4_1_s" target="Par_L3_3_4_1_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_1_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_4_1_f" target="Service_L3_3_4_1_3_4_1_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_1_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_4_1_f" target="Task_L3_3_4_1_3_4_1_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="237" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_1_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_4_1_3_4_1_1" target="Par_L3_3_4_1_j"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="549" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_1_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_1_3_4_1_2" target="Par_L3_3_4_1_j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_1_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_4_1_j" target="Task_L3_3_4_1_n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_1_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_1_n1" target="Task_L3_3_4_1_3_4_1_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="808" y="275"/><mxPoint x="808" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_1_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_1_3_4_1_3" target="End_L3_3_4_1_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_4_1_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_4_1_s__lbl" value="Shift start; samplers active" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="42" as="geometry"/></mxCell><mxCell id="Par_L3_3_4_1_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="202" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Par_L3_3_4_1_f__lbl" value="Fork" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="177" y="144" width="120" height="40" as="geometry"/></mxCell><object id="Service_L3_3_4_1_3_4_1_1" label="3.4.1.1 Collect In-Stream Samples via Auto-Sampler" tooltip="Automatic samplers (cross-stream, vezin-type, or cross-belt) collect primary increments from designated plant streams at timed intervals (typically every 15–60 minutes). Streams sampled: flotation feed; for each configured flotation circuit, the rougher concentrate, final concentrate and circuit tailings; separation products where configured; plant composite tailings. Primary increments are accumulated in a sample cutter over the shift to form a shift composite. [P754: grade (all relevant metals + moisture) | automatic in-stream sampler | continuous increment (every 15–60 min); shift composite assembled | Principles 6, 7, 10 | YES for concentrate final streams; NO for intermediate streams]&#xa;ISA-95 level: 1&#xa;Actors: Automated (auto-sampler); Plant Chemist (oversight)&#xa;Standard alignment: ISA-95 Level 1; AMIRA P754 Principles 6, 7, 10&#xa;DDVC layer: Raw; Curated (sample_submission)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="308" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_4_1_3_4_1_2" label="3.4.1.2 Collect Grab and Composite Samples" tooltip="Operators collect grab samples from specific point locations (filter cake conveyor, concentrate shed, reclaim conveyor) at defined intervals or for batch-specific QC. Composites are formed from multiple grab increments accumulated over the shift. Used where auto-samplers are not installed or for verification sampling. [P754: grade + moisture | grab sample (manual) | defined intervals per sampling plan | Principles 6, 7 | Conditional — depends on stream designation in site sampling plan]&#xa;ISA-95 level: 3&#xa;Actors: Process Technician&#xa;Standard alignment: ISA-95 Level 3 (quality management); AMIRA P754 Principles 6, 7&#xa;DDVC layer: Raw"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="308" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Par_L3_3_4_1_j" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="514" y="240" width="70" height="70" as="geometry"/></mxCell><mxCell id="Par_L3_3_4_1_j__lbl" value="Join" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="489" y="314" width="120" height="40" as="geometry"/></mxCell><object id="Task_L3_3_4_1_n1" label="Submit shift composite samples to LIMS" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Registered with source stream, collection interval, shift ID and chain-of-custody record."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_4_1_3_4_1_3" label="3.4.1.3 Prepare Samples for Analysis" tooltip="Physical samples are processed in the sample preparation laboratory: weighed (wet mass), dried (oven at 105°C), re-weighed (dry mass — moisture % calculated), pulverised (ring mill or LM5) to a fine powder, split (riffle splitter or rotary divider) to produce the assay sub-sample, and sealed for dispatch to the primary laboratory. QC samples (duplicates, certified reference materials, blanks) are inserted at the sample preparation stage. [P754: mass (wet and dry mass for moisture %); grain size of prepared pulp | gravimetric balance + oven; ring mill; riffle splitter | per sample received | Principles 6, 7, 10 | NO — sample preparation is internal to the QA/QC process]&#xa;ISA-95 level: 3&#xa;Actors: Laboratory Technician&#xa;Standard alignment: ISA-95 Level 3; AMIRA P754 Principles 6, 7, 10&#xa;DDVC layer: Raw; Curated (sample_submission — preparation attributes)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="826" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_4_1_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1032" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_4_1_e__lbl" value="Assay pulps ready" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010" y="479" width="100" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.4.2_assay-and-analysis" name="3.4.2_assay-and-analysis"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1182" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_4_2" value="3.4.2 Assay &amp; Analysis" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1122" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_4_2_lab" value="Laboratory Analyst / Chief Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1082" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_4_2_osa" value="DCS (OSA integration) / Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1082" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_4_2_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_4_2_s" target="Task_L3_3_4_2_3_4_2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_2_3_4_2_1" target="Task_L3_3_4_2_3_4_2_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_2_3_4_2_3" target="Gw_L3_3_4_2_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_4_2_g" target="Task_L3_3_4_2_n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="738" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_4_2_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_4_2_g" target="Task_L3_3_4_2_n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_5__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="705" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_4_2_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_2_n1" target="Task_L3_3_4_2_3_4_2_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="287" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_2_n2" target="End_L3_3_4_2_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_4_2_s2" target="Service_L3_3_4_2_3_4_2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_2_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_4_2_3_4_2_2" target="End_L3_3_4_2_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_4_2_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_4_2_s__lbl" value="Assay pulps received" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="28" as="geometry"/></mxCell><object id="Task_L3_3_4_2_3_4_2_1" label="3.4.2.1 Perform Laboratory Assay" tooltip="Primary laboratory analysis of prepared assay pulps using: ICP-OES or ICP-MS (for Cu, Zn, Pb, Fe, Mo, and trace elements), XRF (for major element oxides and base metals), or fire assay (for Au, Ag). Results are entered into LIMS with certified reference material results and QC flags. Laboratory TAT is typically 8–24 hours for routine shift composites; 24–48 hours for monthly certification samples. [P754: grade (Cu%, Zn%, Pb%, Ag g/t, Au g/t, Fe%, S%, Mo% where applicable, moisture %) | ICP-OES/ICP-MS, XRF, fire assay | per batch (shift composite, daily composite, certification sample) | Principles 1, 5, 6, 7, 8 | YES for concentrate certification samples; NO for intermediate stream composites]&#xa;ISA-95 level: 3&#xa;Actors: Laboratory Analyst&#xa;Standard alignment: ISA-95 Level 3; AMIRA P754 Principles 1, 5, 6, 7, 8&#xa;DDVC layer: Raw; Curated (assay_result)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="202" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_4_2_3_4_2_3" label="3.4.2.3 Perform QA/QC on Analytical Results" tooltip="The laboratory inserts QC samples at a defined rate: certified reference materials (CRMs — typically 1 in 10 samples), field duplicates (1 in 20 samples), and blanks (1 in 20 samples). LIMS compiles QC statistics: CRM accuracy (recovery %), duplicate precision (RPD %), blank contamination. Control charts (Shewhart or CUSUM) flag systematic bias. QA/QC failure triggers re-assay of the affected batch. [P754: bias detection and accuracy | QC statistical analysis in LIMS | per analytical batch | Principles 8, 10 | YES for concentrate certification — failure to meet QC criteria invalidates the associated commercial assay]&#xa;ISA-95 level: 3&#xa;Actors: Laboratory Analyst; Chief Metallurgist&#xa;Standard alignment: ISA-95 Level 3 (quality management); AMIRA P754 Principles 8, 10&#xa;DDVC layer: Raw; Curated (qc_performance_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="408" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_4_2_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="664" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_4_2_g__lbl" value="QC batch accepted?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="649" y="36" width="100" height="28" as="geometry"/></mxCell><object id="Task_L3_3_4_2_n1" label="Issue re-assay instruction; flag results; hold batch" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition)."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="614" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_4_2_n2" label="Release results in LIMS" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition)."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_4_2_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1026" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_4_2_e__lbl" value="Assay results released" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="139" width="100" height="42" as="geometry"/></mxCell><mxCell id="Start_L3_3_4_2_s2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_4_2_s2__lbl" value="Plant streams flowing; OSA operational" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="479" width="100" height="56" as="geometry"/></mxCell><object id="Service_L3_3_4_2_3_4_2_2" label="3.4.2.2 Analyse Streams via On-Stream XRF" tooltip="Online XRF analyzers (multi-stream) continuously analyse slurry streams at 2–4 minute scan intervals, providing near-real-time grade data for process control. Each analyzer handles multiple streams sequentially via a stream sequencer. OSA data is used by the metallurgist for flotation control adjustments (reagent dosage, froth depth, air rate). OSA data is secondary to lab assay for accounting purposes — it provides the high-frequency trend for process control, not the definitive grade for mass balance closure. [P754: grade (Cu%, Zn%, Pb%, Fe%) | online XRF | continuous (2–4 min per stream per scan cycle) | Principles 6, 7 | YES for monitoring; NO for primary accounting — lab assay is primary]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS (OSA data integration); Metallurgist&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 6, 7&#xa;DDVC layer: Raw (time-series: osa_grade_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="202" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_4_2_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="465" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_4_2_e2__lbl" value="OSA data archived to PI Historian" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="443" y="479" width="100" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.4.3_mass-balance-and-reconciliation" name="3.4.3_mass-balance-and-reconciliation"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_4_3" value="3.4.3 Mass Balance &amp; Reconciliation" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1420" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_4_3_met" value="Metallurgist" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1380" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_4_3_acc" value="Chief Metallurgist / Metallurgical Accounting Analyst" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1380" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_4_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_4_3_s" target="Catch_L3_3_4_3_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Catch_L3_3_4_3_c" target="Task_L3_3_4_3_3_4_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_3_3_4_3_1" target="Gw_L3_3_4_3_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_4_3_g" target="Task_L3_3_4_3_3_4_3_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="688" y="105"/><mxPoint x="688" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="624" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_4_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_4_3_g" target="Task_L3_3_4_3_n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_5__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="591" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_4_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_3_n1" target="Task_L3_3_4_3_3_4_3_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="379" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_3_3_4_3_2" target="Task_L3_3_4_3_3_4_3_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_3_3_4_3_4" target="Task_L3_3_4_3_3_4_3_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_4_3_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_4_3_3_4_3_3" target="End_L3_3_4_3_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_4_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="110" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_4_3_s__lbl" value="Shift end" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="139" width="100" height="14" as="geometry"/></mxCell><mxCell id="Catch_L3_3_4_3_c" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="202" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Catch_L3_3_4_3_c__inner" value="" style="ellipse;html=0;aspect=fixed;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="207" y="82" width="46" height="46" as="geometry"/></mxCell><mxCell id="Catch_L3_3_4_3_c__lbl" value="Shift composite assays returned" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="180" y="139" width="100" height="56" as="geometry"/></mxCell><object id="Task_L3_3_4_3_3_4_3_1" label="3.4.3.1 Close Shift Mass Balance" tooltip="At each shift end, the metallurgist runs the shift mass balance calculation: sum of ore feed mass (belt weigher) × feed grade (assay) = sum over all saleable concentrates of concentrate mass (filter cake belt weigher × moisture correction to dry tonnes) × concentrate grade (shift composite assay) + sum of tailings mass × tailings grade. Balance error (%) = (feed metal − products metal) / feed metal × 100. Acceptable shift balance error is site-specific (typically ±5% for shift; tighter at daily). [P754: ALL measurement types — integrates mass, grade, density, moisture | integrates all instrument types | per shift | ALL 10 Principles | YES — shift mass balance is the formal P754 accounting period closure at the shift level]&#xa;ISA-95 level: 3&#xa;Actors: Metallurgist&#xa;Standard alignment: ISA-95 Level 3; AMIRA P754 Principles 1–10 (synthesis)&#xa;DDVC layer: Curated (shift_mass_balance)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="294" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_4_3_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="550" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_4_3_g__lbl" value="Balance error within tolerance?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="535" y="22" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_4_3_n1" label="Investigate instrument data, sample integrity, stockpile changes; escalate" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition)."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="500" y="235" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_4_3_3_4_3_2" label="3.4.3.2 Perform Daily and Weekly Reconciliation" tooltip="Daily and weekly reconciliations aggregate shift mass balances, apply any laboratory result updates (re-assays, late results), and cross-check against independent measurements (stockpile surveys, weighbridge records from incoming concentrate trucks). Discrepancies beyond tolerance thresholds trigger investigation. The daily reconciliation is the primary operational performance report reviewed by the plant manager.&#xa;ISA-95 level: 3&#xa;Actors: Chief Metallurgist; Metallurgical Accounting Analyst&#xa;Standard alignment: ISA-95 Level 3; AMIRA P754 Principles 2, 3, 7, 8&#xa;DDVC layer: Curated (metallurgical_accounting_report)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="706" y="405" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_4_3_3_4_3_4" label="3.4.3.4 Conduct Inventory Adjustment and Stocktake" tooltip="Physical stocktake of all in-process inventory (COS, flotation feed bins, concentrate sheds, TSF) is conducted periodically (monthly minimum; quarterly formal) to verify the book inventory against physical inventory. Survey methods: drone volumetric survey (COS and concentrate shed), belt weigher integration (conveyors), filter cake batch records (filter output). Inventory adjustments (book vs. physical variances) are recorded as adjustments in the metallurgical accounting system. [P754: mass (physical inventory vs. book inventory) | physical survey (drone + geodetic) + weighbridge records | monthly (minimum) | Principles 3, 9 | YES — inventory is a component of the check-in / check-out mass balance boundary]&#xa;ISA-95 level: 3&#xa;Actors: Chief Metallurgist; Survey Team; Metallurgical Accounting Analyst&#xa;Standard alignment: ISA-95 Level 3; AMIRA P754 Principles 3, 9&#xa;DDVC layer: Curated (stockpile_inventory — physical reconciliation); Curated (metallurgical_accounting_report — inventory adjustment)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="912" y="405" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_4_3_3_4_3_3" label="3.4.3.3 Produce Monthly Metal Accounting Report" tooltip="The monthly metal accounting report is the definitive financial-period production record. It aggregates all daily reconciliations, applies the final month-end assay certification results (independent third-party umpire assays for commercial concentrate batches), and closes the formal accounting period. The report is submitted to corporate finance, the audit committee, and relevant regulatory authorities. [P754: ALL Principles — the monthly report is the culmination of full P754 compliance | all instrument types + certification lab assay | monthly period close | ALL 10 Principles | YES — the monthly concentrate production figure is the basis for commercial invoicing and revenue recognition]&#xa;ISA-95 level: 3&#xa;Actors: Chief Metallurgist; Finance; Plant Manager&#xa;Standard alignment: ISA-95 Level 4 (business reporting); AMIRA P754 Principles 1–10&#xa;DDVC layer: Curated (metallurgical_accounting_report — monthly); Contextualized (recovered metal by period, recovery %)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1118" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_4_3_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1324" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_4_3_e__lbl" value="Report filed; figures to Finance" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1302" y="479" width="100" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5_tailings-management" name="3.5_tailings-management"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1642" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L2_3_5" value="3.5 Tailings Management (L2)" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1582" height="510" as="geometry"/></mxCell><mxCell id="Lane_L2_3_5_tail" value="Tailings Operator / DCS / SCADA" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1542" height="170" as="geometry"/></mxCell><mxCell id="Lane_L2_3_5_con" value="Construction Supervisor / Surveyor" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1542" height="170" as="geometry"/></mxCell><mxCell id="Lane_L2_3_5_eng" value="Tailings Facility Engineer" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1542" height="170" as="geometry"/></mxCell><mxCell id="Flow_L2_3_5_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L2_3_5_s" target="Sub_L2_3_5_3_5_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_5_3_5_1" target="Gw_L2_3_5_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_5_g" target="Sub_L2_3_5_3_5_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_3__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="581" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_5_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L2_3_5_g" target="Sub_L2_3_5_3_5_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="542" y="40"/><mxPoint x="1115" y="40"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_4__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="548" y="52" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L2_3_5_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_5_3_5_2" target="Par_L2_3_5_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_5_f" target="Sub_L2_3_5_3_5_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_5_f" target="Sub_L2_3_5_3_5_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="924" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_5_3_5_3" target="Sub_L2_3_5_3_5_5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1321" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_5_3_5_4" target="Sub_L2_3_5_3_5_5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1218" y="275"/><mxPoint x="1218" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_5_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_5_3_5_5" target="End_L2_3_5_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L2_3_5_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L2_3_5_s__lbl" value="Thickened tailings from 3.3.1" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Sub_L2_3_5_3_5_1" label="3.5.1 Tailings Transport &amp; Distribution" tooltip="L0/L1/L2 Process. Moves thickened tailings from the plant to the facility by pumped or gravity pipeline and routes them to the active discharge point — the classification station, a deposition line or cell, or an emergency discharge — according to the deposition plan.&#xa;ISA-95 level: 1–2&#xa;Actors: DCS / SCADA; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 5&#xa;DDVC layer: Raw (time-series: tailings_telemetry)" link="data:page/id,3.5.1_tailings-transport-and-distribution"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="266" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_5_3_5_1__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="344" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="Gw_L2_3_5_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="507" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L2_3_5_g__lbl" value="Classification fitted?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="436" y="34" width="100" height="28" as="geometry"/></mxCell><object id="Sub_L2_3_5_3_5_2" label="3.5.2 Tailings Classification" tooltip="L0/L1/L2 Process. Conditional — applies where the embankment is built with sand classified from the tailings (e.g., cyclone sand dams). Hydrocyclones split the tailings into a coarse, free-draining sand (underflow) for construction and a fine slurry (overflow) for deposition. Classification overflow is fine tailings slurry, not clarified water.&#xa;ISA-95 level: 0–2&#xa;Actors: DCS / SCADA; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 0–2; GISTM; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw (time-series: classification_telemetry)" link="data:page/id,3.5.2_tailings-classification"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="648" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_5_3_5_2__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="726" y="133" width="14" height="14" as="geometry"/></mxCell><mxCell id="Par_L2_3_5_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="889" y="70" width="70" height="70" as="geometry"/></mxCell><object id="Sub_L2_3_5_3_5_3" label="3.5.3 Tailings Deposition" tooltip="L0/L2/L3 Process. Places tailings — or classification fines, or rejected sand — in the impoundment by the configured deposition method, and rotates discharge so that the beach and pond stay where the design requires.&#xa;ISA-95 level: 0–3&#xa;Actors: Tailings Operator&#xa;Standard alignment: ISA-95 Levels 0–3; GISTM; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw; Curated (tailings_deposition_record)" link="data:page/id,3.5.3_tailings-deposition"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1030" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_5_3_5_3__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1108" y="133" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_5_3_5_4" label="3.5.4 Embankment Construction" tooltip="L0/L3 Process. Builds and raises the embankment with the configured construction materials and method — classified sand placed in cells or paddocks, mine waste or rockfill, or borrow — to the construction plan, and surveys the facility geometry.&#xa;ISA-95 level: 0–3&#xa;Actors: Construction Supervisor / Surveyor; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 0, 3; GISTM&#xa;DDVC layer: Raw; Curated (construction_placement_record, facility_survey_record)" link="data:page/id,3.5.4_embankment-construction"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1030" y="227" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_5_3_5_4__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1108" y="303" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_5_3_5_5" label="3.5.5 Facility Storage &amp; Safety Monitoring" tooltip="L1/L3 Process. Monitors pond level and freeboard, assesses storage capacity against the construction and deposition plans, and issues operating constraints when the facility is outside its operating criteria. This is the operational interface to geotechnical surveillance and emergency preparedness, which Pillar 6 governs.&#xa;ISA-95 level: 1–3&#xa;Actors: Tailings Facility Engineer; Tailings Operator&#xa;Standard alignment: GISTM; ICMM Fatal Hazard Control&#xa;DDVC layer: Raw; Curated (tsf_inventory_record, facility_operating_constraint)" link="data:page/id,3.5.5_facility-storage-and-safety-monitoring"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1236" y="397" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_5_3_5_5__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1314" y="473" width="14" height="14" as="geometry"/></mxCell><mxCell id="End_L2_3_5_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1474" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_5_e__lbl" value="Facility status reported" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1442" y="479" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5.1_tailings-transport-and-distribution" name="3.5.1_tailings-transport-and-distribution"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1084" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_5_1" value="3.5.1 Tailings Transport &amp; Distribution" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1024" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_5_1_dcs" value="DCS / SCADA" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="984" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_5_1_tail" value="Tailings Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="984" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_1_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_5_1_s" target="Service_L3_3_5_1_3_5_1_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_1_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_5_1_3_5_1_1" target="Gw_L3_3_5_1_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_1_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_1_g" target="Task_L3_3_5_1_3_5_1_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="105"/><mxPoint x="660" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_1_3__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="596" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_1_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_1_g" target="Task_L3_3_5_1_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_1_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="563" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_1_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_1_n" target="End_L3_3_5_1_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_1_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_1_3_5_1_2" target="End_L3_3_5_1_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_5_1_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_5_1_s__lbl" value="Thickened tailings from thickening" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Service_L3_3_5_1_3_5_1_1" label="3.5.1.1 Transport Tailings to Facility" tooltip="Thickened tailings flow from the plant to the facility by pumped or gravity pipeline. Several pump stages may be needed depending on head and distance. Pipeline pressure, flow and density are monitored continuously; a pressure drop or flow interruption (pipeline failure, pump failure) is an environmental incident trigger and stops the transfer. [P754: mass flow + volume | magnetic flowmeter + nuclear density gauge | continuous (1-min) | Principles 1, 5 | PARTIAL — plant-to-facility boundary; TP-01]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA&#xa;Standard alignment: ISA-95 Levels 1, 2; AMIRA P754 Principles 1, 5&#xa;DDVC layer: Raw (time-series: tailings_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_5_1_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="522" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_5_1_g__lbl" value="Line pressure or flow abnormal?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="451" y="20" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_5_1_3_5_1_2" label="3.5.1.2 Route Tailings to Discharge Point" tooltip="Valves and lines direct the tailings to the classification station (where fitted) or to the deposition line or cell selected in the deposition plan. An emergency discharge to designated containment is used during upsets. Line and valve states are recorded so that deposited tailings can be attributed to a location.&#xa;ISA-95 level: 1 / 2&#xa;Actors: Tailings Operator; DCS / SCADA&#xa;Standard alignment: ISA-95 Levels 1, 2; GISTM&#xa;DDVC layer: Raw (time-series: tailings_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_5_1_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_1_e__lbl" value="Tailings at discharge point" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="309" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_5_1_n" label="Stop transfer; divert to emergency containment; notify" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Pipeline integrity response; an environmental incident trigger; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_5_1_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="735" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_1_e2__lbl" value="Transfer stopped" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="703" y="479" width="120" height="14" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5.2_tailings-classification" name="3.5.2_tailings-classification"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1466" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_5_2" value="3.5.2 Tailings Classification" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1406" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_5_2_dcs" value="DCS / SCADA" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1366" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_5_2_tail" value="Tailings Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1366" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_2_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_5_2_s" target="Service_L3_3_5_2_3_5_2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_5_2_3_5_2_1" target="Task_L3_3_5_2_3_5_2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_2_3_5_2_2" target="Par_L3_3_5_2_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_5_2_f" target="End_L3_3_5_2_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_5_2_f" target="Task_L3_3_5_2_3_5_2_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="748" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_2_3_5_2_3" target="Gw_L3_3_5_2_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_2_g" target="End_L3_3_5_2_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_7__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1184" y="255" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_2_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_2_g" target="Task_L3_3_5_2_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_2_8__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1151" y="314" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_2_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_2_n" target="End_L3_3_5_2_e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_5_2_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_5_2_s__lbl" value="Tailings at classification station" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Service_L3_3_5_2_3_5_2_1" label="3.5.2.1 Condition Classifier Feed" tooltip="Tailings are diluted with water to the hydrocyclone feed density in a feed box or tank. Dilution water is a water use inside the facility, supplied from reclaim (3.6.2) or recovered seepage (3.6.3). [WATER: volume (dilution water added) | flow meter | continuous | MCA WAF | NO — internal recycle; WP-08]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA&#xa;Standard alignment: ISA-95 Levels 1, 2&#xa;DDVC layer: Raw (time-series: classification_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_5_2_3_5_2_2" label="3.5.2.2 Classify Tailings by Hydrocyclone" tooltip="Hydrocyclone batteries split the feed into a sand-rich underflow and a fines-rich overflow. Battery pressure and the number of cyclones in service are controlled to hit the sand specification. The split defines sand produced and fines sent to deposition. [P754: mass flow + density (sand and fines streams) | flowmeter + density gauge, or mass by difference | continuous | Principles 1, 7 | NO — TP-02 sand, TP-03 fines]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS / SCADA; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; GISTM; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw (time-series: classification_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Par_L3_3_5_2_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="713" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="End_L3_3_5_2_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="911" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_2_e1__lbl" value="Fines to deposition (3.5.3)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="879" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_5_2_3_5_2_3" label="3.5.2.3 Verify Sand Quality for Construction" tooltip="Sand for construction must meet a placement specification, typically fines content and % solids. Samples from the sand stream are tested at a defined frequency; off-specification sand is diverted to deposition instead of construction.&#xa;ISA-95 level: 3&#xa;Actors: Tailings Operator; Tailings Facility Engineer&#xa;Standard alignment: ISA-95 Level 3; GISTM&#xa;DDVC layer: Raw; Curated (construction_placement_record — quality attribute)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="854" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_5_2_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1110" y="240" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_5_2_g__lbl" value="Sand fit for construction?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1039" y="204" width="100" height="28" as="geometry"/></mxCell><mxCell id="End_L3_3_5_2_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1298" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_2_e2__lbl" value="Sand to construction (3.5.4)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1266" y="309" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_5_2_n" label="Divert sand to deposition" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Off-specification sand response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_5_2_e3" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1298" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_2_e3__lbl" value="Rejected sand to deposition" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1266" y="479" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5.3_tailings-deposition" name="3.5.3_tailings-deposition"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1084" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_5_3" value="3.5.3 Tailings Deposition" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1024" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_5_3_tail" value="Tailings Operator / Tailings Facility Engineer" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="984" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_5_3_s" target="Task_L3_3_5_3_3_5_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_3_3_5_3_1" target="Task_L3_3_5_3_3_5_3_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_3_3_5_3_2" target="Gw_L3_3_5_3_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_3_g" target="End_L3_3_5_3_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_3_4__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="802" y="85" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_3_g" target="Task_L3_3_5_3_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_3_5__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="769" y="144" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_3_n" target="End_L3_3_5_3_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_5_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_5_3_s__lbl" value="Tailings at discharge point" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_5_3_3_5_3_1" label="3.5.3.1 Deposit Tailings in Impoundment" tooltip="Tailings slurry is discharged through spigots or open-ended lines on the embankment crest, the beach or within cells. Deposition records (location, volume or mass, density) are kept for the facility mass balance. [P754: volume and mass (deposited) | flow integration + density, or survey | continuous flow / periodic survey | Principles 1, 7 | PARTIAL — the TSF is the final sink of the plant-side mass balance; TP-05]&#xa;ISA-95 level: 0 / 2&#xa;Actors: Tailings Operator; DCS / SCADA&#xa;Standard alignment: ISA-95 Levels 0, 2; AMIRA P754 Principles 1, 7&#xa;DDVC layer: Raw; Curated (tailings_deposition_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_5_3_3_5_3_2" label="3.5.3.2 Manage Beach and Pond Position" tooltip="Discharge points are rotated to build the beach, keep the pond within its design area and away from the embankment, and maintain the minimum beach width. Beach width and pond position are checked by survey or remote sensing against the operating criteria.&#xa;ISA-95 level: 2 / 3&#xa;Actors: Tailings Operator; Tailings Facility Engineer&#xa;Standard alignment: ISA-95 Levels 2, 3; GISTM&#xa;DDVC layer: Curated (tailings_deposition_record — location attribute)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_5_3_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="728" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_5_3_g__lbl" value="Beach width below minimum?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="657" y="34" width="100" height="28" as="geometry"/></mxCell><mxCell id="End_L3_3_5_3_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_3_e__lbl" value="Tailings deposited" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_5_3_n" label="Relocate discharge to restore beach" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Beach width response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_5_3_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_3_e2__lbl" value="Discharge relocated" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="309" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5.4_embankment-construction" name="3.5.4_embankment-construction"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1084" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_5_4" value="3.5.4 Embankment Construction" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1024" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_5_4_con" value="Construction Supervisor / Surveyor" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="984" height="510" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_4_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_5_4_s" target="Task_L3_3_5_4_3_5_4_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_4_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_4_3_5_4_1" target="Task_L3_3_5_4_3_5_4_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_4_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_4_3_5_4_2" target="Gw_L3_3_5_4_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_4_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_4_g" target="End_L3_3_5_4_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_4_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="802" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_4_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_4_g" target="Task_L3_3_5_4_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_4_5__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="769" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_4_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_4_n" target="End_L3_3_5_4_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_4_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_5_4_s2" target="Task_L3_3_5_4_3_5_4_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_4_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_4_3_5_4_3" target="End_L3_3_5_4_e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_5_4_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_5_4_s__lbl" value="Construction material available" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_5_4_3_5_4_1" label="3.5.4.1 Place Construction Material" tooltip="Material is placed in the active cell, paddock or zone of the embankment by the configured method: classified sand discharged hydraulically into cells, or mine waste, rockfill or borrow placed by equipment. Quantities are recorded by delivery (line flow for sand; truck counts or payloads for rock — a Pillar 2 interface where the material is mine waste). [P754: mass or volume (placed material) | line flow and density, truck counts, or survey | continuous / per load / periodic | Principles 1, 7 | NO — TP-04]&#xa;ISA-95 level: 0 / 3&#xa;Actors: Construction Supervisor / Surveyor; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 0, 3; GISTM&#xa;DDVC layer: Curated (construction_placement_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_5_4_3_5_4_2" label="3.5.4.2 Drain and Compact Placed Material" tooltip="Hydraulically placed sand drains in its cell until it can be spread and compacted; mechanically placed fill is compacted in lifts. Density and moisture tests confirm the specification. Drainage water reports to seepage and drainage collection (3.6.3).&#xa;ISA-95 level: 0 / 3&#xa;Actors: Construction Supervisor / Surveyor&#xa;Standard alignment: ISA-95 Levels 0, 3; GISTM&#xa;DDVC layer: Curated (construction_placement_record — compaction attribute)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_5_4_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="728" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_5_4_g__lbl" value="Placement meets specification?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="657" y="20" width="100" height="42" as="geometry"/></mxCell><mxCell id="End_L3_3_5_4_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_4_e__lbl" value="Material placed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="139" width="120" height="14" as="geometry"/></mxCell><object id="Task_L3_3_5_4_n" label="Rework non-conforming fill" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Placement QA/QC response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_5_4_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_4_e2__lbl" value="Rework recorded" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="309" width="120" height="14" as="geometry"/></mxCell><mxCell id="Start_L3_3_5_4_s2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_5_4_s2__lbl" value="Survey scheduled" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="479" width="120" height="14" as="geometry"/></mxCell><object id="Task_L3_3_5_4_3_5_4_3" label="3.5.4.3 Survey Facility Geometry" tooltip="Periodic survey (drone photogrammetry, LiDAR or GPS) of the crest, embankment zones, beach and pond gives placed and deposited volumes, crest elevation and geometry change against the design. Survey volumes reconcile metered placement and deposition. [P754: volume (placed and deposited) | topographic survey | periodic | Principles 1, 3, 7 | NO — reconciles TP-04 and TP-05]&#xa;ISA-95 level: 3&#xa;Actors: Construction Supervisor / Surveyor&#xa;Standard alignment: ISA-95 Level 3; GISTM; AMIRA P754 Principles 1, 3, 7&#xa;DDVC layer: Raw; Curated (facility_survey_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="405" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_5_4_e3" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="529" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_4_e3__lbl" value="Survey results to 3.5.5" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="497" y="479" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5.5_facility-storage-and-safety-monitoring" name="3.5.5_facility-storage-and-safety-monitoring"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1084" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_5_5" value="3.5.5 Facility Storage &amp; Safety Monitoring" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1024" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_5_5_eng" value="Tailings Facility Engineer" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="984" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_5_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_5_5_s" target="Task_L3_3_5_5_3_5_5_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_5_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_5_3_5_5_1" target="Task_L3_3_5_5_3_5_5_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_5_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_5_3_5_5_2" target="Gw_L3_3_5_5_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_5_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_5_g" target="End_L3_3_5_5_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_5_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="802" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_5_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_5_5_g" target="Task_L3_3_5_5_3_5_5_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_5_5_5__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="769" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_5_5_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_5_5_3_5_5_3" target="End_L3_3_5_5_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_5_5_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_5_5_s__lbl" value="Pond reading or survey received" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_5_5_3_5_5_1" label="3.5.5.1 Monitor Pond Level and Freeboard" tooltip="Pond level is measured continuously (level sensor) and pond area and volume periodically (survey or bathymetry). Freeboard is calculated against the approved reference and compared with the criterion. [WATER: level and volume (pond inventory) | level sensor + survey or bathymetry | continuous level / periodic volume | MCA WAF | YES — facility water storage; WP-11]&#xa;ISA-95 level: 1 / 2&#xa;Actors: Tailings Facility Engineer; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; GISTM; MCA WAF&#xa;DDVC layer: Raw (time-series: pond_level_telemetry); Curated (tsf_inventory_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_5_5_3_5_5_2" label="3.5.5.2 Assess Storage Capacity Against Plan" tooltip="Available storage is compared with the deposition forecast and the planned embankment raise (the race between construction rise and storage rise), to confirm that deposition and production can continue within the permitted operating conditions.&#xa;ISA-95 level: 3&#xa;Actors: Tailings Facility Engineer; Construction Supervisor / Surveyor&#xa;Standard alignment: ISA-95 Level 3; GISTM&#xa;DDVC layer: Curated (tsf_inventory_record — capacity)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_5_5_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="728" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_5_5_g__lbl" value="Within operating criteria?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="657" y="20" width="100" height="42" as="geometry"/></mxCell><mxCell id="End_L3_3_5_5_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_5_e1__lbl" value="Facility status reported" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_5_5_3_5_5_3" label="3.5.5.3 Issue Facility Operating Constraint" tooltip="When freeboard or capacity is outside the operating criteria, an operating constraint is issued to the plant and tailings operations: reduce tailings input or throughput, change the deposition location, increase reclaim, or start emergency water management. Pillar 6 is notified, because a TSF failure is a top-tier fatal hazard.&#xa;ISA-95 level: 3&#xa;Actors: Tailings Facility Engineer; Tailings Operator&#xa;Standard alignment: ISA-95 Level 3; GISTM; ICMM Fatal Hazard Control&#xa;DDVC layer: Curated (facility_operating_constraint)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_5_5_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_5_5_e2__lbl" value="Operating constraint issued" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="309" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6_water-management" name="3.6_water-management"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1436" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L2_3_6" value="3.6 Water Management (L2)" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1376" height="680" as="geometry"/></mxCell><mxCell id="Lane_L2_3_6_wat" value="Water Operator / Control Room Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1336" height="170" as="geometry"/></mxCell><mxCell id="Lane_L2_3_6_tail" value="Tailings Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1336" height="340" as="geometry"/></mxCell><mxCell id="Lane_L2_3_6_rep" value="Water Balance Analyst" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="1336" height="170" as="geometry"/></mxCell><mxCell id="Flow_L2_3_6_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L2_3_6_s" target="Par_L2_3_6_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_6_f" target="Sub_L2_3_6_3_6_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_6_f" target="Sub_L2_3_6_3_6_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_6_f" target="Sub_L2_3_6_3_6_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_6_3_6_1" target="Par_L2_3_6_j"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="718" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_6_3_6_2" target="Par_L2_3_6_j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_6_3_6_3" target="Par_L2_3_6_j"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="718" y="445"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L2_3_6_j" target="Sub_L2_3_6_3_6_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="806" y="275"/><mxPoint x="806" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_6_3_6_4" target="Sub_L2_3_6_3_6_5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1012" y="105"/><mxPoint x="1012" y="615"/></Array></mxGeometry></mxCell><mxCell id="Flow_L2_3_6_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Sub_L2_3_6_3_6_5" target="End_L2_3_6_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L2_3_6_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L2_3_6_s__lbl" value="Site water systems operating" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="309" width="120" height="28" as="geometry"/></mxCell><mxCell id="Par_L2_3_6_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="301" y="240" width="70" height="70" as="geometry"/></mxCell><object id="Sub_L2_3_6_3_6_1" label="3.6.1 Makeup Water Supply" tooltip="L0/L1/L2 Process. Brings new water to the site from the configured source — seawater, surface water, groundwater or a third-party supply — treats it where required, disposes of any treatment residue, and conveys it to site storage. &quot;Makeup&quot;, &quot;fresh&quot; and &quot;desalinated&quot; water are different concepts; the source type is configuration.&#xa;ISA-95 level: 0–2&#xa;Actors: Water Operator; DCS / SCADA&#xa;Standard alignment: ISA-95 Levels 0–2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)" link="data:page/id,3.6.1_makeup-water-supply"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="442" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_6_3_6_1__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="133" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_6_3_6_2" label="3.6.2 Reclaim Water" tooltip="L0/L1/L2 Process. Recovers water from the TSF pond and delivers it to its users — process water storage, the classification station, or other site uses.&#xa;ISA-95 level: 0–2&#xa;Actors: DCS / SCADA; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 0–2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)" link="data:page/id,3.6.2_reclaim-water"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="442" y="227" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_6_3_6_2__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="303" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_6_3_6_3" label="3.6.3 Seepage &amp; Drainage Collection" tooltip="L0/L1/L2 Process. Collects water that seeps through tailings, the embankment or its foundation, and drainage from placed construction material, in drains, sumps and ponds, and pumps it to its configured destination — the impoundment, reclaim, a classification station, or treatment and discharge. Drainage of freshly placed sand is distinct from seepage.&#xa;ISA-95 level: 0–2&#xa;Actors: Tailings Operator; DCS / SCADA; Environmental Officer&#xa;Standard alignment: ISA-95 Levels 0–2; GISTM; MCA WAF&#xa;DDVC layer: Raw (time-series: pond_level_telemetry, water_flow_telemetry)" link="data:page/id,3.6.3_seepage-and-drainage-collection"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="442" y="397" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_6_3_6_3__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="473" width="14" height="14" as="geometry"/></mxCell><mxCell id="Par_L2_3_6_j" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="683" y="240" width="70" height="70" as="geometry"/></mxCell><object id="Sub_L2_3_6_3_6_4" label="3.6.4 Process Water Supply &amp; Distribution" tooltip="L1/L2 Process. Blends recovered water (thickener overflow, filtrate), reclaim water, recovered seepage and makeup water in process water storage and distributes process water to plant users — grinding, flotation, reagent make-up, wash and gland water.&#xa;ISA-95 level: 1–2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)" link="data:page/id,3.6.4_process-water-supply-and-distribution"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="824" y="57" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_6_3_6_4__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="133" width="14" height="14" as="geometry"/></mxCell><object id="Sub_L2_3_6_3_6_5" label="3.6.5 Site Water Balance &amp; Reconciliation" tooltip="L3 Process. Brings the water flow and volume records from 3.3, 3.5 and 3.6 together for each reporting period, applies the water-system boundaries and allocation rules, and closes the site water balance. Composite figures (e.g., total plant water use) must count each volume once. Metric definitions and formulas belong in Stage 2.&#xa;ISA-95 level: 3–4&#xa;Actors: Water Balance Analyst; Environmental Officer; Water Operator&#xa;Standard alignment: MCA Water Accounting Framework; ICMM water reporting guidance; ISA-95 Levels 3, 4&#xa;DDVC layer: Curated (water_transfer_record, water_balance_record)" link="data:page/id,3.6.5_site-water-balance-and-reconciliation"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=8;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="1030" y="567" width="170" height="96" as="geometry"/></mxCell></object><mxCell id="Sub_L2_3_6_3_6_5__plus" value="+" style="html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1108" y="643" width="14" height="14" as="geometry"/></mxCell><mxCell id="End_L2_3_6_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1268" y="587" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L2_3_6_e__lbl" value="Period water balance published" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1236" y="649" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6.1_makeup-water-supply" name="3.6.1_makeup-water-supply"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1848" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_6_1" value="3.6.1 Makeup Water Supply" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1788" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_1_wat" value="Water Operator / DCS / SCADA" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1748" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_1_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_6_1_s" target="Task_L3_3_6_1_3_6_1_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_1_3_6_1_1" target="Gw_L3_3_6_1_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_1_g" target="Task_L3_3_6_1_3_6_1_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_3__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="581" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_1_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_1_g" target="Task_L3_3_6_1_3_6_1_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="542" y="40"/><mxPoint x="1115" y="40"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_4__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="548" y="52" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_1_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_1_3_6_1_2" target="Par_L3_3_6_1_f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_6_1_f" target="Task_L3_3_6_1_3_6_1_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Par_L3_3_6_1_f" target="Task_L3_3_6_1_3_6_1_3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="924" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_1_3_6_1_3" target="End_L3_3_6_1_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_9" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_1_3_6_1_4" target="Service_L3_3_6_1_3_6_1_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_10" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_6_1_3_6_1_5" target="Gw_L3_3_6_1_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_11" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_1_g2" target="End_L3_3_6_1_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_11__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1566" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_1_12" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_1_g2" target="Task_L3_3_6_1_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_1_12__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1533" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_1_13" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_1_n" target="End_L3_3_6_1_e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_6_1_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_6_1_s__lbl" value="Makeup water demand" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_1_3_6_1_1" label="3.6.1.1 Abstract Raw Water" tooltip="Raw water is drawn from the configured source — seawater intake, river or lake, borefield, or a third-party connection — within the permitted abstraction limits. [WATER: volume (abstracted) | source meter | continuous | MCA WAF | YES — water input boundary; WP-01]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS / SCADA; Water Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_6_1_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="507" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_6_1_g__lbl" value="Treatment required?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="436" y="34" width="100" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_1_3_6_1_2" label="3.6.1.2 Treat Raw Water" tooltip="Raw water is treated to the quality the site needs — for example desalination of seawater, or filtration and softening of surface water. Conditional — only where the source needs treatment. Plant availability and output are monitored. [WATER: volume (treated water produced) | product meter | continuous | MCA WAF | NO — WP-02]&#xa;ISA-95 level: 0 / 2&#xa;Actors: DCS / SCADA; Water Operator&#xa;Standard alignment: ISA-95 Levels 0, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="648" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Par_L3_3_6_1_f" value="+" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="889" y="70" width="70" height="70" as="geometry"/></mxCell><object id="Task_L3_3_6_1_3_6_1_4" label="3.6.1.4 Convey Makeup Water to Site" tooltip="Pump stations and pipeline move makeup water to site. Pumped and received volumes are compared to detect transfer losses or meter faults; any shared use of the supply system (an allocation boundary) is recorded. [WATER: volume and flow (pumped) | pump station flow meters | continuous | MCA WAF | NO — transfer within the supply system]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA; Water Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1030" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Service_L3_3_6_1_3_6_1_5" label="3.6.1.5 Receive and Store Makeup Water" tooltip="Makeup water is received into site storage, from which process water is blended (3.6.4). The receipt meter is the site boundary for makeup water. [WATER: volume (received) | receipt meter | continuous | MCA WAF | YES — site receipt boundary; WP-04]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1236" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_6_1_g2" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1492" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_6_1_g2__lbl" value="Transfer volumes reconcile?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1421" y="20" width="100" height="42" as="geometry"/></mxCell><mxCell id="End_L3_3_6_1_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1680" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_1_e1__lbl" value="Makeup water in site storage" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1648" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_1_3_6_1_3" label="3.6.1.3 Dispose of Treatment Residue" tooltip="Residue from treatment — for example brine from desalination, or sludge — is disposed of under its discharge permit; volume and quality are reported. Conditional — only where treatment produces a residue. [WATER: volume (residue discharged) | flow meter | continuous | MCA WAF | YES — water output boundary; WP-03]&#xa;ISA-95 level: 0 / 2&#xa;Actors: Water Operator; Environmental Officer&#xa;Standard alignment: ISA-95 Levels 0, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1030" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_6_1_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1293" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_1_e2__lbl" value="Residue disposed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1261" y="309" width="120" height="14" as="geometry"/></mxCell><object id="Task_L3_3_6_1_n" label="Investigate transfer loss or meter fault" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Pumped vs received check; industry convention; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1442" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_6_1_e3" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1680" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_1_e3__lbl" value="Transfer exception logged" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1648" y="309" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6.2_reclaim-water" name="3.6.2_reclaim-water"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1084" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_6_2" value="3.6.2 Reclaim Water" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1024" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_2_dcs" value="DCS / SCADA" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="984" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_2_tail" value="Tailings Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="984" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_2_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_6_2_s" target="Gw_L3_3_6_2_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_2_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_2_g" target="Task_L3_3_6_2_3_6_2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_2_2__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_2_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_2_g" target="Task_L3_3_6_2_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_2_3__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="357" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_2_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_2_n" target="End_L3_3_6_2_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_2_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_2_3_6_2_1" target="Task_L3_3_6_2_3_6_2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_2_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_2_3_6_2_2" target="End_L3_3_6_2_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_6_2_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_6_2_s__lbl" value="Reclaim water demand" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><mxCell id="Gw_L3_3_6_2_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="316" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_6_2_g__lbl" value="Pond above minimum intake level?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="245" y="20" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_6_2_3_6_2_1" label="3.6.2.1 Reclaim Water from Pond" tooltip="Barge or decant pumps lift water from the TSF pond; booster stations move it towards its users. Reclaim water quality (metals, pH, suspended solids) is sampled for process and environmental monitoring. [WATER: volume (reclaimed) | flow meter on reclaim line | continuous (1-min) | MCA WAF | NO — internal recycle; WP-07]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_6_2_3_6_2_2" label="3.6.2.2 Deliver Reclaim Water to Users" tooltip="Reclaim water is delivered to process water storage and, where configured, to the classification station or other site uses. Each delivery is metered by user so that the same water is not counted twice in the water balance. [WATER: volume (delivered per user) | flow meter per user | continuous | MCA WAF | NO — internal recycle; WP-08]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA; Water Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_6_2_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_2_e1__lbl" value="Reclaim water delivered to users" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="139" width="120" height="42" as="geometry"/></mxCell><object id="Task_L3_3_6_2_n" label="Stop reclaim pumping; alert tailings operations" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Low pond response; industry convention; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_6_2_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="529" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_2_e2__lbl" value="Reclaim suspended" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="497" y="309" width="120" height="14" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6.3_seepage-and-drainage-collection" name="3.6.3_seepage-and-drainage-collection"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_6_3" value="3.6.3 Seepage &amp; Drainage Collection" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="510" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_3_tail" value="Tailings Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1160" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_3_dcs" value="DCS / SCADA" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1160" height="340" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_3_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_6_3_s" target="Task_L3_3_6_3_3_6_3_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_3_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_3_3_6_3_1" target="Task_L3_3_6_3_3_6_3_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="454" y="105"/><mxPoint x="454" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_3_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_3_3_6_3_2" target="Gw_L3_3_6_3_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_3_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_3_g" target="Task_L3_3_6_3_3_6_3_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_3_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="787" y="255" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_3_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_3_g" target="End_L3_3_6_3_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_3_5__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="754" y="314" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_3_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_3_3_6_3_3" target="End_L3_3_6_3_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_6_3_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_6_3_s__lbl" value="Seepage and drainage flowing" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_3_3_6_3_1" label="3.6.3.1 Collect Seepage and Drainage" tooltip="Seepage and drainage are intercepted by underdrains, toe drains, cut-offs and sumps and collected in seepage ponds. Collection points are designed with the facility; additions are construction changes.&#xa;ISA-95 level: 0 / 1&#xa;Actors: Tailings Operator&#xa;Standard alignment: ISA-95 Levels 0, 1; GISTM&#xa;DDVC layer: Raw"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_6_3_3_6_3_2" label="3.6.3.2 Monitor Collection Ponds and Pumps" tooltip="Pond levels and pump states are monitored continuously, with alarms on high level. Seepage flow rates are a surveillance input to Pillar 6; pump run and fault records feed reliability (Pillar 5). [WATER: level and flow | level sensors + pump flow meters | continuous | MCA WAF | NO]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: pond_level_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_6_3_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="713" y="240" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_6_3_g__lbl" value="Pond above pump-start level?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="642" y="190" width="100" height="42" as="geometry"/></mxCell><object id="Task_L3_3_6_3_3_6_3_3" label="3.6.3.3 Pump Recovered Water to Destination" tooltip="Recovery pumps return collected water to its configured destination — the impoundment, the reclaim system, a classification station, or treatment and discharge. Volumes are recorded by destination, because each destination is a different water-balance boundary. [WATER: volume (recovered, per destination) | pump flow meters | continuous | MCA WAF | NO — WP-09]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS / SCADA; Tailings Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry); Curated (water_transfer_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="854" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_6_3_e1" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1092" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_3_e1__lbl" value="Recovered water at destination" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="309" width="120" height="28" as="geometry"/></mxCell><mxCell id="End_L3_3_6_3_e2" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="720" y="417" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_3_e2__lbl" value="Water held in pond" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="688" y="479" width="120" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6.4_process-water-supply-and-distribution" name="3.6.4_process-water-supply-and-distribution"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1084" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_6_4" value="3.6.4 Process Water Supply &amp; Distribution" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1024" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_4_ctl" value="Control Room Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="984" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_4_dcs" value="DCS Auto-control" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="984" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_4_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_6_4_s" target="Task_L3_3_6_4_3_6_4_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_4_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_4_3_6_4_1" target="Gw_L3_3_6_4_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_4_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_4_g" target="Service_L3_3_6_4_3_6_4_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_4_3__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="596" y="255" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_4_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_4_g" target="Task_L3_3_6_4_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_4_4__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="563" y="222" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_4_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_4_n" target="Service_L3_3_6_4_3_6_4_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="763" y="105"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_4_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Service_L3_3_6_4_3_6_4_2" target="End_L3_3_6_4_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_6_4_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_6_4_s__lbl" value="Plant water demand" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="309" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_4_3_6_4_1" label="3.6.4.1 Blend Water Sources in Process Water Storage" tooltip="Recovered, reclaim and seepage water fill process water storage first; makeup water tops up the balance. Storage level and water quality (suspended solids, pH, dissolved salts) are monitored, because recycled water quality affects flotation. [WATER: level and volume (process water storage) | level sensor | continuous | MCA WAF | NO — WP-11]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control; Control Room Operator&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_6_4_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="522" y="240" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_6_4_g__lbl" value="Process water storage below minimum?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="451" y="190" width="100" height="42" as="geometry"/></mxCell><object id="Service_L3_3_6_4_3_6_4_2" label="3.6.4.2 Distribute Process Water to Users" tooltip="Distribution pumps deliver process water to its users at the required pressure. Use by user (grinding, flotation, reagent make-up, wash) is metered where instruments exist; total distribution is the plant's process water use. [WATER: volume (distributed, per user) | flow meters | continuous | MCA WAF | NO — WP-10]&#xa;ISA-95 level: 1 / 2&#xa;Actors: DCS Auto-control&#xa;Standard alignment: ISA-95 Levels 1, 2; MCA WAF&#xa;DDVC layer: Raw (time-series: water_flow_telemetry)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="235" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_6_4_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="916" y="247" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_4_e__lbl" value="Process water delivered" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="309" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_4_n" label="Increase makeup draw; restrict non-essential use" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Low process water storage response; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="3.6.5_site-water-balance-and-reconciliation" name="3.6.5_site-water-balance-and-reconciliation"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1496" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Pool_L3_3_6_5" value="3.6.5 Site Water Balance &amp; Reconciliation" style="swimlane;horizontal=0;startSize=40;fontSize=12;fontStyle=1;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1436" height="340" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_5_rep" value="Water Balance Analyst" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1396" height="170" as="geometry"/></mxCell><mxCell id="Lane_L3_3_6_5_wat" value="Water Operator" style="swimlane;horizontal=0;startSize=40;fontSize=11;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1396" height="170" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_5_1" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Start_L3_3_6_5_s" target="Task_L3_3_6_5_3_6_5_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_5_2" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_5_3_6_5_1" target="Task_L3_3_6_5_3_6_5_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_5_3" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_5_3_6_5_2" target="Task_L3_3_6_5_3_6_5_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_5_4" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_5_3_6_5_3" target="Gw_L3_3_6_5_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_5_5" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_5_g" target="Task_L3_3_6_5_3_6_5_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_5_5__lbl" value="Yes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1008" y="85" width="27" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_5_6" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Gw_L3_3_6_5_g" target="Task_L3_3_6_5_n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_5_6__lbl" value="No" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="975" y="144" width="21" height="14" as="geometry"/></mxCell><mxCell id="Flow_L3_3_6_5_7" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_5_n" target="Task_L3_3_6_5_3_6_5_4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1175" y="275"/></Array></mxGeometry></mxCell><mxCell id="Flow_L3_3_6_5_8" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="Task_L3_3_6_5_3_6_5_4" target="End_L3_3_6_5_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Start_L3_3_6_5_s" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="142" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="Start_L3_3_6_5_s__lbl" value="Reporting period end" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_5_3_6_5_1" label="3.6.5.1 Compile Water Flow and Volume Data" tooltip="Period totals are compiled for every metered transfer (WP-01 to WP-10) and storage inventories (WP-11), with meter status and data gaps flagged.&#xa;ISA-95 level: 3&#xa;Actors: Water Balance Analyst&#xa;Standard alignment: ISA-95 Level 3; MCA WAF&#xa;DDVC layer: Curated (water_transfer_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="266" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_6_5_3_6_5_2" label="3.6.5.2 Apply Water System Boundaries and Allocation Rules" tooltip="Each transfer is assigned to its water system and boundary (supply, process water, tailings facility, remote locations), any shared-supply allocation is applied, and internal recycles are identified so they are not counted as inputs.&#xa;ISA-95 level: 3&#xa;Actors: Water Balance Analyst; Water Operator&#xa;Standard alignment: ISA-95 Level 3; MCA WAF&#xa;DDVC layer: Curated (water_transfer_record — allocation attribute)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="472" y="65" width="170" height="80" as="geometry"/></mxCell></object><object id="Task_L3_3_6_5_3_6_5_3" label="3.6.5.3 Close Period Water Balance" tooltip="For each water system, inputs minus outputs are compared with the change in storage; evaporation, entrainment in deposited tailings and unrecovered seepage are estimated where not measured; the remainder is the balance error, checked against tolerance.&#xa;ISA-95 level: 3&#xa;Actors: Water Balance Analyst&#xa;Standard alignment: ISA-95 Level 3; MCA WAF; ICMM water reporting guidance&#xa;DDVC layer: Curated (water_balance_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="Gw_L3_3_6_5_g" value="X" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="934" y="70" width="70" height="70" as="geometry"/></mxCell><mxCell id="Gw_L3_3_6_5_g__lbl" value="Balance within tolerance?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="863" y="34" width="100" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_5_3_6_5_4" label="3.6.5.4 Publish Water and Tailings Performance Data" tooltip="The closed water balance is released together with the period's tailings records (deposited, placed, surveyed, storage and capacity status) as the governed data for water and tailings reporting.&#xa;ISA-95 level: 3 / 4&#xa;Actors: Water Balance Analyst; Environmental Officer&#xa;Standard alignment: ISA-95 Level 4 (business reporting)&#xa;DDVC layer: Curated (water_balance_record, tailings_deposition_record)"><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="65" width="170" height="80" as="geometry"/></mxCell></object><mxCell id="End_L3_3_6_5_e" value="" style="ellipse;html=0;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1328" y="77" width="56" height="56" as="geometry"/></mxCell><mxCell id="End_L3_3_6_5_e__lbl" value="Period data published" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1296" y="139" width="120" height="28" as="geometry"/></mxCell><object id="Task_L3_3_6_5_n" label="Investigate meters, allocation and storage estimates" tooltip="Derived from the Process Flow Narratives section (not a row in the Process Decomposition). Water balance closure failure path; no L4 row."><mxCell style="rounded=1;html=0;whiteSpace=wrap;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="884" y="235" width="170" height="80" as="geometry"/></mxCell></object></root></mxGraphModel></diagram></mxfile>
