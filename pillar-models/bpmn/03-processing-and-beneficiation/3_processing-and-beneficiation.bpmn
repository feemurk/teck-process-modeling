<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L1_3" targetNamespace="https://teck.example/process-models/pillar-03">
  <bpmn:collaboration id="Collab_L1_3">
    <bpmn:participant id="Pool_L1_3" name="3 Processing &amp; Beneficiation (L1)" processRef="Process_L1_3"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L1_3" isExecutable="false">
    <bpmn:documentation>L1 Pillar. Converts ROM ore into commercial concentrate. 3.1 Comminution reduces ROM ore to flotation feed; 3.2 Concentration (Flotation) separates the commodity concentrates from tailings; 3.3 Dewatering &amp; Product Handling produces filter cake at commercial moisture and deposits tailings. 3.4 Metallurgical Accounting &amp; Quality runs alongside, collecting the mass flow, sample and assay data from 3.1 to 3.3 and closing the mass balance per shift, day and month under AMIRA P754.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L1_3">
      <bpmn:lane id="Lane_L1_3_ops" name="Control Room Operator / DCS Auto-control / Metallurgist">
        <bpmn:flowNodeRef>Start_L1_3_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L1_3_3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L1_3_3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L1_3_3_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L1_3_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L1_3_acc" name="Chief Metallurgist / Metallurgical Accounting Analyst">
        <bpmn:flowNodeRef>Sub_L1_3_3_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L1_3_e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L1_3_s" name="ROM ore at crusher (CTP-1)">
      <bpmn:outgoing>Flow_L1_3_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_L1_3_s"/>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_L1_3_3_1" name="3.1 Comminution">
      <bpmn:documentation>L2 Process Area. Progressive size reduction of ROM ore from run-of-mine fragmentation (typically P80 150–250 mm) to a target grind size suitable for flotation (P80 75–150 µm depending on ore and circuit). Encompasses primary crushing, secondary/tertiary crushing and screening where applicable, SAG and ball milling, and hydrocyclone classification.
ISA-95 level: 0–3
Actors: Plant Metallurgist; Control Room Operator; DCS Auto-control
Standard alignment: ISA-95 Levels 0–3; AMIRA P754 Principles 1, 2, 5
DDVC layer: Raw (time-series); Curated (process_node, equipment_operating_record)</bpmn:documentation>
      <bpmn:incoming>Flow_L1_3_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_3_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L1_3_3_2" name="3.2 Concentration (Flotation)">
      <bpmn:documentation>L2 Process Area. Selective separation of valuable minerals (chalcopyrite, sphalerite, galena, molybdenite) from gangue using froth flotation. Air bubbles attach to hydrophobic mineral surfaces made selective by reagents; the loaded froth overflows to concentrate while depressed gangue reports to tailings. This is the primary value-creation process in the plant — metal recovery and concentrate grade are the defining performance variables. Circuit architecture varies by commodity.
ISA-95 level: 0–3
Actors: Control Room Operator; Metallurgist; DCS Auto-control
Standard alignment: ISA-95 Levels 0–3; AMIRA P754 Principles 1, 2, 5, 6, 7
DDVC layer: Raw (time-series); Curated (concentrate_production_record, process_measurement_point)</bpmn:documentation>
      <bpmn:incoming>Flow_L1_3_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_3_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L1_3_3_3" name="3.3 Dewatering &amp; Product Handling">
      <bpmn:documentation>L2 Process Area. Reduces moisture content of flotation concentrate from slurry (~40–60% solids w/w) to filter cake suitable for transport (typically 8–12% moisture for Cu; 6–10% for Zn/Pb depending on smelter specification). Separate dewatering trains run per concentrate type. Tailings are thickened and pumped to the TSF with process water recovered.
ISA-95 level: 0–2
Actors: Control Room Operator; DCS Auto-control; Metallurgist
Standard alignment: ISA-95 Levels 0–2; AMIRA P754 Principles 1, 5, 7
DDVC layer: Raw (time-series); Curated (concentrate_production_record, process_measurement_point)</bpmn:documentation>
      <bpmn:incoming>Flow_L1_3_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L1_3_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_L1_3_e" name="Filter cake to shed (CTP-2)">
      <bpmn:incoming>Flow_L1_3_4</bpmn:incoming>
      <bpmn:messageEventDefinition id="Msg_L1_3_e"/>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_L1_3_3_4" name="3.4 Metallurgical Accounting &amp; Quality">
      <bpmn:documentation>L2/L3 Process Area. Systematic collection of representative samples, chemical analysis, and mass balance closure across the plant. Metallurgical accounting is the mechanism by which all mass flows, grades, and recoveries are reconciled to verify and report plant performance. This process area is governed end-to-end by AMIRA P754 and all 10 of its principles apply within it.
ISA-95 level: 2–3
Actors: Chief Metallurgist; Metallurgist; Plant Chemist; Metallurgical Accounting Analyst
Standard alignment: AMIRA P754 (all 10 principles); ISA-95 Levels 2, 3
DDVC layer: Raw; Curated (shift_mass_balance, metallurgical_accounting_report)</bpmn:documentation>
      <bpmn:outgoing>Flow_L1_3_8</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_L1_3_e2" name="Monthly metal accounting report filed">
      <bpmn:incoming>Flow_L1_3_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L1_3_1" sourceRef="Start_L1_3_s" targetRef="Sub_L1_3_3_1"/>
    <bpmn:sequenceFlow id="Flow_L1_3_2" sourceRef="Sub_L1_3_3_1" targetRef="Sub_L1_3_3_2"/>
    <bpmn:sequenceFlow id="Flow_L1_3_3" sourceRef="Sub_L1_3_3_2" targetRef="Sub_L1_3_3_3"/>
    <bpmn:sequenceFlow id="Flow_L1_3_4" sourceRef="Sub_L1_3_3_3" targetRef="End_L1_3_e"/>
    <bpmn:association id="Assoc_L1_3_5" associationDirection="One" sourceRef="Sub_L1_3_3_1" targetRef="Sub_L1_3_3_4"/>
    <bpmn:association id="Assoc_L1_3_6" associationDirection="One" sourceRef="Sub_L1_3_3_2" targetRef="Sub_L1_3_3_4"/>
    <bpmn:association id="Assoc_L1_3_7" associationDirection="One" sourceRef="Sub_L1_3_3_3" targetRef="Sub_L1_3_3_4"/>
    <bpmn:sequenceFlow id="Flow_L1_3_8" sourceRef="Sub_L1_3_3_4" targetRef="End_L1_3_e2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L1_3">
    <bpmndi:BPMNPlane id="Plane_L1_3" bpmnElement="Collab_L1_3">
      <bpmndi:BPMNShape id="Pool_L1_3_di" bpmnElement="Pool_L1_3" isHorizontal="true"><dc:Bounds x="20" y="20" width="916" height="510"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L1_3_ops_di" bpmnElement="Lane_L1_3_ops" isHorizontal="true"><dc:Bounds x="60" y="20" width="876" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L1_3_acc_di" bpmnElement="Lane_L1_3_acc" isHorizontal="true"><dc:Bounds x="60" y="190" width="876" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L1_3_s_di" bpmnElement="Start_L1_3_s"><dc:Bounds x="110" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="139" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L1_3_3_1_di" bpmnElement="Sub_L1_3_3_1" isExpanded="false"><dc:Bounds x="202" y="57" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L1_3_3_2_di" bpmnElement="Sub_L1_3_3_2" isExpanded="false"><dc:Bounds x="408" y="57" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L1_3_3_3_di" bpmnElement="Sub_L1_3_3_3" isExpanded="false"><dc:Bounds x="614" y="57" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L1_3_e_di" bpmnElement="End_L1_3_e"><dc:Bounds x="820" y="77" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="798" y="139" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L1_3_3_4_di" bpmnElement="Sub_L1_3_3_4" isExpanded="false"><dc:Bounds x="408" y="227" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L1_3_e2_di" bpmnElement="End_L1_3_e2"><dc:Bounds x="820" y="417" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="798" y="479" width="100" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L1_3_1_di" bpmnElement="Flow_L1_3_1"><di:waypoint x="166" y="105"/><di:waypoint x="202" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L1_3_2_di" bpmnElement="Flow_L1_3_2"><di:waypoint x="372" y="105"/><di:waypoint x="408" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L1_3_3_di" bpmnElement="Flow_L1_3_3"><di:waypoint x="578" y="105"/><di:waypoint x="614" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L1_3_4_di" bpmnElement="Flow_L1_3_4"><di:waypoint x="784" y="105"/><di:waypoint x="820" y="105"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_L1_3_5_di" bpmnElement="Assoc_L1_3_5"><di:waypoint x="287" y="153"/><di:waypoint x="287" y="275"/><di:waypoint x="408" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_L1_3_6_di" bpmnElement="Assoc_L1_3_6"><di:waypoint x="493" y="153"/><di:waypoint x="493" y="227"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_L1_3_7_di" bpmnElement="Assoc_L1_3_7"><di:waypoint x="699" y="153"/><di:waypoint x="699" y="275"/><di:waypoint x="578" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L1_3_8_di" bpmnElement="Flow_L1_3_8"><di:waypoint x="493" y="323"/><di:waypoint x="493" y="445"/><di:waypoint x="820" y="445"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
