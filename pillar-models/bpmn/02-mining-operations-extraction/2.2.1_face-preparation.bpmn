<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L3_2_2_1" targetNamespace="https://teck.example/process-models/pillar-02">
  <bpmn:collaboration id="Collab_L3_2_2_1">
    <bpmn:participant id="Pool_L3_2_2_1" name="2.2.1 Face Preparation" processRef="Process_L3_2_2_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L3_2_2_1" isExecutable="false">
    <bpmn:documentation>L0/L2 Process. Before loading commences, the dig face must be accessible and in safe, loadable condition. Shovel tramming and dozer face clean-up are the preparatory activities.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L3_2_2_1">
      <bpmn:lane id="Lane_L3_2_2_1_sv" name="Shovel Operator">
        <bpmn:flowNodeRef>Start_L3_2_2_1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_2_2_1_2_2_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L3_2_2_1_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L3_2_2_1_dz" name="Dozer Operator">
        <bpmn:flowNodeRef>Task_L3_2_2_1_2_2_1_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L3_2_2_1_s" name="Blast cleared; face assigned">
      <bpmn:outgoing>Flow_L3_2_2_1_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_L3_2_2_1_2_2_1_1" name="2.2.1.1 Tram Shovel to Dig Face">
      <bpmn:documentation>Shovel operator receives face assignment from FMS or mine controller and tramways the shovel to the assigned dig face. Tramming is Non-Productive Operating Time (NP) per GMG TUM. FMS tracks shovel GPS position continuously.
ISA-95 level: 2 / 0
Actors: Shovel Operator
Standard alignment: GMG TUM (NP — non-primary function transit); GMG Mobile Equipment Open Data
DDVC layer: Raw</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_2_1_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_2_1_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L3_2_2_1_2_2_1_2" name="2.2.1.2 Clean and Dress Dig Face">
      <bpmn:documentation>Dozer operator pushes and grades loose material at the face to create a stable standing area for the shovel and approach ramp for haul trucks. Dozer performing this function is classified as WT (Working Time) — it is performing its primary function. Face clean-up completion confirmed by shovel operator before loading commences.
ISA-95 level: 0
Actors: Dozer Operator; Shovel Operator
Standard alignment: GMG TUM (WT for dozer); GMG Mobile Equipment Open Data
DDVC layer: Raw</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_2_1_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_2_1_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_L3_2_2_1_e" name="Face ready for loading">
      <bpmn:incoming>Flow_L3_2_2_1_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L3_2_2_1_1" sourceRef="Start_L3_2_2_1_s" targetRef="Task_L3_2_2_1_2_2_1_1"/>
    <bpmn:sequenceFlow id="Flow_L3_2_2_1_2" sourceRef="Task_L3_2_2_1_2_2_1_1" targetRef="Task_L3_2_2_1_2_2_1_2"/>
    <bpmn:sequenceFlow id="Flow_L3_2_2_1_3" sourceRef="Task_L3_2_2_1_2_2_1_2" targetRef="End_L3_2_2_1_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L3_2_2_1">
    <bpmndi:BPMNPlane id="Plane_L3_2_2_1" bpmnElement="Collab_L3_2_2_1">
      <bpmndi:BPMNShape id="Pool_L3_2_2_1_di" bpmnElement="Pool_L3_2_2_1" isHorizontal="true"><dc:Bounds x="20" y="20" width="674" height="400"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_2_1_sv_di" bpmnElement="Lane_L3_2_2_1_sv" isHorizontal="true"><dc:Bounds x="60" y="20" width="634" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_2_1_dz_di" bpmnElement="Lane_L3_2_2_1_dz" isHorizontal="true"><dc:Bounds x="60" y="220" width="634" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_2_2_1_s_di" bpmnElement="Start_L3_2_2_1_s"><dc:Bounds x="110" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="149" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_2_1_2_2_1_1_di" bpmnElement="Task_L3_2_2_1_2_2_1_1"><dc:Bounds x="202" y="75" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_2_1_2_2_1_2_di" bpmnElement="Task_L3_2_2_1_2_2_1_2"><dc:Bounds x="408" y="275" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_2_2_1_e_di" bpmnElement="End_L3_2_2_1_e"><dc:Bounds x="614" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="602" y="149" width="80" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_1_1_di" bpmnElement="Flow_L3_2_2_1_1"><di:waypoint x="166" y="115"/><di:waypoint x="202" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_1_2_di" bpmnElement="Flow_L3_2_2_1_2"><di:waypoint x="372" y="115"/><di:waypoint x="390" y="115"/><di:waypoint x="390" y="315"/><di:waypoint x="408" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_1_3_di" bpmnElement="Flow_L3_2_2_1_3"><di:waypoint x="578" y="315"/><di:waypoint x="596" y="315"/><di:waypoint x="596" y="115"/><di:waypoint x="614" y="115"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
