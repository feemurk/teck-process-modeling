<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L3_2_3_2" targetNamespace="https://teck.example/process-models/pillar-02">
  <bpmn:collaboration id="Collab_L3_2_3_2">
    <bpmn:participant id="Pool_L3_2_3_2" name="2.3.2 Pit Dewatering" processRef="Process_L3_2_3_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L3_2_3_2" isExecutable="false">
    <bpmn:documentation>L0/L1/L2 Process. Accumulates water is pumped from the active pit to surface via submersible sump pumps and dewatering bores. Failure to dewater effectively results in bench instability, haul road damage, and blast design constraint.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L3_2_3_2">
      <bpmn:lane id="Lane_L3_2_3_2_dw" name="Dewatering Operator / SCADA">
        <bpmn:flowNodeRef>Start_L3_2_3_2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_L3_2_3_2_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_L3_2_3_2_2_3_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_L3_2_3_2_2_3_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_L3_2_3_2_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L3_2_3_2_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L3_2_3_2_s" name="Sump level above setpoint">
      <bpmn:outgoing>Flow_L3_2_3_2_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Par_L3_2_3_2_f" name="Fork">
      <bpmn:incoming>Flow_L3_2_3_2_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_3_2_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_L3_2_3_2_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Service_L3_2_3_2_2_3_2_1" name="2.3.2.1 Operate Sump Pump">
      <bpmn:documentation>Submersible pump(s) continuously or intermittently pump accumulated water from the pit sump to a surface discharge point. Operation is automated via level switch or SCADA control, with manual override. Pump telemetry (flow rate, discharge pressure, motor current, run hours) is logged to PI Historian. Sump water level measured by float switch or ultrasonic level sensor.
ISA-95 level: 1 / 0
Actors: Dewatering Operator; Automated SCADA
Standard alignment: ISA-95 Levels 1, 2
DDVC layer: Raw (time-series: dewatering_pump_telemetry)</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_3_2_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_3_2_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_L3_2_3_2_2_3_2_2" name="2.3.2.2 Operate Dewatering Bore">
      <bpmn:documentation>Vertical dewatering bores pump groundwater from the aquifer layer, reducing pore water pressure in pit walls and improving slope stability. Bore pump operation typically automated. Bore pump telemetry logged to PI Historian. Bore water chemistry may be sampled periodically for regulatory compliance.
ISA-95 level: 1 / 0
Actors: Dewatering Operator; Automated SCADA
Standard alignment: ISA-95 Levels 1, 2
DDVC layer: Raw (time-series: dewatering_pump_telemetry)</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_3_2_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_3_2_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Par_L3_2_3_2_j" name="Join">
      <bpmn:incoming>Flow_L3_2_3_2_4</bpmn:incoming>
      <bpmn:incoming>Flow_L3_2_3_2_5</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_3_2_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_L3_2_3_2_e" name="Water pumped to surface">
      <bpmn:incoming>Flow_L3_2_3_2_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L3_2_3_2_1" sourceRef="Start_L3_2_3_2_s" targetRef="Par_L3_2_3_2_f"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_2_2" sourceRef="Par_L3_2_3_2_f" targetRef="Service_L3_2_3_2_2_3_2_1"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_2_3" sourceRef="Par_L3_2_3_2_f" targetRef="Service_L3_2_3_2_2_3_2_2"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_2_4" sourceRef="Service_L3_2_3_2_2_3_2_1" targetRef="Par_L3_2_3_2_j"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_2_5" sourceRef="Service_L3_2_3_2_2_3_2_2" targetRef="Par_L3_2_3_2_j"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_2_6" sourceRef="Par_L3_2_3_2_j" targetRef="End_L3_2_3_2_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L3_2_3_2">
    <bpmndi:BPMNPlane id="Plane_L3_2_3_2" bpmnElement="Collab_L3_2_3_2">
      <bpmndi:BPMNShape id="Pool_L3_2_3_2_di" bpmnElement="Pool_L3_2_3_2" isHorizontal="true"><dc:Bounds x="20" y="20" width="680" height="310"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_3_2_dw_di" bpmnElement="Lane_L3_2_3_2_dw" isHorizontal="true"><dc:Bounds x="60" y="20" width="640" height="310"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_2_3_2_s_di" bpmnElement="Start_L3_2_3_2_s"><dc:Bounds x="110" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="149" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Par_L3_2_3_2_f_di" bpmnElement="Par_L3_2_3_2_f"><dc:Bounds x="202" y="80" width="70" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Service_L3_2_3_2_2_3_2_1_di" bpmnElement="Service_L3_2_3_2_2_3_2_1"><dc:Bounds x="308" y="75" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Service_L3_2_3_2_2_3_2_2_di" bpmnElement="Service_L3_2_3_2_2_3_2_2"><dc:Bounds x="308" y="200" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Par_L3_2_3_2_j_di" bpmnElement="Par_L3_2_3_2_j"><dc:Bounds x="514" y="80" width="70" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_2_3_2_e_di" bpmnElement="End_L3_2_3_2_e"><dc:Bounds x="620" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="598" y="149" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_2_1_di" bpmnElement="Flow_L3_2_3_2_1"><di:waypoint x="166" y="115"/><di:waypoint x="202" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_2_2_di" bpmnElement="Flow_L3_2_3_2_2"><di:waypoint x="272" y="115"/><di:waypoint x="308" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_2_3_di" bpmnElement="Flow_L3_2_3_2_3"><di:waypoint x="237" y="150"/><di:waypoint x="237" y="240"/><di:waypoint x="308" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_2_4_di" bpmnElement="Flow_L3_2_3_2_4"><di:waypoint x="478" y="115"/><di:waypoint x="514" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_2_5_di" bpmnElement="Flow_L3_2_3_2_5"><di:waypoint x="478" y="240"/><di:waypoint x="549" y="240"/><di:waypoint x="549" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_2_6_di" bpmnElement="Flow_L3_2_3_2_6"><di:waypoint x="584" y="115"/><di:waypoint x="620" y="115"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
