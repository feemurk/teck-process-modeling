<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L3_2_1_5" targetNamespace="https://teck.example/process-models/pillar-02">
  <bpmn:collaboration id="Collab_L3_2_1_5">
    <bpmn:participant id="Pool_L3_2_1_5" name="2.1.5 Muck Pile Preparation" processRef="Process_L3_2_1_5"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L3_2_1_5" isExecutable="false">
    <bpmn:documentation>L3/L1 Process. Before loading commences, grade control sampling is performed on the muck pile surface and domain model is used to designate each zone as ore, marginal ore, or waste. Material destination is assigned and communicated to dispatch. This is the final ore/waste classification gate before material enters the load &amp; haul cycle.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L3_2_1_5">
      <bpmn:lane id="Lane_L3_2_1_5_gc" name="Grade Control Geologist">
        <bpmn:flowNodeRef>Start_L3_2_1_5_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_2_1_5_2_1_5_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_L3_2_1_5_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_2_1_5_2_1_5_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L3_2_1_5_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L3_2_1_5_s" name="Post-blast safety clearance issued">
      <bpmn:outgoing>Flow_L3_2_1_5_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_L3_2_1_5_2_1_5_1" name="2.1.5.1 Collect Grade Control Samples">
      <bpmn:documentation>Grade control geologist collects chip or channel samples from muck pile surfaces according to a pre-defined sampling grid aligned to the blast pattern. Samples are assigned unique identifiers, placed in labeled sample bags, and submitted to the on-site laboratory. [COPPER NOTE: At QB and HVC, rotary drill cuttings from production drilling may substitute for or supplement surface chip samples.]
ISA-95 level: 1 / 3
Actors: Grade Control Geologist
Standard alignment: ISA-95 Level 1 (sensing/sampling); AMIRA P754 Principle 6 (representative sampling)
DDVC layer: Raw; Curated (grade_control_sample)</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_1_5_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_1_5_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_L3_2_1_5_c" name="Lab assays returned">
      <bpmn:incoming>Flow_L3_2_1_5_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_1_5_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_L3_2_1_5_c"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_L3_2_1_5_2_1_5_2" name="2.1.5.2 Classify Material and Assign Destination">
      <bpmn:documentation>Grade control geologist reconciles laboratory assay results against the cut-off grade to classify each zone of the muck pile as ore, marginal ore, or waste. Material destination is assigned per zone and uploaded to FMS as dispatch instructions. [COPPER NOTE: Cu cut-off grade applied (e.g., 0.15–0.20% Cu at HVC). ZINC NOTE: Zn cut-off grade applied (e.g., 3–5% Zn at Red Dog). Marginal ore may be stockpiled for future reprocessing.]
ISA-95 level: 3
Actors: Grade Control Geologist; Mine Geologist
Standard alignment: ISA-95 Level 3; AMIRA P754 Principle 2 (transparent accounting)
DDVC layer: Raw; Curated (material_classification)</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_1_5_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_1_5_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_L3_2_1_5_e" name="Material classified and dispatched">
      <bpmn:incoming>Flow_L3_2_1_5_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L3_2_1_5_1" sourceRef="Start_L3_2_1_5_s" targetRef="Task_L3_2_1_5_2_1_5_1"/>
    <bpmn:sequenceFlow id="Flow_L3_2_1_5_2" sourceRef="Task_L3_2_1_5_2_1_5_1" targetRef="Catch_L3_2_1_5_c"/>
    <bpmn:sequenceFlow id="Flow_L3_2_1_5_3" sourceRef="Catch_L3_2_1_5_c" targetRef="Task_L3_2_1_5_2_1_5_2"/>
    <bpmn:sequenceFlow id="Flow_L3_2_1_5_4" sourceRef="Task_L3_2_1_5_2_1_5_2" targetRef="End_L3_2_1_5_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L3_2_1_5">
    <bpmndi:BPMNPlane id="Plane_L3_2_1_5" bpmnElement="Collab_L3_2_1_5">
      <bpmndi:BPMNShape id="Pool_L3_2_1_5_di" bpmnElement="Pool_L3_2_1_5" isHorizontal="true"><dc:Bounds x="20" y="20" width="766" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_1_5_gc_di" bpmnElement="Lane_L3_2_1_5_gc" isHorizontal="true"><dc:Bounds x="60" y="20" width="726" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_2_1_5_s_di" bpmnElement="Start_L3_2_1_5_s"><dc:Bounds x="110" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="149" width="100" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_1_5_2_1_5_1_di" bpmnElement="Task_L3_2_1_5_2_1_5_1"><dc:Bounds x="202" y="75" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_L3_2_1_5_c_di" bpmnElement="Catch_L3_2_1_5_c"><dc:Bounds x="408" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="386" y="149" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_1_5_2_1_5_2_di" bpmnElement="Task_L3_2_1_5_2_1_5_2"><dc:Bounds x="500" y="75" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_2_1_5_e_di" bpmnElement="End_L3_2_1_5_e"><dc:Bounds x="706" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="684" y="149" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_5_1_di" bpmnElement="Flow_L3_2_1_5_1"><di:waypoint x="166" y="115"/><di:waypoint x="202" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_5_2_di" bpmnElement="Flow_L3_2_1_5_2"><di:waypoint x="372" y="115"/><di:waypoint x="408" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_5_3_di" bpmnElement="Flow_L3_2_1_5_3"><di:waypoint x="464" y="115"/><di:waypoint x="500" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_5_4_di" bpmnElement="Flow_L3_2_1_5_4"><di:waypoint x="670" y="115"/><di:waypoint x="706" y="115"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
