<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L2_2_1" targetNamespace="https://teck.example/process-models/pillar-02">
  <bpmn:collaboration id="Collab_L2_2_1">
    <bpmn:participant id="Pool_L2_2_1" name="2.1 Drill &amp; Blast (L2)" processRef="Process_L2_2_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L2_2_1" isExecutable="false">
    <bpmn:documentation>L2 Process Area. Converts in-situ rock into fragmented muck available for loading. Encompasses design, drilling, charging, detonation, and post-blast classification.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L2_2_1">
      <bpmn:lane id="Lane_L2_2_1_eng" name="Drill &amp; Blast Engineer">
        <bpmn:flowNodeRef>Start_L2_2_1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_2_1_2_1_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_2_1_rig" name="Drill Rig Operator">
        <bpmn:flowNodeRef>Sub_L2_2_1_2_1_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_2_1_sf" name="Shot-firer">
        <bpmn:flowNodeRef>Sub_L2_2_1_2_1_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_2_1_2_1_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_2_1_gc" name="Grade Control Geologist">
        <bpmn:flowNodeRef>Sub_L2_2_1_2_1_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L2_2_1_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L2_2_1_s" name="Short-term plan released">
      <bpmn:outgoing>Flow_L2_2_1_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_L2_2_1_2_1_1" name="2.1.1 Blast Design &amp; Pattern Layout">
      <bpmn:documentation>L3 Process. Translates the approved dig polygon and bench design into a drillable blast pattern, defining hole spacing, burden, depth, and explosive specifications. Produces the pattern design file consumed by the drill guidance system.
ISA-95 level: 3
Actors: Drill &amp; Blast Engineer
Standard alignment: ISA-95 Part 3 (Level 3 — operations planning)
DDVC layer: Raw; Curated (blast_pattern master)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_1_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_1_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_2_1_2_1_2" name="2.1.2 Drilling Execution">
      <bpmn:documentation>L3/L2/L1/L0 Process. Physical drilling of each hole in the approved pattern, generating Measure-While-Drilling (MWD) telemetry as the primary high-frequency data output. Drill guidance systems navigate rigs to collar coordinates and capture downhole data in real time.
ISA-95 level: 0–2
Actors: Drill Rig Operator; Drill &amp; Blast Supervisor
Standard alignment: GMG TUM; GMG Mobile Equipment Open Data; ISA-95 Levels 0–2
DDVC layer: Raw (high-frequency); Curated (drill_hole, mobile_equipment)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_1_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_1_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_2_1_2_1_3" name="2.1.3 Charging &amp; Stemming">
      <bpmn:documentation>L0/L3 Process. Explosives are loaded into drilled holes according to the approved design, followed by stemming. Explosive truck (bulk delivery vehicle) is dispatched via FMS. Quantities loaded per hole constitute the data record for explosive consumption and compliance.
ISA-95 level: 0–3
Actors: Shot-firer (Blaster); Explosive Truck Operator
Standard alignment: ISA-95 Levels 0, 3; AMIRA P754 Principle 1
DDVC layer: Raw; Curated (blast_pattern, explosive_product)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_1_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_1_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_2_1_2_1_4" name="2.1.4 Detonation &amp; Assessment">
      <bpmn:documentation>L0/L3 Process. Controlled detonation of the charged blast pattern and systematic post-blast assessment of fragmentation outcome, safety clearance, and muck pile geometry. Fragmentation assessment data feeds back into drill design optimization.
ISA-95 level: 0–3
Actors: Shot-firer; Drill &amp; Blast Superintendent
Standard alignment: ISA-95 Levels 0, 3; GMG TUM
DDVC layer: Raw; Curated (blast_event)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_1_4</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_1_5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_2_1_2_1_5" name="2.1.5 Muck Pile Preparation">
      <bpmn:documentation>L3/L1 Process. Before loading commences, grade control sampling is performed on the muck pile surface and domain model is used to designate each zone as ore, marginal ore, or waste. Material destination is assigned and communicated to dispatch. This is the final ore/waste classification gate before material enters the load &amp; haul cycle.
ISA-95 level: 1–3
Actors: Grade Control Geologist; Mine Geologist
Standard alignment: ISA-95 Level 3; GMG TUM
DDVC layer: Raw; Curated (grade_control_sample, material_classification)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_1_5</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_1_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_L2_2_1_e" name="Classified muck ready for loading">
      <bpmn:incoming>Flow_L2_2_1_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L2_2_1_1" sourceRef="Start_L2_2_1_s" targetRef="Sub_L2_2_1_2_1_1"/>
    <bpmn:sequenceFlow id="Flow_L2_2_1_2" sourceRef="Sub_L2_2_1_2_1_1" targetRef="Sub_L2_2_1_2_1_2"/>
    <bpmn:sequenceFlow id="Flow_L2_2_1_3" sourceRef="Sub_L2_2_1_2_1_2" targetRef="Sub_L2_2_1_2_1_3"/>
    <bpmn:sequenceFlow id="Flow_L2_2_1_4" sourceRef="Sub_L2_2_1_2_1_3" targetRef="Sub_L2_2_1_2_1_4"/>
    <bpmn:sequenceFlow id="Flow_L2_2_1_5" sourceRef="Sub_L2_2_1_2_1_4" targetRef="Sub_L2_2_1_2_1_5"/>
    <bpmn:sequenceFlow id="Flow_L2_2_1_6" sourceRef="Sub_L2_2_1_2_1_5" targetRef="End_L2_2_1_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L2_2_1">
    <bpmndi:BPMNPlane id="Plane_L2_2_1" bpmnElement="Collab_L2_2_1">
      <bpmndi:BPMNShape id="Pool_L2_2_1_di" bpmnElement="Pool_L2_2_1" isHorizontal="true"><dc:Bounds x="20" y="20" width="1292" height="800"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_1_eng_di" bpmnElement="Lane_L2_2_1_eng" isHorizontal="true"><dc:Bounds x="60" y="20" width="1252" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_1_rig_di" bpmnElement="Lane_L2_2_1_rig" isHorizontal="true"><dc:Bounds x="60" y="220" width="1252" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_1_sf_di" bpmnElement="Lane_L2_2_1_sf" isHorizontal="true"><dc:Bounds x="60" y="420" width="1252" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_1_gc_di" bpmnElement="Lane_L2_2_1_gc" isHorizontal="true"><dc:Bounds x="60" y="620" width="1252" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L2_2_1_s_di" bpmnElement="Start_L2_2_1_s"><dc:Bounds x="110" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="149" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_1_2_1_1_di" bpmnElement="Sub_L2_2_1_2_1_1" isExpanded="false"><dc:Bounds x="202" y="67" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_1_2_1_2_di" bpmnElement="Sub_L2_2_1_2_1_2" isExpanded="false"><dc:Bounds x="408" y="267" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_1_2_1_3_di" bpmnElement="Sub_L2_2_1_2_1_3" isExpanded="false"><dc:Bounds x="614" y="467" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_1_2_1_4_di" bpmnElement="Sub_L2_2_1_2_1_4" isExpanded="false"><dc:Bounds x="820" y="467" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_1_2_1_5_di" bpmnElement="Sub_L2_2_1_2_1_5" isExpanded="false"><dc:Bounds x="1026" y="667" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L2_2_1_e_di" bpmnElement="End_L2_2_1_e"><dc:Bounds x="1232" y="687" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="1210" y="749" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L2_2_1_1_di" bpmnElement="Flow_L2_2_1_1"><di:waypoint x="166" y="115"/><di:waypoint x="202" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_1_2_di" bpmnElement="Flow_L2_2_1_2"><di:waypoint x="372" y="115"/><di:waypoint x="390" y="115"/><di:waypoint x="390" y="315"/><di:waypoint x="408" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_1_3_di" bpmnElement="Flow_L2_2_1_3"><di:waypoint x="578" y="315"/><di:waypoint x="596" y="315"/><di:waypoint x="596" y="515"/><di:waypoint x="614" y="515"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_1_4_di" bpmnElement="Flow_L2_2_1_4"><di:waypoint x="784" y="515"/><di:waypoint x="820" y="515"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_1_5_di" bpmnElement="Flow_L2_2_1_5"><di:waypoint x="990" y="515"/><di:waypoint x="1008" y="515"/><di:waypoint x="1008" y="715"/><di:waypoint x="1026" y="715"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_1_6_di" bpmnElement="Flow_L2_2_1_6"><di:waypoint x="1196" y="715"/><di:waypoint x="1232" y="715"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
