<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L3_2_3_1" targetNamespace="https://teck.example/process-models/pillar-02">
  <bpmn:collaboration id="Collab_L3_2_3_1">
    <bpmn:participant id="Pool_L3_2_3_1" name="2.3.1 Haul Road Maintenance" processRef="Process_L3_2_3_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L3_2_3_1" isExecutable="false">
    <bpmn:documentation>L0/L2 Process. Haul road condition directly affects truck speed, tyre life, and fuel consumption. Grading and dust suppression are the two primary maintenance activities.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L3_2_3_1">
      <bpmn:lane id="Lane_L3_2_3_1_sup" name="Services Supervisor">
        <bpmn:flowNodeRef>Start_L3_2_3_1_s</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L3_2_3_1_op" name="Road Maintenance Operator">
        <bpmn:flowNodeRef>Task_L3_2_3_1_2_3_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_2_3_1_2_3_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_L3_2_3_1_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L3_2_3_1_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L3_2_3_1_s" name="Shift start or road condition call">
      <bpmn:outgoing>Flow_L3_2_3_1_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_L3_2_3_1_2_3_1_1" name="2.3.1.1 Grade Haul Road Surface">
      <bpmn:documentation>Motor grader operator systematically grades haul road segments to remove ruts, loose material, and corrugation, restoring a smooth, correctly cambered running surface. Grader performing road maintenance is classified WT per GMG TUM. Road segment graded, operator, and duration are the key data outputs.
ISA-95 level: 0 / 2
Actors: Road Maintenance Operator
Standard alignment: GMG TUM (WT for grader — primary function); GMG Mobile Equipment Open Data
DDVC layer: Raw</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_3_1_1</bpmn:incoming>
      <bpmn:incoming>Flow_L3_2_3_1_4</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_3_1_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L3_2_3_1_2_3_1_2" name="2.3.1.2 Apply Dust Suppression">
      <bpmn:documentation>Water truck operator applies water to haul road surfaces to suppress dust generated by truck traffic, improving visibility and reducing airborne particulate matter. Water truck performing dust suppression is classified WT per GMG TUM. Volume of water applied per road segment is a reportable environmental data point in some jurisdictions.
ISA-95 level: 0 / 2
Actors: Road Maintenance Operator
Standard alignment: GMG TUM (WT for water truck — primary function)
DDVC layer: Raw</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_3_1_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_3_1_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_L3_2_3_1_g" name="More segments?" default="Flow_L3_2_3_1_5">
      <bpmn:incoming>Flow_L3_2_3_1_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_3_1_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_L3_2_3_1_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_L3_2_3_1_e" name="Road maintenance records submitted">
      <bpmn:incoming>Flow_L3_2_3_1_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L3_2_3_1_1" sourceRef="Start_L3_2_3_1_s" targetRef="Task_L3_2_3_1_2_3_1_1"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_1_2" sourceRef="Task_L3_2_3_1_2_3_1_1" targetRef="Task_L3_2_3_1_2_3_1_2"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_1_3" sourceRef="Task_L3_2_3_1_2_3_1_2" targetRef="Gw_L3_2_3_1_g"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_1_4" name="Yes" sourceRef="Gw_L3_2_3_1_g" targetRef="Task_L3_2_3_1_2_3_1_1"/>
    <bpmn:sequenceFlow id="Flow_L3_2_3_1_5" name="No" sourceRef="Gw_L3_2_3_1_g" targetRef="End_L3_2_3_1_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L3_2_3_1">
    <bpmndi:BPMNPlane id="Plane_L3_2_3_1" bpmnElement="Collab_L3_2_3_1">
      <bpmndi:BPMNShape id="Pool_L3_2_3_1_di" bpmnElement="Pool_L3_2_3_1" isHorizontal="true"><dc:Bounds x="20" y="36" width="808" height="430"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_3_1_sup_di" bpmnElement="Lane_L3_2_3_1_sup" isHorizontal="true"><dc:Bounds x="60" y="36" width="768" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_3_1_op_di" bpmnElement="Lane_L3_2_3_1_op" isHorizontal="true"><dc:Bounds x="60" y="236" width="768" height="230"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_2_3_1_s_di" bpmnElement="Start_L3_2_3_1_s"><dc:Bounds x="110" y="103" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="98" y="165" width="80" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_3_1_2_3_1_1_di" bpmnElement="Task_L3_2_3_1_2_3_1_1"><dc:Bounds x="202" y="291" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_3_1_2_3_1_2_di" bpmnElement="Task_L3_2_3_1_2_3_1_2"><dc:Bounds x="408" y="291" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L3_2_3_1_g_di" bpmnElement="Gw_L3_2_3_1_g" isMarkerVisible="true"><dc:Bounds x="614" y="296" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="599" y="372" width="100" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_2_3_1_e_di" bpmnElement="End_L3_2_3_1_e"><dc:Bounds x="748" y="303" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="726" y="365" width="100" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_1_1_di" bpmnElement="Flow_L3_2_3_1_1"><di:waypoint x="166" y="131"/><di:waypoint x="184" y="131"/><di:waypoint x="184" y="331"/><di:waypoint x="202" y="331"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_1_2_di" bpmnElement="Flow_L3_2_3_1_2"><di:waypoint x="372" y="331"/><di:waypoint x="408" y="331"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_1_3_di" bpmnElement="Flow_L3_2_3_1_3"><di:waypoint x="578" y="331"/><di:waypoint x="614" y="331"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_1_4_di" bpmnElement="Flow_L3_2_3_1_4"><di:waypoint x="649" y="296"/><di:waypoint x="649" y="20"/><di:waypoint x="287" y="20"/><di:waypoint x="287" y="291"/><bpmndi:BPMNLabel><dc:Bounds x="655" y="276" width="28" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_3_1_5_di" bpmnElement="Flow_L3_2_3_1_5"><di:waypoint x="684" y="331"/><di:waypoint x="748" y="331"/><bpmndi:BPMNLabel><dc:Bounds x="688" y="311" width="21" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
