<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L2_2_2" targetNamespace="https://teck.example/process-models/pillar-02">
  <bpmn:collaboration id="Collab_L2_2_2">
    <bpmn:participant id="Pool_L2_2_2" name="2.2 Load &amp; Haul (L2)" processRef="Process_L2_2_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L2_2_2" isExecutable="false">
    <bpmn:documentation>L2 Process Area. The primary material movement cycle: excavation of classified muck from dig face, loading into haul trucks, haulage to designated destination, and dumping. This is the 90-day proof-of-value anchor for the MFD data product. All time classification governed by GMG TUM.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L2_2_2">
      <bpmn:lane id="Lane_L2_2_2_mc" name="Mine Controller / FMS">
        <bpmn:flowNodeRef>Start_L2_2_2_s</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_2_2_sd" name="Shovel &amp; Dozer Operators">
        <bpmn:flowNodeRef>Sub_L2_2_2_2_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_L2_2_2_2_2_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_2_2_tr" name="Truck Operator">
        <bpmn:flowNodeRef>Sub_L2_2_2_2_2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_L2_2_2_g</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2_2_2_sp" name="Stockpile Controller">
        <bpmn:flowNodeRef>Sub_L2_2_2_2_2_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L2_2_2_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L2_2_2_s" name="Shift start; face assigned">
      <bpmn:outgoing>Flow_L2_2_2_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_L2_2_2_2_2_1" name="2.2.1 Face Preparation">
      <bpmn:documentation>L0/L2 Process. Before loading commences, the dig face must be accessible and in safe, loadable condition. Shovel tramming and dozer face clean-up are the preparatory activities.
ISA-95 level: 0–2
Actors: Shovel Operator; Dozer Operator; Mine Controller
Standard alignment: GMG TUM; ISA-95 Levels 0, 2
DDVC layer: Raw</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_2_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_2_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_2_2_2_2_2" name="2.2.2 Loading">
      <bpmn:documentation>L0/L1/L2/L3 Process. Core value-adding cycle at the dig face: trucks arrive, queue, spot, receive payload from shovel, payload verified, destination assigned. Payload measurement via strut pressure sensors is the primary mass data source. The haul cycle event record is initiated here.
ISA-95 level: 0–3
Actors: Shovel Operator; Truck Operator; Mine Controller
Standard alignment: GMG TUM; GMG Mobile Equipment Open Data; ISA-95 Levels 0–3
DDVC layer: Raw; Curated (haul_cycle, haul_truck_load_event)</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_2_2</bpmn:incoming>
      <bpmn:incoming>Flow_L2_2_2_5</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_2_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_L2_2_2_2_2_3" name="2.2.3 Hauling">
      <bpmn:documentation>L0/L1/L2/L3 Process. Truck executes loaded haul to assigned destination, dumps, and returns empty. Generates the majority of haul truck telemetry. Each complete cycle (spot → load → haul → dump → return) constitutes one haul_cycle entity instance.
ISA-95 level: 0–3
Actors: Truck Operator; Mine Controller
Standard alignment: GMG TUM; GMG Mobile Equipment Open Data; ISA-95 Levels 0–3
DDVC layer: Raw (haul_truck_telemetry); Curated (haul_cycle)
Includes the runtime destination decision: crusher / stockpile / waste routing, mine-controller override (Pillar 1 1.4.3.2) and the stockpile build credit (2.2.4.1).</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_2_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_2_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_L2_2_2_g" name="Cycle repeats?" default="Flow_L2_2_2_6">
      <bpmn:incoming>Flow_L2_2_2_4</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_2_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_L2_2_2_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_L2_2_2_2_2_4" name="2.2.4 Stockpile Management">
      <bpmn:documentation>L3/L0 Process. ROM ore and marginal ore delivered by haul trucks to stockpile locations is tracked, graded, and managed to enable blending to mill feed targets. Stockpile inventory bridges Mine Operations and Processing — it is an internal custody transfer point.
ISA-95 level: 0–3
Actors: Stockpile Controller; Mine Planner; Geologist
Standard alignment: ISA-95 Level 3; AMIRA P754 Principles 1, 5
DDVC layer: Raw; Curated (stockpile_inventory)
Inventory grade tracking and reclaim/blend to Processing. 2.2.4.1 Build ROM Stockpile is executed inside 2.2.3.</bpmn:documentation>
      <bpmn:incoming>Flow_L2_2_2_6</bpmn:incoming>
      <bpmn:outgoing>Flow_L2_2_2_7</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_L2_2_2_e" name="Shift production committed">
      <bpmn:incoming>Flow_L2_2_2_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L2_2_2_1" sourceRef="Start_L2_2_2_s" targetRef="Sub_L2_2_2_2_2_1"/>
    <bpmn:sequenceFlow id="Flow_L2_2_2_2" sourceRef="Sub_L2_2_2_2_2_1" targetRef="Sub_L2_2_2_2_2_2"/>
    <bpmn:sequenceFlow id="Flow_L2_2_2_3" sourceRef="Sub_L2_2_2_2_2_2" targetRef="Sub_L2_2_2_2_2_3"/>
    <bpmn:sequenceFlow id="Flow_L2_2_2_4" sourceRef="Sub_L2_2_2_2_2_3" targetRef="Gw_L2_2_2_g"/>
    <bpmn:sequenceFlow id="Flow_L2_2_2_5" name="Yes" sourceRef="Gw_L2_2_2_g" targetRef="Sub_L2_2_2_2_2_2"/>
    <bpmn:sequenceFlow id="Flow_L2_2_2_6" name="No" sourceRef="Gw_L2_2_2_g" targetRef="Sub_L2_2_2_2_2_4"/>
    <bpmn:sequenceFlow id="Flow_L2_2_2_7" sourceRef="Sub_L2_2_2_2_2_4" targetRef="End_L2_2_2_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L2_2_2">
    <bpmndi:BPMNPlane id="Plane_L2_2_2" bpmnElement="Collab_L2_2_2">
      <bpmndi:BPMNShape id="Pool_L2_2_2_di" bpmnElement="Pool_L2_2_2" isHorizontal="true"><dc:Bounds x="20" y="36" width="1220" height="800"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_2_mc_di" bpmnElement="Lane_L2_2_2_mc" isHorizontal="true"><dc:Bounds x="60" y="36" width="1180" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_2_sd_di" bpmnElement="Lane_L2_2_2_sd" isHorizontal="true"><dc:Bounds x="60" y="236" width="1180" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_2_tr_di" bpmnElement="Lane_L2_2_2_tr" isHorizontal="true"><dc:Bounds x="60" y="436" width="1180" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L2_2_2_sp_di" bpmnElement="Lane_L2_2_2_sp" isHorizontal="true"><dc:Bounds x="60" y="636" width="1180" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L2_2_2_s_di" bpmnElement="Start_L2_2_2_s"><dc:Bounds x="110" y="103" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="98" y="165" width="80" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_2_2_2_1_di" bpmnElement="Sub_L2_2_2_2_2_1" isExpanded="false"><dc:Bounds x="202" y="283" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_2_2_2_2_di" bpmnElement="Sub_L2_2_2_2_2_2" isExpanded="false"><dc:Bounds x="408" y="283" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_2_2_2_3_di" bpmnElement="Sub_L2_2_2_2_2_3" isExpanded="false"><dc:Bounds x="614" y="483" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_L2_2_2_g_di" bpmnElement="Gw_L2_2_2_g" isMarkerVisible="true"><dc:Bounds x="820" y="496" width="70" height="70"/><bpmndi:BPMNLabel><dc:Bounds x="805" y="572" width="100" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_L2_2_2_2_2_4_di" bpmnElement="Sub_L2_2_2_2_2_4" isExpanded="false"><dc:Bounds x="954" y="683" width="170" height="96"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L2_2_2_e_di" bpmnElement="End_L2_2_2_e"><dc:Bounds x="1160" y="703" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="1138" y="765" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L2_2_2_1_di" bpmnElement="Flow_L2_2_2_1"><di:waypoint x="166" y="131"/><di:waypoint x="184" y="131"/><di:waypoint x="184" y="331"/><di:waypoint x="202" y="331"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_2_2_di" bpmnElement="Flow_L2_2_2_2"><di:waypoint x="372" y="331"/><di:waypoint x="408" y="331"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_2_3_di" bpmnElement="Flow_L2_2_2_3"><di:waypoint x="578" y="331"/><di:waypoint x="596" y="331"/><di:waypoint x="596" y="531"/><di:waypoint x="614" y="531"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_2_4_di" bpmnElement="Flow_L2_2_2_4"><di:waypoint x="784" y="531"/><di:waypoint x="820" y="531"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_2_5_di" bpmnElement="Flow_L2_2_2_5"><di:waypoint x="855" y="496"/><di:waypoint x="855" y="20"/><di:waypoint x="493" y="20"/><di:waypoint x="493" y="283"/><bpmndi:BPMNLabel><dc:Bounds x="861" y="476" width="28" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_2_6_di" bpmnElement="Flow_L2_2_2_6"><di:waypoint x="890" y="531"/><di:waypoint x="936" y="531"/><di:waypoint x="936" y="731"/><di:waypoint x="954" y="731"/><bpmndi:BPMNLabel><dc:Bounds x="894" y="511" width="21" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_2_2_7_di" bpmnElement="Flow_L2_2_2_7"><di:waypoint x="1124" y="731"/><di:waypoint x="1160" y="731"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
