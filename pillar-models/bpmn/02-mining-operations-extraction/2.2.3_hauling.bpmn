      <bpmndi:BPMNShape id="Task_L3_2_2_3_2_2_3_3_di" bpmnElement="Task_L3_2_2_3_2_2_3_3"><dc:Bounds x="942" y="75" width="170" height="80"/></bpmndi:BPMNShape>
