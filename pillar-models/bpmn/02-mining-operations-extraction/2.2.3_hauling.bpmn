      <bpmndi:BPMNShape id="Task_L3_2_2_3_2_2_3_5_di" bpmnElement="Task_L3_2_2_3_2_2_3_5"><dc:Bounds x="1568" y="75" width="170" height="80"/></bpmndi:BPMNShape>
