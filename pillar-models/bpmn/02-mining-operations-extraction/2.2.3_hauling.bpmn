      <bpmndi:BPMNEdge id="Flow_L3_2_2_3_10_di" bpmnElement="Flow_L3_2_2_3_10"><di:waypoint x="1318" y="115"/><di:waypoint x="1404" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_3_11_di" bpmnElement="Flow_L3_2_2_3_11"><di:waypoint x="1474" y="115"/><di:waypoint x="1568" y="115"/><bpmndi:BPMNLabel><dc:Bounds x="1478" y="95" width="21" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_3_12_di" bpmnElement="Flow_L3_2_2_3_12"><di:waypoint x="1439" y="150"/><di:waypoint x="1439" y="275"/><bpmndi:BPMNLabel><dc:Bounds x="1445" y="156" width="28" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_3_13_di" bpmnElement="Flow_L3_2_2_3_13"><di:waypoint x="1524" y="315"/><di:waypoint x="1653" y="315"/><di:waypoint x="1653" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_3_14_di" bpmnElement="Flow_L3_2_2_3_14"><di:waypoint x="1738" y="115"/><di:waypoint x="1774" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_2_3_15_di" bpmnElement="Flow_L3_2_2_3_15"><di:waypoint x="692" y="440"/><di:waypoint x="793" y="440"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
