      <bpmndi:BPMNEdge id="Flow_L3_2_2_3_2_di" bpmnElement="Flow_L3_2_2_3_2"><di:waypoint x="372" y="115"/><di:waypoint x="408" y="115"/></bpmndi:BPMNEdge>
