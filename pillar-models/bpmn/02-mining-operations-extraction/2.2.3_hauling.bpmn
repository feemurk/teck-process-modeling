      <bpmndi:BPMNShape id="Start_L3_2_2_3_s_di" bpmnElement="Start_L3_2_2_3_s"><dc:Bounds x="110" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="149" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
