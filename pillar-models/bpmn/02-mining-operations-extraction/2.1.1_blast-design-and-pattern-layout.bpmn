<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L3_2_1_1" targetNamespace="https://teck.example/process-models/pillar-02">
  <bpmn:collaboration id="Collab_L3_2_1_1">
    <bpmn:participant id="Pool_L3_2_1_1" name="2.1.1 Blast Design &amp; Pattern Layout" processRef="Process_L3_2_1_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_L3_2_1_1" isExecutable="false">
    <bpmn:documentation>L3 Process. Translates the approved dig polygon and bench design into a drillable blast pattern, defining hole spacing, burden, depth, and explosive specifications. Produces the pattern design file consumed by the drill guidance system.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_L3_2_1_1">
      <bpmn:lane id="Lane_L3_2_1_1_eng" name="Drill &amp; Blast Engineer">
        <bpmn:flowNodeRef>Start_L3_2_1_1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_2_1_1_2_1_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L3_2_1_1_2_1_1_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L3_2_1_1_sv" name="Survey Technician">
        <bpmn:flowNodeRef>Task_L3_2_1_1_2_1_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_L3_2_1_1_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_L3_2_1_1_s" name="Approved dig polygon received">
      <bpmn:outgoing>Flow_L3_2_1_1_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_L3_2_1_1_2_1_1_2" name="2.1.1.2 Design Hole Layout Parameters">
      <bpmn:documentation>Engineer finalises burden, spacing, subdrill, and hole depth for each hole in the pattern based on geotechnical inputs (rock strength, density, joint orientation), target fragmentation size, and explosive energy balance calculations. Design is encoded in blast design software and linked to the dig polygon.
ISA-95 level: 3
Actors: Drill &amp; Blast Engineer
Standard alignment: ISA-95 Level 3 (operations engineering)
DDVC layer: Raw; Curated (blast_pattern)</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_1_1_1</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_1_1_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L3_2_1_1_2_1_1_3" name="2.1.1.3 Select Explosive Product">
      <bpmn:documentation>Engineer selects the explosive product(s) — emulsion, ANFO, or blended heavy ANFO — for each hole or zone within the pattern based on hole water conditions, rock density, powder factor requirements, and available product inventory. Initiator type (electronic, shock tube) and delay sequence are specified.
ISA-95 level: 3
Actors: Drill &amp; Blast Engineer
Standard alignment: ISA-95 Level 3; AMIRA P754 Principle 1 (mass measurement — explosive mass per hole)
DDVC layer: Raw; Curated (explosive_product reference)
Standard sequence places design before staking. Initial product selection is made here; the per-hole selection is confirmed at charging once hole water depth (2.1.2.3) is known.</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_1_1_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_1_1_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_L3_2_1_1_2_1_1_1" name="2.1.1.1 Survey &amp; Stake Pattern">
      <bpmn:documentation>Survey team establishes physical control points on the bench surface aligned to the approved dig polygon, placing stakes or paint markers at each planned hole collar location. Coordinates are recorded against the mine grid coordinate system (site datum).
ISA-95 level: 2 / 1
Actors: Survey Technician
Standard alignment: ISA-95 Level 1 (sensor/positioning)
DDVC layer: Raw
Standard sequence: surveyors stake the DESIGNED collar coordinates, so this step follows 2.1.1.2. The decomposition lists it first and gives 2.1.1.2 a survey-completion trigger.</bpmn:documentation>
      <bpmn:incoming>Flow_L3_2_1_1_3</bpmn:incoming>
      <bpmn:outgoing>Flow_L3_2_1_1_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_L3_2_1_1_e" name="Staked pattern ready for drilling">
      <bpmn:incoming>Flow_L3_2_1_1_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L3_2_1_1_1" sourceRef="Start_L3_2_1_1_s" targetRef="Task_L3_2_1_1_2_1_1_2"/>
    <bpmn:sequenceFlow id="Flow_L3_2_1_1_2" sourceRef="Task_L3_2_1_1_2_1_1_2" targetRef="Task_L3_2_1_1_2_1_1_3"/>
    <bpmn:sequenceFlow id="Flow_L3_2_1_1_3" sourceRef="Task_L3_2_1_1_2_1_1_3" targetRef="Task_L3_2_1_1_2_1_1_1"/>
    <bpmn:sequenceFlow id="Flow_L3_2_1_1_4" sourceRef="Task_L3_2_1_1_2_1_1_1" targetRef="End_L3_2_1_1_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L3_2_1_1">
    <bpmndi:BPMNPlane id="Plane_L3_2_1_1" bpmnElement="Collab_L3_2_1_1">
      <bpmndi:BPMNShape id="Pool_L3_2_1_1_di" bpmnElement="Pool_L3_2_1_1" isHorizontal="true"><dc:Bounds x="20" y="20" width="880" height="400"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_1_1_eng_di" bpmnElement="Lane_L3_2_1_1_eng" isHorizontal="true"><dc:Bounds x="60" y="20" width="840" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_L3_2_1_1_sv_di" bpmnElement="Lane_L3_2_1_1_sv" isHorizontal="true"><dc:Bounds x="60" y="220" width="840" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_L3_2_1_1_s_di" bpmnElement="Start_L3_2_1_1_s"><dc:Bounds x="110" y="87" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="88" y="149" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_1_1_2_1_1_2_di" bpmnElement="Task_L3_2_1_1_2_1_1_2"><dc:Bounds x="202" y="75" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_1_1_2_1_1_3_di" bpmnElement="Task_L3_2_1_1_2_1_1_3"><dc:Bounds x="408" y="75" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_2_1_1_2_1_1_1_di" bpmnElement="Task_L3_2_1_1_2_1_1_1"><dc:Bounds x="614" y="275" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_L3_2_1_1_e_di" bpmnElement="End_L3_2_1_1_e"><dc:Bounds x="820" y="287" width="56" height="56"/><bpmndi:BPMNLabel><dc:Bounds x="798" y="349" width="100" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_1_1_di" bpmnElement="Flow_L3_2_1_1_1"><di:waypoint x="166" y="115"/><di:waypoint x="202" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_1_2_di" bpmnElement="Flow_L3_2_1_1_2"><di:waypoint x="372" y="115"/><di:waypoint x="408" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_1_3_di" bpmnElement="Flow_L3_2_1_1_3"><di:waypoint x="578" y="115"/><di:waypoint x="596" y="115"/><di:waypoint x="596" y="315"/><di:waypoint x="614" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_2_1_1_4_di" bpmnElement="Flow_L3_2_1_1_4"><di:waypoint x="784" y="315"/><di:waypoint x="820" y="315"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
